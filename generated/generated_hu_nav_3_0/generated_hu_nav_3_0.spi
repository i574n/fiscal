and let x_customer_vat_data_type_choice_customer_tax_number_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_customer_vat_data_type_choice_customer_tax_number
    =
    if false then failwith "unreachable"
    elif xml.has_child "customerTaxNumber" children then
        CustomerVatDataType_choice_customerTaxNumber_customerTaxNumber (
            (fun c => x_customer_tax_number_type_of_xml c) (xml.required_child "customerTaxNumber" children)
        )
    elif xml.has_child "communityVatNumber" children then
        CustomerVatDataType_choice_customerTaxNumber_communityVatNumber (
            (fun c => xml.required_value "x_community_vat_number_type" (x_community_vat_number_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "communityVatNumber" children)
        )
    elif xml.has_child "thirdStateTaxId" children then
        CustomerVatDataType_choice_customerTaxNumber_thirdStateTaxId (
            (fun c => xml.required_value "x_simple_text50_not_blank_type" (x_simple_text50_not_blank_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "thirdStateTaxId" children)
        )
    else failwith "x_customer_vat_data_type_choice_customer_tax_number: no alternative present"

