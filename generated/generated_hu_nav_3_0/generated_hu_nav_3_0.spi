and let x_additional_data_type_children (x : x_additional_data_type) : list xml.xml_node =
    inl nodes forall r. (f : x_additional_data_type_field r) (v : r) : list xml.xml_node =
        match f with
        | AdditionalDataType_field_dataName => [ text_node "dataName" v ]
        | AdditionalDataType_field_dataDescription => [ text_node "dataDescription" v ]
        | AdditionalDataType_field_dataValue => [ text_node "dataValue" v ]
    inl rec walk (fields : list (exists r. x_additional_data_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_additional_data_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists AdditionalDataType_field_dataName
        exists AdditionalDataType_field_dataDescription
        exists AdditionalDataType_field_dataValue
    ]

and let x_additional_data_type_attributes (x : x_additional_data_type) : list (string * string) = []

