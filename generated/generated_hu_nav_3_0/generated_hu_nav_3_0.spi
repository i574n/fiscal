let rec x_invoice_data_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_invoice_data
    =
    {
        base = x_invoice_data_type_of_children attributes children
    }

and let x_invoice_data_of_xml (c : xml.xml_node) : x_invoice_data =
    x_invoice_data_of_children (xml.element_attributes c) (xml.element_children c)

and let x_general_error_header_response_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_general_error_header_response
