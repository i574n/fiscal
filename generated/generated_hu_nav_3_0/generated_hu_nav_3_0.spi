and let x_address_type_choice_simple_address_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_address_type_choice_simple_address
    =
    if false then failwith "unreachable"
    elif xml.has_child "simpleAddress" children then
        AddressType_choice_simpleAddress_simpleAddress (
            (fun c => x_simple_address_type_of_xml c) (xml.required_child "simpleAddress" children)
        )
    elif xml.has_child "detailedAddress" children then
        AddressType_choice_simpleAddress_detailedAddress (
            (fun c => x_detailed_address_type_of_xml c) (xml.required_child "detailedAddress" children)
        )
    else failwith "x_address_type_choice_simple_address: no alternative present"

