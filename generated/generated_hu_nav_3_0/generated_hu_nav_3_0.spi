and let x_simple_address_type_children (x : x_simple_address_type) : list xml.xml_node =
    inl nodes forall r. (f : x_simple_address_type_field r) (v : r) : list xml.xml_node =
        match f with
        | SimpleAddressType_field_countryCode => [ text_node "countryCode" v ]
        | SimpleAddressType_field_region => optional_text_nodes "region" v
        | SimpleAddressType_field_postalCode => [ text_node "postalCode" v ]
        | SimpleAddressType_field_city => [ text_node "city" v ]
        | SimpleAddressType_field_additionalAddressDetail => [ text_node "additionalAddressDetail" v ]
    inl rec walk (fields : list (exists r. x_simple_address_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_simple_address_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists SimpleAddressType_field_countryCode
        exists SimpleAddressType_field_region
        exists SimpleAddressType_field_postalCode
        exists SimpleAddressType_field_city
        exists SimpleAddressType_field_additionalAddressDetail
    ]

and let x_simple_address_type_attributes (x : x_simple_address_type) : list (string * string) = []

and let x_simple_address_type_to_xml (name : string) (x : x_simple_address_type) : xml.xml_node =
    xml.element name (x_simple_address_type_attributes x) (x_simple_address_type_children x)

and let x_tax_number_type_children (x : x_tax_number_type) : list xml.xml_node =
    inl nodes forall r. (f : x_tax_number_type_field r) (v : r) : list xml.xml_node =
        match f with
        | TaxNumberType_field_taxpayerId => [ text_node "taxpayerId" v ]
        | TaxNumberType_field_vatCode => optional_text_nodes "vatCode" v
        | TaxNumberType_field_countyCode => optional_text_nodes "countyCode" v
    inl rec walk (fields : list (exists r. x_tax_number_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tax_number_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists TaxNumberType_field_taxpayerId
        exists TaxNumberType_field_vatCode
        exists TaxNumberType_field_countyCode
    ]

