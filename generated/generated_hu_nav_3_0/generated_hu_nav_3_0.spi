inl sample_path (name : string) : string =
    inl from_env = env.get_environment_variable "FISCAL_ROOT"
    inl root =
        if from_env <> "" then from_env
        else
            inl here = file_system.get_current_directory ()
            match here |> file_system.find_parent file_system.File "src/generator.spi" with
            | Ok dir => dir
            | Error message => failwith message
    sm'.(++#) (sm'.(++#) root "/samples/") name
///> rust
test generated_hu_nav_3_0_writes_its_example =
    inl example = x_invoice_data_example 0i32
    inl document =
        xml.element
            "InvoiceData"
            (("xmlns", "http://schemas.nav.gov.hu/OSA/3.0/data") :: x_invoice_data_attributes example)
            (x_invoice_data_children example)
    file_system.write_all_text
        (sample_path "generated_hu_nav_3_0_example.xml")
        (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
    inl documents =
        [
            "deps/corpus/hu/nav-samples/Belfoldi devizas szamla.xml"
            "deps/corpus/hu/nav-samples/Belfoldi devizas vegszamla tobb eloleg tetel.xml"
            "deps/corpus/hu/nav-samples/Belfoldi egyszerusitett szamla.xml"
            "deps/corpus/hu/nav-samples/Belfoldi elolegszamla egysegar nelkul .xml"
            "deps/corpus/hu/nav-samples/Belfoldi elolegszamla.xml"
            "deps/corpus/hu/nav-samples/Belfoldi ertekesites tobb AFA tipus.xml"
            "deps/corpus/hu/nav-samples/Belfoldi termekertekesites AFA csoportok kozott.xml"
            "deps/corpus/hu/nav-samples/Belfoldi termekertekesites maganszemelynek.xml"
            "deps/corpus/hu/nav-samples/Belfoldi termekertekesites tetelbol adott engedmennyel.xml"
            "deps/corpus/hu/nav-samples/Belfoldi termekertekesites.xml"
            "deps/corpus/hu/nav-samples/Belfoldi vegszamla.xml"
            "deps/corpus/hu/nav-samples/Eredeti szamla modositasokhoz.xml"
            "deps/corpus/hu/nav-samples/Gyujtoszamla 1.xml"
            "deps/corpus/hu/nav-samples/Gyujtoszamla 2.xml"
            "deps/corpus/hu/nav-samples/Harmadik orszagbeli devizas szamla.xml"
            "deps/corpus/hu/nav-samples/Modositas es ervenytelenites 1.xml"
            "deps/corpus/hu/nav-samples/Modositas es ervenytelenites 2.xml"
            "deps/corpus/hu/nav-samples/Tagorszagi devizas szamla.xml"
            "deps/corpus/hu/nav-samples/Termekdijas szamla.xml"
            "deps/corpus/hu/nav-samples/Teteladatok modositasa.xml"
            "deps/corpus/hu/nav-samples/Teves termek helyesbitese 20.xml"
            "deps/corpus/hu/nav-samples/Teves termek helyesbitese 21.xml"
            "deps/corpus/hu/nav-samples/Teves termek helyesbitese.xml"
            "deps/corpus/hu/nav-samples/Tobb szamla modositasa egy okirattal alap 1.xml"
            "deps/corpus/hu/nav-samples/Tobb szamla modositasa egy okirattal alap 2.xml"
            "deps/corpus/hu/nav-samples/Tobb szamla modositasa egy okirattal alap 3.xml"
            "deps/corpus/hu/nav-samples/Tobb szamla modositasa egy okirattal.xml"
            "deps/corpus/hu/nav-samples/Tobbszoros modositas 1.xml"
            "deps/corpus/hu/nav-samples/Tobbszoros modositas 2.xml"
            "deps/corpus/hu/nav-samples/Uj kozlekedesi eszkoz export.xml"
        ]
    inl check (path : string) : list string =
        inl text = file_system.read_all_text (sample_path (sm'.(++#) "../" path))
        match xml.read_xml text with
        | node :: [] =>
            match xml.first_difference node (x_invoice_data_to_xml "InvoiceData" (x_invoice_data_of_xml node)) with
            | Some difference => [ sm'.(++#) path (sm'.(++#) ": " difference) ]
            | None => []
        | _ => [ sm'.(++#) path ": not one root element" ]
    inl failures = listm.concat (listm.map check documents)
    inl _ =
        match failures with
        | first :: _ =>
            inl count = sm'.obj_to_string (listm.length failures : i32)
            inl message = sm'.(++#) " real documents do not read back unchanged; first: " first
            failwith (sm'.(++#) count message)
        | [] => ()
    inl text = file_system.read_all_text (sample_path "generated_hu_nav_3_0_example.xml")
    let rec insert (x : i64) (xs : list i64) : list i64 =
        match xs with
        | y :: rest => if x <= y then x :: xs else y :: insert x rest
        | [] => x :: []
    let rec nth (i : i32) (xs : list i64) : i64 =
        match xs with
        | y :: rest => if i = 0i32 then y else nth (i - 1i32) rest
        | [] => -1i64
    let rec runs (left : i32) (parses : list i64) (writes : list i64) (bytes : i64) : list i64 * list i64 * i64 =
        if left = 0i32 then parses, writes, bytes
        else
            inl watch = date_time.stopwatch ()
            date_time.stopwatch_start watch
            inl start = date_time.stopwatch_elapsed_microseconds watch
            match xml.read_xml text with
            | node :: [] =>
                inl parsed = x_invoice_data_of_xml node
                inl parsed_at = date_time.stopwatch_elapsed_microseconds watch
                inl written = xml.write_node (x_invoice_data_to_xml "InvoiceData" parsed)
                inl written_at = date_time.stopwatch_elapsed_microseconds watch
                inl parses = insert (parsed_at - start) parses
                inl writes = insert (written_at - parsed_at) writes
                runs (left - 1i32) parses writes (bytes + sm'.length written)
            | _ => failwith "one InvoiceData element"
    inl _ = runs (dyn 5i32) [] [] 0i64
    inl parses, writes, bytes = runs (dyn 31i32) [] [] 0i64
    inl cell (x : i64) : string = sm'.obj_to_string x
    inl row = sm'.(++#) "generated_hu_nav_3_0 parse_us " (cell (nth 15i32 parses))
    inl row = sm'.(++#) row (sm'.(++#) " write_us " (cell (nth 15i32 writes)))
    inl row = sm'.(++#) row (sm'.(++#) " runs 31 bytes " (cell bytes))
    console.write_line row
    match xml.read_xml text with
    | node :: [] =>
        inl parsed = x_invoice_data_of_xml node
        inl document =
            xml.element
                "InvoiceData"
                (("xmlns", "http://schemas.nav.gov.hu/OSA/3.0/data") :: x_invoice_data_attributes parsed)
                (x_invoice_data_children parsed)
        inl folder = sample_path "../target/bench"
        match file_system.create_dir_all folder |> resultm.unbox with
        | Ok _ =>
            file_system.write_all_text
                (sm'.(++#) folder "/ours-generated_hu_nav_3_0_example.xml")
                (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
        | Error _ => failwith "cannot create target/bench"
    | _ => failwith "one InvoiceData element"

///> rust
test generated_hu_nav_3_0_keeps_raw_strings_out fails "Unification failure" =
    x_data_name_type_to_string "raw"
