nominal private x_timbre_fiscal_digital_leyenda = string

inl x_timbre_fiscal_digital_leyenda_is_valid (s : string) : bool =
    xsd_regex.table_matches (xsd_pattern_2373a9f2_111_table ()) s
    && xml.code_point_count s >= 12
    && xml.code_point_count s <= 150

inl x_timbre_fiscal_digital_leyenda_of_string (s : string) : option x_timbre_fiscal_digital_leyenda =
    match xml.collapsed_space s with
    | s => if x_timbre_fiscal_digital_leyenda_is_valid s then Some (x_timbre_fiscal_digital_leyenda s) else None

inl x_timbre_fiscal_digital_leyenda_to_string (x : x_timbre_fiscal_digital_leyenda) : string =
    match x with x_timbre_fiscal_digital_leyenda s => s

instance to_text x_timbre_fiscal_digital_leyenda = fun x => x_timbre_fiscal_digital_leyenda_to_string x
inl x_timbre_fiscal_digital_leyenda_example (_ : i32) : x_timbre_fiscal_digital_leyenda =
    x_timbre_fiscal_digital_leyenda "A"

inl x_timbre_fiscal_digital_leyenda_example_text (k : i32) : string =
    x_timbre_fiscal_digital_leyenda_to_string (x_timbre_fiscal_digital_leyenda_example k)

type x_timbre_fiscal_digital_sello_cfd = string

inl x_timbre_fiscal_digital_sello_cfd_is_valid (s : string) : bool = true

inl x_timbre_fiscal_digital_sello_cfd_example (_ : i32) : string = "1"

inl x_timbre_fiscal_digital_sello_cfd_example_text (k : i32) : string = x_timbre_fiscal_digital_sello_cfd_example k

let rec xsd_pattern_cf216151_9 (state : i32) (s : string) (i : i32) : bool =
    if i >= sm'.length s then state = 20i32
    else
        inl c = xml.code_point_at s i
        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 1i32 s next
            else false
        elif state = 1i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 2i32 s next
            else false
        elif state = 2i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 3i32 s next
            else false
        elif state = 3i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 4i32 s next
            else false
        elif state = 4i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 5i32 s next
            else false
        elif state = 5i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 6i32 s next
            else false
        elif state = 6i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 7i32 s next
            else false
        elif state = 7i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 8i32 s next
            else false
        elif state = 8i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 9i32 s next
            else false
        elif state = 9i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 10i32 s next
            else false
        elif state = 10i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 11i32 s next
            else false
        elif state = 11i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 12i32 s next
            else false
        elif state = 12i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 13i32 s next
            else false
        elif state = 13i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 14i32 s next
            else false
        elif state = 14i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 15i32 s next
            else false
        elif state = 15i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 16i32 s next
            else false
        elif state = 16i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 17i32 s next
            else false
        elif state = 17i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 18i32 s next
            else false
        elif state = 18i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 19i32 s next
            else false
        elif state = 19i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_cf216151_9 20i32 s next
            else false
        elif state = 20i32 then
            false
        else false

nominal private x_timbre_fiscal_digital_no_certificado_sat = string

inl x_timbre_fiscal_digital_no_certificado_sat_is_valid (s : string) : bool =
    (xsd_pattern_cf216151_9 0i32 s 0i32) && xml.code_point_count s = 20

inl x_timbre_fiscal_digital_no_certificado_sat_of_string
    (s : string)
    : option x_timbre_fiscal_digital_no_certificado_sat
    =
    match xml.collapsed_space s with
    | s =>
        if x_timbre_fiscal_digital_no_certificado_sat_is_valid s
        then Some (x_timbre_fiscal_digital_no_certificado_sat s)
        else None

inl x_timbre_fiscal_digital_no_certificado_sat_to_string (x : x_timbre_fiscal_digital_no_certificado_sat) : string =
    match x with x_timbre_fiscal_digital_no_certificado_sat s => s

instance to_text x_timbre_fiscal_digital_no_certificado_sat =
    fun x => x_timbre_fiscal_digital_no_certificado_sat_to_string x
inl x_timbre_fiscal_digital_no_certificado_sat_example (_ : i32) : x_timbre_fiscal_digital_no_certificado_sat =
    x_timbre_fiscal_digital_no_certificado_sat "00000000000000000000"

inl x_timbre_fiscal_digital_no_certificado_sat_example_text (k : i32) : string =
    x_timbre_fiscal_digital_no_certificado_sat_to_string (x_timbre_fiscal_digital_no_certificado_sat_example k)

type x_timbre_fiscal_digital_sello_sat = string

inl x_timbre_fiscal_digital_sello_sat_is_valid (s : string) : bool = true

inl x_timbre_fiscal_digital_sello_sat_example (_ : i32) : string = "1"

inl x_timbre_fiscal_digital_sello_sat_example_text (k : i32) : string = x_timbre_fiscal_digital_sello_sat_example k

type x_timbre_fiscal_digital =
    {
        version : string
        uuid : x_timbre_fiscal_digital_uuid
        fecha_timbrado : x_t_fecha_h
        rfc_prov_certif : x_t_rfc_pm
        leyenda : option (x_timbre_fiscal_digital_leyenda)
        sello_cfd : x_timbre_fiscal_digital_sello_cfd
        no_certificado_sat : x_timbre_fiscal_digital_no_certificado_sat
        sello_sat : x_timbre_fiscal_digital_sello_sat
    }

let rec x_timbre_fiscal_digital_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_timbre_fiscal_digital
    =
    {
        version = xml.required_attribute "Version" (xml.checked_fixed "Version" "1.1" attributes)
        uuid =
            xml.required_value
                "x_timbre_fiscal_digital_uuid"
                (x_timbre_fiscal_digital_uuid_of_string (xml.required_attribute "UUID" attributes))
        fecha_timbrado =
            xml.required_value "x_t_fecha_h" (x_t_fecha_h_of_string (xml.required_attribute "FechaTimbrado" attributes))
        rfc_prov_certif =
            xml.required_value "x_t_rfc_pm" (x_t_rfc_pm_of_string (xml.required_attribute "RfcProvCertif" attributes))
        leyenda =
            optionm.map
                fun v =>
                    xml.required_value "x_timbre_fiscal_digital_leyenda" (x_timbre_fiscal_digital_leyenda_of_string v)
                (xml.attribute_of "Leyenda" attributes)
        sello_cfd = xml.required_attribute "SelloCFD" attributes
        no_certificado_sat =
            xml.required_value
                "x_timbre_fiscal_digital_no_certificado_sat"
                (
                    x_timbre_fiscal_digital_no_certificado_sat_of_string (
                        xml.required_attribute "NoCertificadoSAT" attributes
                    )
                )
        sello_sat = xml.required_attribute "SelloSAT" attributes
    }

and let x_timbre_fiscal_digital_of_xml (c : xml.xml_node) : x_timbre_fiscal_digital =
    x_timbre_fiscal_digital_of_children (xml.element_attributes c) (xml.element_children c)

and let x_timbre_fiscal_digital_children (x : x_timbre_fiscal_digital) : list xml.xml_node = []

and let x_timbre_fiscal_digital_attributes (x : x_timbre_fiscal_digital) : list (string * string) =
    listm.concat [
        [ ("Version", x.version) ]
        [ ("UUID", to_text x.uuid) ]
        [ ("FechaTimbrado", to_text x.fecha_timbrado) ]
        [ ("RfcProvCertif", to_text x.rfc_prov_certif) ]
        xml.option_list (optionm.map (fun v => "Leyenda", to_text v) x.leyenda)
        [ ("SelloCFD", x.sello_cfd) ]
        [ ("NoCertificadoSAT", to_text x.no_certificado_sat) ]
        [ ("SelloSAT", x.sello_sat) ]
    ]

and let x_timbre_fiscal_digital_to_xml (name : string) (x : x_timbre_fiscal_digital) : xml.xml_node =
    xml.element name (x_timbre_fiscal_digital_attributes x) (x_timbre_fiscal_digital_children x)

and let x_timbre_fiscal_digital_example (k : i32) : x_timbre_fiscal_digital =
    {
        version = "1.1"
        uuid = x_timbre_fiscal_digital_uuid_example k
        fecha_timbrado = x_t_fecha_h_example k
        rfc_prov_certif = x_t_rfc_pm_example k
        leyenda = None
        sello_cfd = x_timbre_fiscal_digital_sello_cfd_example k
        no_certificado_sat = x_timbre_fiscal_digital_no_certificado_sat_example k
        sello_sat = x_timbre_fiscal_digital_sello_sat_example k
    }


inl sample_path (name : string) : string =
    inl from_env = env.get_environment_variable "FISCAL_ROOT"
    inl root =
        if from_env <> "" then from_env
        else
            inl here = file_system.get_current_directory ()
            match here |> file_system.find_parent file_system.File "src/generator.spi" with
            | Ok dir => dir
            | Error message => failwith message
    sm'.(++#) (sm'.(++#) root "/samples/") name
///> rust
test generated_cfdi_tfd_1_1_writes_its_example =
    inl example = x_timbre_fiscal_digital_example 0i32
    inl document =
        xml.element
            "TimbreFiscalDigital"
            (("xmlns", "http://www.sat.gob.mx/TimbreFiscalDigital") :: x_timbre_fiscal_digital_attributes example)
            (x_timbre_fiscal_digital_children example)
    file_system.write_all_text
        (sample_path "generated_cfdi_tfd_1_1_example.xml")
        (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
    inl text = file_system.read_all_text (sample_path "generated_cfdi_tfd_1_1_example.xml")
    let rec insert (x : i64) (xs : list i64) : list i64 =
        match xs with
        | y :: rest => if x <= y then x :: xs else y :: insert x rest
        | [] => x :: []
    let rec nth (i : i32) (xs : list i64) : i64 =
        match xs with
        | y :: rest => if i = 0i32 then y else nth (i - 1i32) rest
        | [] => -1i64
    let rec runs (left : i32) (parses : list i64) (writes : list i64) (bytes : i64) : list i64 * list i64 * i64 =
        if left = 0i32 then parses, writes, bytes
        else
            inl watch = date_time.stopwatch ()
            date_time.stopwatch_start watch
            inl start = date_time.stopwatch_elapsed_microseconds watch
            match xml.read_xml text with
            | node :: [] =>
                inl parsed = x_timbre_fiscal_digital_of_xml node
                inl parsed_at = date_time.stopwatch_elapsed_microseconds watch
                inl written = xml.write_node (x_timbre_fiscal_digital_to_xml "TimbreFiscalDigital" parsed)
                inl written_at = date_time.stopwatch_elapsed_microseconds watch
                inl parses = insert (parsed_at - start) parses
                inl writes = insert (written_at - parsed_at) writes
                runs (left - 1i32) parses writes (bytes + sm'.length written)
            | _ => failwith "one TimbreFiscalDigital element"
    inl _ = runs (dyn 5i32) [] [] 0i64
    inl parses, writes, bytes = runs (dyn 31i32) [] [] 0i64
    inl cell (x : i64) : string = sm'.obj_to_string x
    inl row = sm'.(++#) "generated_cfdi_tfd_1_1 parse_us " (cell (nth 15i32 parses))
    inl row = sm'.(++#) row (sm'.(++#) " write_us " (cell (nth 15i32 writes)))
    inl row = sm'.(++#) row (sm'.(++#) " runs 31 bytes " (cell bytes))
    console.write_line row
    match xml.read_xml text with
    | node :: [] =>
        inl parsed = x_timbre_fiscal_digital_of_xml node
        inl document =
            xml.element
                "TimbreFiscalDigital"
                (("xmlns", "http://www.sat.gob.mx/TimbreFiscalDigital") :: x_timbre_fiscal_digital_attributes parsed)
                (x_timbre_fiscal_digital_children parsed)
        inl folder = sample_path "../target/bench"
        match file_system.create_dir_all folder |> resultm.unbox with
        | Ok _ =>
            file_system.write_all_text
                (sm'.(++#) folder "/ours-generated_cfdi_tfd_1_1_example.xml")
                (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
        | Error _ => failwith "cannot create target/bench"
    | _ => failwith "one TimbreFiscalDigital element"

///> rust
test generated_cfdi_tfd_1_1_keeps_raw_strings_out fails "Unification failure" =
    x_t_curp_to_string "raw"
