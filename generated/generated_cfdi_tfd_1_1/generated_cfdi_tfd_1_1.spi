nominal private x_timbre_fiscal_digital_uuid = string

inl x_timbre_fiscal_digital_uuid_is_valid (s : string) : bool =
    (xsd_pattern_e44f3476_75 0i32 s 0i32) && xml.code_point_count s = 36

inl x_timbre_fiscal_digital_uuid_of_string (s : string) : option x_timbre_fiscal_digital_uuid =
    match xml.collapsed_space s with
    | s => if x_timbre_fiscal_digital_uuid_is_valid s then Some (x_timbre_fiscal_digital_uuid s) else None

inl x_timbre_fiscal_digital_uuid_to_string (x : x_timbre_fiscal_digital_uuid) : string =
    match x with x_timbre_fiscal_digital_uuid s => s

instance to_text x_timbre_fiscal_digital_uuid = fun x => x_timbre_fiscal_digital_uuid_to_string x
inl x_timbre_fiscal_digital_uuid_example (_ : i32) : x_timbre_fiscal_digital_uuid =
    x_timbre_fiscal_digital_uuid "AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA"

inl x_timbre_fiscal_digital_uuid_example_text (k : i32) : string =
    x_timbre_fiscal_digital_uuid_to_string (x_timbre_fiscal_digital_uuid_example k)

