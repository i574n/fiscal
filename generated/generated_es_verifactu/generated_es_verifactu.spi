union x_tipo_operacion_type =
    | TipoOperacionType_Alta
    | TipoOperacionType_Anulacion

inl x_tipo_operacion_type_of_string (s : string) : option x_tipo_operacion_type =
    match s with
    | "Alta" => Some TipoOperacionType_Alta
    | "Anulacion" => Some TipoOperacionType_Anulacion
    | _ => None

inl x_tipo_operacion_type_to_string (x : x_tipo_operacion_type) : string =
    match x with
    | TipoOperacionType_Alta => "Alta"
    | TipoOperacionType_Anulacion => "Anulacion"

instance to_text x_tipo_operacion_type = fun x => x_tipo_operacion_type_to_string x

inl x_tipo_operacion_type_example (k : i32) : x_tipo_operacion_type =
    inl index = ((k % 2i32) + 2i32) % 2i32
    if index = 0i32 then TipoOperacionType_Alta
    else TipoOperacionType_Anulacion

inl x_tipo_operacion_type_example_text (k : i32) : string =
    x_tipo_operacion_type_to_string (x_tipo_operacion_type_example k)

union x_impuesto_type =
    | ImpuestoType_01
    | ImpuestoType_02
    | ImpuestoType_03
    | ImpuestoType_05

inl x_impuesto_type_of_string (s : string) : option x_impuesto_type =
    match s with
    | "01" => Some ImpuestoType_01
    | "02" => Some ImpuestoType_02
    | "03" => Some ImpuestoType_03
    | "05" => Some ImpuestoType_05
    | _ => None

inl x_impuesto_type_to_string (x : x_impuesto_type) : string =
    match x with
    | ImpuestoType_01 => "01"
    | ImpuestoType_02 => "02"
    | ImpuestoType_03 => "03"
    | ImpuestoType_05 => "05"

instance to_text x_impuesto_type = fun x => x_impuesto_type_to_string x

inl x_impuesto_type_example (k : i32) : x_impuesto_type =
    inl index = ((k % 4i32) + 4i32) % 4i32
    if index = 0i32 then ImpuestoType_01
    elif index = 1i32 then ImpuestoType_02
    elif index = 2i32 then ImpuestoType_03
    else ImpuestoType_05

inl x_impuesto_type_example_text (k : i32) : string = x_impuesto_type_to_string (x_impuesto_type_example k)

