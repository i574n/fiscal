///> rust
test generated_es_verifactu_writes_its_example =
    inl example = x_reg_factu_sistema_facturacion_example 0i32
    inl document =
        xml.element
            "RegFactuSistemaFacturacion"
            (
                (
                    "xmlns",
                    "https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aplicaciones/es/aeat/ti"
                    ^^ "ke/cont/ws/SuministroLR.xsd"
                )
                :: (
                    "xmlns:sf",
                    "https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aplicaciones/es/aeat"
                    ^^ "/tike/cont/ws/SuministroInformacion.xsd"
                )
                :: x_reg_factu_sistema_facturacion_attributes example
            )
            (x_reg_factu_sistema_facturacion_children example)
    file_system.directory_create_all (generated_fiscal_runtime.sample_path "") |> ignore
    file_system.write_all_text
        (generated_fiscal_runtime.sample_path "generated_es_verifactu_example.xml")
        (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
    inl text = file_system.read_all_text (generated_fiscal_runtime.sample_path "generated_es_verifactu_example.xml")
    let rec runs (left : i32) (parses : list i64) (writes : list i64) (bytes : i64) : list i64 * list i64 * i64 =
        if left = 0i32 then parses, writes, bytes
        else
            inl watch = date_time.stopwatch ()
            date_time.stopwatch_start watch
            inl start = date_time.stopwatch_elapsed_microseconds watch
            match xml.read_xml text with
            | node :: [] =>
                inl parsed = xml_codec.expect_decoded (x_reg_factu_sistema_facturacion_of_xml node)
                inl parsed_at = date_time.stopwatch_elapsed_microseconds watch
                inl written =
                    xml.write_node (x_reg_factu_sistema_facturacion_to_xml "RegFactuSistemaFacturacion" parsed)
                inl written_at = date_time.stopwatch_elapsed_microseconds watch
                inl parses = generated_fiscal_runtime.insert_run (parsed_at - start) parses
                inl writes = generated_fiscal_runtime.insert_run (written_at - parsed_at) writes
                runs (left - 1i32) parses writes (bytes + sm'.length written)
            | _ => failwith "one RegFactuSistemaFacturacion element"
    inl _ = runs (dyn 5i32) [] [] 0i64
    inl parses, writes, bytes = runs (dyn 31i32) [] [] 0i64
    inl row = sm'.(++#) "generated_es_verifactu parse_us " (generated_fiscal_runtime.median parses)
    inl row = sm'.(++#) row (sm'.(++#) " write_us " (generated_fiscal_runtime.median writes))
    inl row = sm'.(++#) row (sm'.(++#) " runs 31 bytes " (sm'.obj_to_string bytes))
    console.write_line row
    match xml.read_xml text with
    | node :: [] =>
        inl parsed = xml_codec.expect_decoded (x_reg_factu_sistema_facturacion_of_xml node)
        inl document =
            xml.element
                "RegFactuSistemaFacturacion"
                (
                    (
                        "xmlns",
                        "https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aplicaciones/es/aea"
                        ^^ "t/tike/cont/ws/SuministroLR.xsd"
                    )
                    :: (
                        "xmlns:sf",
                        "https://www2.agenciatributaria.gob.es/static_files/common/internet/dep/aplicaciones/es/"
                        ^^ "aeat/tike/cont/ws/SuministroInformacion.xsd"
                    )
                    :: x_reg_factu_sistema_facturacion_attributes parsed
                )
                (x_reg_factu_sistema_facturacion_children parsed)
        inl folder = generated_fiscal_runtime.sample_path "../target/bench"
        match file_system.directory_create_all folder with
        | Ok _ =>
            file_system.write_all_text
                (sm'.(++#) folder "/ours-generated_es_verifactu_example.xml")
                (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
        | Error _ => failwith "cannot create target/bench"
    | _ => failwith "one RegFactuSistemaFacturacion element"

///> rust
test generated_es_verifactu_keeps_raw_strings_out fails "Unification failure" =
    x_year_type_to_string "raw"

///> rust
test generated_es_verifactu_reports_a_missing_element_with_its_path =
    inl document =
        xml_codec.pruned
            "NombreRazon"
            (
                x_reg_factu_sistema_facturacion_to_xml
                    "RegFactuSistemaFacturacion"
                    (x_reg_factu_sistema_facturacion_example 0i32)
            )
    if
        xml_codec.reports
            "missing Cabecera/sf:ObligadoEmision/sf:NombreRazon"
            (x_reg_factu_sistema_facturacion_of_xml document)
        = false
    then failwith "a document without Cabecera/sf:ObligadoEmision/sf:NombreRazon is reported as missing, not raised"
