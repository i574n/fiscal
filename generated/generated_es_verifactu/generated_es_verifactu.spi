        | ReferenceType_field_DigestMethod => [ x_reference_type_digest_method_to_xml "DigestMethod" v ]
        | ReferenceType_field_DigestValue => [ xml.element "DigestValue" [] (xml.text_children v) ]
    inl rec walk (fields : list (exists r. x_reference_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_reference_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists ReferenceType_field_Transforms
        exists ReferenceType_field_DigestMethod
        exists ReferenceType_field_DigestValue
    ]

and let x_reference_type_attributes (x : x_reference_type) : list (string * string) =
    listm.concat [
        xml.option_list (optionm.map (fun v => "Id", v) x.id)
        [ ("URI", to_text x.uri) ]
        xml.option_list (optionm.map (fun v => "Type", v) x.type_value)
    ]

