let rec x_reg_factu_sistema_facturacion_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_reg_factu_sistema_facturacion
    =
    {
        cabecera = (fun c => x_cabecera_type_of_xml c) (xml.required_child "Cabecera" children)
        registro_factura =
            listm.map (fun c => x_registro_factura_type_of_xml c) (xml.children_named "RegistroFactura" children)
    }

