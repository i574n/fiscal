    x_reg_factu_sistema_facturacion_of_children (xml.element_attributes c) (xml.element_children c)

and let x_registro_factura_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_registro_factura_type
    =
    {
        choice_registro_alta = x_registro_factura_type_choice_sf_registro_alta_of_children attributes children
    }

and let x_registro_factura_type_of_xml (c : xml.xml_node) : x_registro_factura_type =
    x_registro_factura_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_registro_factura_type_choice_sf_registro_alta_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_registro_factura_type_choice_sf_registro_alta
    =
    if false then failwith "unreachable"
    elif xml.has_child "sf:RegistroAlta" children then
        RegistroFacturaType_choice_sf_RegistroAlta_sf_RegistroAlta (
            (fun c => x_registro_facturacion_alta_type_of_xml c) (xml.required_child "sf:RegistroAlta" children)
        )
    elif xml.has_child "sf:RegistroAnulacion" children then
        RegistroFacturaType_choice_sf_RegistroAlta_sf_RegistroAnulacion (
            (fun c => x_registro_facturacion_anulacion_type_of_xml c) (xml.required_child "sf:RegistroAnulacion" children)
        )
    else failwith "x_registro_factura_type_choice_sf_registro_alta: no alternative present"

