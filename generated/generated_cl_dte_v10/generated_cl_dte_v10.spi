    inl index = ((k % 8i32) + 8i32) % 8i32
    if index = 0i32 then TipMonType_BOLIVAR
    elif index = 1i32 then TipMonType_BOLIVIANO
    elif index = 2i32 then TipMonType_CHELIN
    elif index = 3i32 then TipMonType_CORONA_DIN
    elif index = 4i32 then TipMonType_CORONA_NOR
    elif index = 5i32 then TipMonType_CORONA_SC
    elif index = 6i32 then TipMonType_CRUZEIRO_REAL
    else TipMonType_DIRHAM

