and let x_signature_type_key_info_key_value_choice_rsa_key_value_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_signature_type_key_info_key_value_choice_rsa_key_value
    =
    if false then failwith "unreachable"
    elif xml.has_child "RSAKeyValue" children then
        SignatureType_KeyInfo_KeyValue_choice_RSAKeyValue_RSAKeyValue (
            (fun c => x_signature_type_key_info_key_value_choice_rsa_key_value_rsa_key_value_of_xml c) (xml.required_child "RSAKeyValue" children)
        )
    elif xml.has_child "DSAKeyValue" children then
