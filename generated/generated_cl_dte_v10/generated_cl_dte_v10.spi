    if i >= sm'.length s then state = 3i32
    else
        inl c = xml.code_point_at s i
        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_68c18fd1_16 1i32 s next
            else false
        elif state = 1i32 then
            if c = 45u32 then xsd_pattern_68c18fd1_16 2i32 s next
            elif 48u32 <= c && c <= 57u32 then xsd_pattern_68c18fd1_16 1i32 s next
            else false
        elif state = 2i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_68c18fd1_16 3i32 s next
            elif c = 75u32 then xsd_pattern_68c18fd1_16 3i32 s next
            else false
        elif state = 3i32 then
            false
        else false

