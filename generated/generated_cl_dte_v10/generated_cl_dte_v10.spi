union x_doc_type =
    | DocType_33
    | DocType_34
    | DocType_46
    | DocType_52
    | DocType_56
    | DocType_61

inl x_doc_type_of_string (s : string) : option x_doc_type =
    inl s = xml.collapsed_space s
    match s with
    | "33" => Some DocType_33
    | "34" => Some DocType_34
    | "46" => Some DocType_46
    | "52" => Some DocType_52
