            (fun c => x_signature_type_key_info_key_value_choice_rsa_key_value_dsa_key_value_of_xml c) (xml.required_child "DSAKeyValue" children)
        )
    else failwith "x_signature_type_key_info_key_value_choice_rsa_key_value: no alternative present"

