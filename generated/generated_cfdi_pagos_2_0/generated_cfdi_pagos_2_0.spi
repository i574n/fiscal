nominal private x_c_codigo_postal = string

inl x_c_codigo_postal_table () : string =
    "0 48-48>868 49-49>856 50-50>694 51-52>682 53-53>542 54-54>466 55-56>682 57-57>082\n"
    ^^ "0 48-48>380 49-49>294 50-50>890 51-51>240 52-52>890 53-53>154 54-57>890\n"
    ^^ "0 48-48>218 49-53>902 54-54>196 55-57>902\n0 48-53>914 55-57>914\n0 48-52>914 54-57>914\n"
    ^^ "0 48-54>902 55-55>272 56-57>902\n0 48-54>914 56-57>914\n0 48-50>902 51-51>326 52-57>902\n"
    ^^ "0 48-48>914 49-49>358 50-57>914\n0 48-48>962 53-57>962\n0 48-54>902 55-55>412 56-57>902\n"
    ^^ "0 48-52>914 53-53>444 54-57>914\n0 48-48>962 52-52>962\n0 48-55>890 56-56>498 57-57>890\n"
    ^^ "0 48-56>902 57-57>520\n0 48-50>914 52-57>914\n0 48-49>890 50-50>660 51-51>890 52-52>594 53-57>890\n"
    ^^ "0 48-52>902 53-53>626 54-57>902\n0 51-51>648 55-57>914\n0 57-57>962\n0 48-55>902 57-57>902\n0 48-57>890\n"
    ^^ "0 48-48>780 49-55>890 56-56>736 57-57>890\n0 48-51>902 52-52>768 53-57>902\n0 48-54>914\n"
    ^^ "0 48-53>902 54-54>812 55-57>902\n0 48-51>914 52-52>844 53-57>914\n0 49-57>962\n0 48-54>890\n"
    ^^ "0 48-48>926 49-57>890\n0 48-57>902\n0 48-57>914\n0 48-57>962\n0 48-48>938\n0 48-48>950\n0 48-48>962\n1\n"

inl x_c_codigo_postal_of_string (s : string) : option x_c_codigo_postal =
    inl s = xml.collapsed_space s
    if xsd_regex.table_matches (x_c_codigo_postal_table ()) s then Some (x_c_codigo_postal s) else None

inl x_c_codigo_postal_to_string (x : x_c_codigo_postal) : string = match x with x_c_codigo_postal s => s
instance to_text x_c_codigo_postal = fun x => x_c_codigo_postal_to_string x

inl x_c_codigo_postal_example (k : i32) : x_c_codigo_postal =
    inl index = ((k % 8i32) + 8i32) % 8i32
    if index = 0i32 then x_c_codigo_postal "00000"
    elif index = 1i32 then x_c_codigo_postal "20000"
    elif index = 2i32 then x_c_codigo_postal "20001"
    elif index = 3i32 then x_c_codigo_postal "20002"
    elif index = 4i32 then x_c_codigo_postal "20003"
    elif index = 5i32 then x_c_codigo_postal "20004"
    elif index = 6i32 then x_c_codigo_postal "20005"
    else x_c_codigo_postal "20006"

inl x_c_codigo_postal_example_text (k : i32) : string = x_c_codigo_postal_to_string (x_c_codigo_postal_example k)

