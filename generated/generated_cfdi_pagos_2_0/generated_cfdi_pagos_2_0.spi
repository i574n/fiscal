and let x_pagos_pago_docto_relacionado_impuestos_dr_retenciones_dr_retencion_dr_to_xml
    (name : string) (x : x_pagos_pago_docto_relacionado_impuestos_dr_retenciones_dr_retencion_dr)
    : xml.xml_node
    =
    xml.element name
        (x_pagos_pago_docto_relacionado_impuestos_dr_retenciones_dr_retencion_dr_attributes x)
        (x_pagos_pago_docto_relacionado_impuestos_dr_retenciones_dr_retencion_dr_children x)

and let x_pagos_totales_children (x : x_pagos_totales) : list xml.xml_node = []

and let x_pagos_totales_attributes (x : x_pagos_totales) : list (string * string) =
    listm.concat [
        xml.option_list (optionm.map (fun v => "TotalRetencionesIVA", to_text v) x.total_retenciones_iva)
        xml.option_list (optionm.map (fun v => "TotalRetencionesISR", to_text v) x.total_retenciones_isr)
        xml.option_list (optionm.map (fun v => "TotalRetencionesIEPS", to_text v) x.total_retenciones_ieps)
        xml.option_list (optionm.map (fun v => "TotalTrasladosBaseIVA16", to_text v) x.total_traslados_base_iva16)
        xml.option_list (
            optionm.map (fun v => "TotalTrasladosImpuestoIVA16", to_text v) x.total_traslados_impuesto_iva16
        )
        xml.option_list (optionm.map (fun v => "TotalTrasladosBaseIVA8", to_text v) x.total_traslados_base_iva8)
        xml.option_list (optionm.map (fun v => "TotalTrasladosImpuestoIVA8", to_text v) x.total_traslados_impuesto_iva8)
        xml.option_list (optionm.map (fun v => "TotalTrasladosBaseIVA0", to_text v) x.total_traslados_base_iva0)
        xml.option_list (optionm.map (fun v => "TotalTrasladosImpuestoIVA0", to_text v) x.total_traslados_impuesto_iva0)
        xml.option_list (
            optionm.map (fun v => "TotalTrasladosBaseIVAExento", to_text v) x.total_traslados_base_iva_exento
        )
        [ ("MontoTotalPagos", to_text x.monto_total_pagos) ]
    ]

and let x_pagos_totales_to_xml (name : string) (x : x_pagos_totales) : xml.xml_node =
    xml.element name (x_pagos_totales_attributes x) (x_pagos_totales_children x)

