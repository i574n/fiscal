            optionm.map
                fun v => xml.required_value "x_t_importe_mxn" (x_t_importe_mxn_of_string v)
                (xml.attribute_of "TotalTrasladosBaseIVA16" attributes)
        total_traslados_impuesto_iva16 =
            optionm.map
                fun v => xml.required_value "x_t_importe_mxn" (x_t_importe_mxn_of_string v)
                (xml.attribute_of "TotalTrasladosImpuestoIVA16" attributes)
        total_traslados_base_iva8 =
            optionm.map
                fun v => xml.required_value "x_t_importe_mxn" (x_t_importe_mxn_of_string v)
                (xml.attribute_of "TotalTrasladosBaseIVA8" attributes)
        total_traslados_impuesto_iva8 =
            optionm.map
                fun v => xml.required_value "x_t_importe_mxn" (x_t_importe_mxn_of_string v)
                (xml.attribute_of "TotalTrasladosImpuestoIVA8" attributes)
        total_traslados_base_iva0 =
            optionm.map
                fun v => xml.required_value "x_t_importe_mxn" (x_t_importe_mxn_of_string v)
                (xml.attribute_of "TotalTrasladosBaseIVA0" attributes)
        total_traslados_impuesto_iva0 =
            optionm.map
                fun v => xml.required_value "x_t_importe_mxn" (x_t_importe_mxn_of_string v)
                (xml.attribute_of "TotalTrasladosImpuestoIVA0" attributes)
        total_traslados_base_iva_exento =
            optionm.map
                fun v => xml.required_value "x_t_importe_mxn" (x_t_importe_mxn_of_string v)
                (xml.attribute_of "TotalTrasladosBaseIVAExento" attributes)
        monto_total_pagos =
            xml.required_value
                "x_t_importe_mxn"
                (x_t_importe_mxn_of_string (xml.required_attribute "MontoTotalPagos" attributes))
    }

and let x_pagos_totales_of_xml (c : xml.xml_node) : x_pagos_totales =
    x_pagos_totales_of_children (xml.element_attributes c) (xml.element_children c)

and let x_pagos_children (x : x_pagos) : list xml.xml_node =
    inl nodes forall r. (f : x_pagos_field r) (v : r) : list xml.xml_node =
        match f with
        | Pagos_field_Totales => [ x_pagos_totales_to_xml "Totales" v ]
        | Pagos_field_Pago => listm.map (fun v => x_pagos_pago_to_xml "Pago" v) v
    inl rec walk (fields : list (exists r. x_pagos_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_pagos_get f x)) (walk rest)
        | [] => []
    walk [ exists Pagos_field_Totales; exists Pagos_field_Pago ]

and let x_pagos_attributes (x : x_pagos) : list (string * string) = [ ("Version", x.version) ]

and let x_pagos_to_xml (name : string) (x : x_pagos) : xml.xml_node =
    xml.element name (x_pagos_attributes x) (x_pagos_children x)

and let x_pagos_pago_children (x : x_pagos_pago) : list xml.xml_node =
    inl nodes forall r. (f : x_pagos_pago_field r) (v : r) : list xml.xml_node =
        match f with
        | Pagos_Pago_field_DoctoRelacionado =>
            listm.map (fun v => x_pagos_pago_docto_relacionado_to_xml "DoctoRelacionado" v) v
        | Pagos_Pago_field_ImpuestosP =>
            xml.option_list (optionm.map (fun v => x_pagos_pago_impuestos_p_to_xml "ImpuestosP" v) v)
    inl rec walk (fields : list (exists r. x_pagos_pago_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_pagos_pago_get f x)) (walk rest)
        | [] => []
    walk [ exists Pagos_Pago_field_DoctoRelacionado; exists Pagos_Pago_field_ImpuestosP ]

and let x_pagos_pago_attributes (x : x_pagos_pago) : list (string * string) =
    listm.concat [
        [ ("FechaPago", to_text x.fecha_pago) ]
        [ ("FormaDePagoP", to_text x.forma_de_pago_p) ]
        [ ("MonedaP", to_text x.moneda_p) ]
        xml.option_list (optionm.map (fun v => "TipoCambioP", v) x.tipo_cambio_p)
        [ ("Monto", to_text x.monto) ]
        xml.option_list (optionm.map (fun v => "NumOperacion", to_text v) x.num_operacion)
        xml.option_list (optionm.map (fun v => "RfcEmisorCtaOrd", to_text v) x.rfc_emisor_cta_ord)
        xml.option_list (optionm.map (fun v => "NomBancoOrdExt", to_text v) x.nom_banco_ord_ext)
        xml.option_list (optionm.map (fun v => "CtaOrdenante", to_text v) x.cta_ordenante)
        xml.option_list (optionm.map (fun v => "RfcEmisorCtaBen", to_text v) x.rfc_emisor_cta_ben)
        xml.option_list (optionm.map (fun v => "CtaBeneficiario", to_text v) x.cta_beneficiario)
        xml.option_list (optionm.map (fun v => "TipoCadPago", to_text v) x.tipo_cad_pago)
        xml.option_list (optionm.map (fun v => "CertPago", v) x.cert_pago)
        xml.option_list (optionm.map (fun v => "CadPago", to_text v) x.cad_pago)
        xml.option_list (optionm.map (fun v => "SelloPago", v) x.sello_pago)
    ]

