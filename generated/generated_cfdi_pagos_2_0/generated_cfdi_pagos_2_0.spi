instance to_text x_c_moneda = fun x => x_c_moneda_to_string x

inl x_c_moneda_example (k : i32) : x_c_moneda =
    inl index = ((k % 8i32) + 8i32) % 8i32
    if index = 0i32 then Xc_Moneda_AED
    elif index = 1i32 then Xc_Moneda_AFN
    elif index = 2i32 then Xc_Moneda_ALL
    elif index = 3i32 then Xc_Moneda_AMD
    elif index = 4i32 then Xc_Moneda_ANG
    elif index = 5i32 then Xc_Moneda_AOA
    elif index = 6i32 then Xc_Moneda_ARS
    else Xc_Moneda_AUD

inl x_c_moneda_example_text (k : i32) : string = x_c_moneda_to_string (x_c_moneda_example k)

