    }

and let x_reference_type_digest_method_example (k : i32) : x_reference_type_digest_method =
    {
        algorithm = "http://www.w3.org/2000/09/xmldsig#sha1"
    }

and let x_transforms_type_example (k : i32) : x_transforms_type =
    {
        transform = [ x_transform_type_example (k + 0i32); x_transform_type_example (k + 1i32) ]
    }

and let x_transform_type_example (k : i32) : x_transform_type =
    {
        x_path = "1"
        algorithm = x_t_transform_uri_example k
    }

and let x_key_info_type_example (k : i32) : x_key_info_type =
    {
        x509_data = x_x509_data_type_example k
        id = None
    }

and let x_x509_data_type_example (k : i32) : x_x509_data_type =
    {
        x509_certificate = "AAAA"
    }


inl sample_path (name : string) : string =
    inl from_env = env.get_environment_variable "FISCAL_ROOT"
    inl root =
        if from_env <> "" then from_env
        else
            inl here = file_system.get_current_directory ()
            match here |> file_system.find_parent file_system.File "src/generator.spi" with
            | Ok dir => dir
            | Error message => failwith message
    sm'.(++#) (sm'.(++#) root "/samples/") name
///> rust
test generated_cr_factura_compra_4_4_writes_its_example =
    inl example = x_factura_electronica_compra_example 0i32
    inl document =
        xml.element
            "FacturaElectronicaCompra"
            (
                ("xmlns", "https://cdn.comprobanteselectronicos.go.cr/xml-schemas/v4.4/facturaElectronicaCompra")
                :: x_factura_electronica_compra_attributes example
            )
            (x_factura_electronica_compra_children example)
    file_system.write_all_text
        (sample_path "generated_cr_factura_compra_4_4_example.xml")
        (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
    inl text = file_system.read_all_text (sample_path "generated_cr_factura_compra_4_4_example.xml")
    let rec insert (x : i64) (xs : list i64) : list i64 =
        match xs with
        | y :: rest => if x <= y then x :: xs else y :: insert x rest
        | [] => x :: []
    let rec nth (i : i32) (xs : list i64) : i64 =
        match xs with
        | y :: rest => if i = 0i32 then y else nth (i - 1i32) rest
        | [] => -1i64
    let rec runs (left : i32) (parses : list i64) (writes : list i64) (bytes : i64) : list i64 * list i64 * i64 =
        if left = 0i32 then parses, writes, bytes
        else
            inl watch = date_time.stopwatch ()
            date_time.stopwatch_start watch
            inl start = date_time.stopwatch_elapsed_microseconds watch
            match xml.read_xml text with
            | node :: [] =>
                inl parsed = x_factura_electronica_compra_of_xml Unsigned node
                inl parsed_at = date_time.stopwatch_elapsed_microseconds watch
                inl written = xml.write_node (x_factura_electronica_compra_to_xml "FacturaElectronicaCompra" parsed)
                inl written_at = date_time.stopwatch_elapsed_microseconds watch
                inl parses = insert (parsed_at - start) parses
                inl writes = insert (written_at - parsed_at) writes
                runs (left - 1i32) parses writes (bytes + sm'.length written)
            | _ => failwith "one FacturaElectronicaCompra element"
    inl _ = runs (dyn 5i32) [] [] 0i64
    inl parses, writes, bytes = runs (dyn 31i32) [] [] 0i64
    inl cell (x : i64) : string = sm'.obj_to_string x
    inl row = sm'.(++#) "generated_cr_factura_compra_4_4 parse_us " (cell (nth 15i32 parses))
    inl row = sm'.(++#) row (sm'.(++#) " write_us " (cell (nth 15i32 writes)))
    inl row = sm'.(++#) row (sm'.(++#) " runs 31 bytes " (cell bytes))
    console.write_line row
    match xml.read_xml text with
    | node :: [] =>
        inl parsed = x_factura_electronica_compra_of_xml Unsigned node
        inl document =
            xml.element
                "FacturaElectronicaCompra"
                (
                    ("xmlns", "https://cdn.comprobanteselectronicos.go.cr/xml-schemas/v4.4/facturaElectronicaCompra")
                    :: x_factura_electronica_compra_attributes parsed
                )
                (x_factura_electronica_compra_children parsed)
        inl folder = sample_path "../target/bench"
        match file_system.create_dir_all folder |> resultm.unbox with
        | Ok _ =>
            file_system.write_all_text
                (sm'.(++#) folder "/ours-generated_cr_factura_compra_4_4_example.xml")
                (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
        | Error _ => failwith "cannot create target/bench"
    | _ => failwith "one FacturaElectronicaCompra element"

///> rust
test generated_cr_factura_compra_4_4_keeps_raw_strings_out fails "Unification failure" =
    x_clave_type_to_string "raw"
