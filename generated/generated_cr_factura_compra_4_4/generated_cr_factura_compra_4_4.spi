let rec x_factura_electronica_compra_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : x_factura_electronica_compra s
    =
    {
        clave =
            (fun c => xml.required_value "x_clave_type" (x_clave_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "Clave" children)
        proveedor_sistemas =
            (fun c => xml.required_value "x_factura_electronica_compra_proveedor_sistemas" (x_factura_electronica_compra_proveedor_sistemas_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "ProveedorSistemas" children)
        codigo_actividad_emisor =
            optionm.map
                fun c =>
                    xml.required_value "x_factura_electronica_compra_codigo_actividad_emisor" (
                        x_factura_electronica_compra_codigo_actividad_emisor_of_string (xml.text_in (
                        xml.element_children c)))
                (xml.first_child "CodigoActividadEmisor" children)
        codigo_actividad_receptor =
            (fun c => xml.required_value "x_factura_electronica_compra_codigo_actividad_receptor" (x_factura_electronica_compra_codigo_actividad_receptor_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CodigoActividadReceptor" children)
        numero_consecutivo =
            (fun c => xml.required_value "x_numero_consecutivo_type" (x_numero_consecutivo_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "NumeroConsecutivo" children)
        fecha_emision = (fun c => xml.text_in (xml.element_children c)) (xml.required_child "FechaEmision" children)
        emisor = (fun c => x_emisor_type_of_xml c) (xml.required_child "Emisor" children)
        receptor = (fun c => x_receptor_type_of_xml c) (xml.required_child "Receptor" children)
        condicion_venta =
            (fun c => xml.required_value "x_factura_electronica_compra_condicion_venta" (x_factura_electronica_compra_condicion_venta_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CondicionVenta" children)
        condicion_venta_otros =
            optionm.map
                fun c =>
                    xml.required_value "x_factura_electronica_compra_condicion_venta_otros" (
                        x_factura_electronica_compra_condicion_venta_otros_of_string (xml.text_in (
                        xml.element_children c)))
                (xml.first_child "CondicionVentaOtros" children)
        plazo_credito =
            optionm.map (fun c => xml.text_in (xml.element_children c)) (xml.first_child "PlazoCredito" children)
        detalle_servicio =
            (fun c => x_factura_electronica_compra_detalle_servicio_of_xml c) (xml.required_child "DetalleServicio" children)
        otros_cargos = listm.map (fun c => x_otros_cargos_type_of_xml c) (xml.children_named "OtrosCargos" children)
        resumen_factura =
            (fun c => x_factura_electronica_compra_resumen_factura_of_xml c) (xml.required_child "ResumenFactura" children)
        informacion_referencia =
            listm.map
                fun c => x_factura_electronica_compra_informacion_referencia_of_xml c
                (xml.children_named "InformacionReferencia" children)
        otros = optionm.map (fun c => x_factura_electronica_compra_otros_of_xml c) (xml.first_child "Otros" children)
        signature = listm.map (fun c => x_signature_type_of_xml c) (xml.children_named "ds:Signature" children)
    }

and let x_factura_electronica_compra_of_xml forall s.
    (witness : stage s) (c : xml.xml_node)
    : x_factura_electronica_compra s
    =
    x_factura_electronica_compra_of_children witness (xml.element_attributes c) (xml.element_children c)

