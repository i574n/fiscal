        | OtrosCargosType_field_TipoDocumentoOTROS => optional_text_nodes "TipoDocumentoOTROS" v
        | OtrosCargosType_field_IdentificacionTercero =>
            xml.option_list (optionm.map (fun v => x_identificacion_type_to_xml "IdentificacionTercero" v) v)
        | OtrosCargosType_field_NombreTercero => optional_text_nodes "NombreTercero" v
        | OtrosCargosType_field_Detalle => [ text_node "Detalle" v ]
        | OtrosCargosType_field_PorcentajeOC =>
            xml.option_list (optionm.map (fun v => xml.element "PorcentajeOC" [] (xml.text_children v)) v)
        | OtrosCargosType_field_MontoCargo => [ xml.element "MontoCargo" [] (xml.text_children v) ]
    inl rec walk (fields : list (exists r. x_otros_cargos_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_otros_cargos_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists OtrosCargosType_field_TipoDocumentoOC
        exists OtrosCargosType_field_TipoDocumentoOTROS
        exists OtrosCargosType_field_IdentificacionTercero
        exists OtrosCargosType_field_NombreTercero
        exists OtrosCargosType_field_Detalle
        exists OtrosCargosType_field_PorcentajeOC
        exists OtrosCargosType_field_MontoCargo
    ]

