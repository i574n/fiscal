    listm.concat [
        [ text_node "Clave" x.clave ]
        [ text_node "ProveedorSistemas" x.proveedor_sistemas ]
        optional_text_nodes "CodigoActividadEmisor" x.codigo_actividad_emisor
        [ text_node "CodigoActividadReceptor" x.codigo_actividad_receptor ]
        [ text_node "NumeroConsecutivo" x.numero_consecutivo ]
        [ xml.element "FechaEmision" [] (xml.text_children x.fecha_emision) ]
        [ x_emisor_type_to_xml "Emisor" x.emisor ]
        [ x_receptor_type_to_xml "Receptor" x.receptor ]
        [ text_node "CondicionVenta" x.condicion_venta ]
        optional_text_nodes "CondicionVentaOtros" x.condicion_venta_otros
        xml.option_list (optionm.map (fun v => xml.element "PlazoCredito" [] (xml.text_children v)) x.plazo_credito)
        [ x_factura_electronica_compra_detalle_servicio_to_xml "DetalleServicio" x.detalle_servicio ]
        listm.map (fun v => x_otros_cargos_type_to_xml "OtrosCargos" v) x.otros_cargos
        [ x_factura_electronica_compra_resumen_factura_to_xml "ResumenFactura" x.resumen_factura ]
        listm.map
            fun v => x_factura_electronica_compra_informacion_referencia_to_xml "InformacionReferencia" v
            x.informacion_referencia
        xml.option_list (optionm.map (fun v => x_factura_electronica_compra_otros_to_xml "Otros" v) x.otros)
        listm.map (fun v => x_signature_type_to_xml "ds:Signature" v) x.signature
