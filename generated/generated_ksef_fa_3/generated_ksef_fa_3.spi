inl x_t_kod_waluty_example (k : i32) : x_t_kod_waluty =
    inl index = ((k % 8i32) + 8i32) % 8i32
    if index = 0i32 then TKodWaluty_AED
    elif index = 1i32 then TKodWaluty_AFN
    elif index = 2i32 then TKodWaluty_ALL
    elif index = 3i32 then TKodWaluty_AMD
    elif index = 4i32 then TKodWaluty_ANG
    elif index = 5i32 then TKodWaluty_AOA
    elif index = 6i32 then TKodWaluty_ARS
    else TKodWaluty_AUD

inl x_t_kod_waluty_example_text (k : i32) : string = x_t_kod_waluty_to_string (x_t_kod_waluty_example k)

