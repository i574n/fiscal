and let x_faktura_children (x : x_faktura) : list xml.xml_node =
    inl nodes forall r. (f : x_faktura_field r) (v : r) : list xml.xml_node =
        match f with
        | Faktura_field_Naglowek => [ x_t_naglowek_to_xml "Naglowek" v ]
        | Faktura_field_Podmiot1 => [ x_faktura_podmiot1_to_xml "Podmiot1" v ]
        | Faktura_field_Podmiot2 => [ x_faktura_podmiot2_to_xml "Podmiot2" v ]
        | Faktura_field_Podmiot3 => listm.map (fun v => x_faktura_podmiot3_to_xml "Podmiot3" v) v
        | Faktura_field_PodmiotUpowazniony =>
            xml.option_list (optionm.map (fun v => x_faktura_podmiot_upowazniony_to_xml "PodmiotUpowazniony" v) v)
        | Faktura_field_Fa => [ x_faktura_fa_to_xml "Fa" v ]
        | Faktura_field_Stopka => xml.option_list (optionm.map (fun v => x_faktura_stopka_to_xml "Stopka" v) v)
        | Faktura_field_Zalacznik => xml.option_list (optionm.map (fun v => x_faktura_zalacznik_to_xml "Zalacznik" v) v)
    inl rec walk (fields : list (exists r. x_faktura_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_faktura_get f x)) (walk rest)
        | [] => []
    walk [
        exists Faktura_field_Naglowek
        exists Faktura_field_Podmiot1
        exists Faktura_field_Podmiot2
        exists Faktura_field_Podmiot3
        exists Faktura_field_PodmiotUpowazniony
        exists Faktura_field_Fa
        exists Faktura_field_Stopka
