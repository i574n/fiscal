    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_t_podmiot2_choice_nip
    =
    if false then failwith "unreachable"
    elif xml.has_child "NIP" children then
        TPodmiot2_choice_NIP_NIP (
            (fun c => xml.required_value "x_t_nr_nip" (x_t_nr_nip_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "NIP" children)
        )
    elif xml.has_child "KodUE" children
    then TPodmiot2_choice_NIP_group_KodUE (x_t_podmiot2_choice_nip_group_kod_ue_of_children attributes children)
    elif xml.has_child "KodKraju" children
    then TPodmiot2_choice_NIP_group_KodKraju (x_t_podmiot2_choice_nip_group_kod_kraju_of_children attributes children)
    elif xml.has_child "BrakID" children then
        TPodmiot2_choice_NIP_BrakID (
            (fun c => xml.required_value "x_t_wybor1" (x_t_wybor1_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "BrakID" children)
        )
    else failwith "x_t_podmiot2_choice_nip: no alternative present"

