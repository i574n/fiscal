    if index = 0i32 then TKodyKrajowUE_AT
    elif index = 1i32 then TKodyKrajowUE_BE
    elif index = 2i32 then TKodyKrajowUE_BG
    elif index = 3i32 then TKodyKrajowUE_CY
    elif index = 4i32 then TKodyKrajowUE_CZ
    elif index = 5i32 then TKodyKrajowUE_DK
    elif index = 6i32 then TKodyKrajowUE_EE
    else TKodyKrajowUE_FI

inl x_t_kody_krajow_ue_example_text (k : i32) : string = x_t_kody_krajow_ue_to_string (x_t_kody_krajow_ue_example k)

