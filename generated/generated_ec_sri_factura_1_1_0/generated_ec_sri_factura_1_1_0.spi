        xml_codec.read_optional "infoAdicional" x_factura_info_adicional_of_xml children errors
    inl v_signature, errors = xml_codec.read_optional "ds:Signature" x_signature_type_of_xml children errors
    inl v_id, errors = xml_codec.attribute_optional_parsed x_factura_id_of_string "id" attributes errors
    inl v_version, errors = xml.attribute_of "version" attributes, errors
    xml_codec.decoded_by errors fun () =>
        x_factura {
            info_tributaria = xml_codec.present o_info_tributaria
            info_factura = xml_codec.present o_info_factura
            detalles = xml_codec.present o_detalles
            reembolsos = v_reembolsos
            retenciones = v_retenciones
            tipo_negociable = v_tipo_negociable
            maquina_fiscal = v_maquina_fiscal
            info_adicional = v_info_adicional
            signature = v_signature
            id = v_id
            version = v_version
        }

and let x_factura_of_xml (c : xml.xml_node) : result (x_factura) (list xml_codec.decode_error) =
    x_factura_of_children (xml.element_attributes c) (xml.element_children c)

and let x_factura_children (x : x_factura) : list xml.xml_node =
    inl nodes forall r. (f : x_factura_field r) (v : r) : list xml.xml_node =
        match f with
        | Xfactura_field_infoTributaria => [ x_info_tributaria_to_xml "infoTributaria" v ]
        | Xfactura_field_infoFactura => [ x_factura_info_factura_to_xml "infoFactura" v ]
        | Xfactura_field_detalles => [ x_factura_detalles_to_xml "detalles" v ]
        | Xfactura_field_reembolsos => xml.option_list (optionm.map (fun v => x_reembolsos_to_xml "reembolsos" v) v)
        | Xfactura_field_retenciones =>
            xml.option_list (optionm.map (fun v => x_factura_retenciones_to_xml "retenciones" v) v)
        | Xfactura_field_tipoNegociable =>
            xml.option_list (optionm.map (fun v => x_tipo_negociable_to_xml "tipoNegociable" v) v)
        | Xfactura_field_maquinaFiscal =>
            xml.option_list (optionm.map (fun v => x_maquina_fiscal_to_xml "maquinaFiscal" v) v)
        | Xfactura_field_infoAdicional =>
            xml.option_list (optionm.map (fun v => x_factura_info_adicional_to_xml "infoAdicional" v) v)
        | Xfactura_field_ds_Signature =>
            xml.option_list (optionm.map (fun v => x_signature_type_to_xml "ds:Signature" v) v)
    inl rec walk (fields : list (exists r. x_factura_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_factura_get f x)) (walk rest)
        | [] => []
    walk [
        exists Xfactura_field_infoTributaria
        exists Xfactura_field_infoFactura
        exists Xfactura_field_detalles
        exists Xfactura_field_reembolsos
        exists Xfactura_field_retenciones
        exists Xfactura_field_tipoNegociable
        exists Xfactura_field_maquinaFiscal
        exists Xfactura_field_infoAdicional
        exists Xfactura_field_ds_Signature
    ]

and let x_factura_attributes (x : x_factura) : list (string * string) =
    listm.concat [
        xml.option_list (optionm.map (fun v => "id", to_text v) x.id)
        xml.option_list (optionm.map (fun v => "version", v) x.version)
    ]

and let x_factura_to_xml (name : string) (x : x_factura) : xml.xml_node =
    xml.element name (x_factura_attributes x) (x_factura_children x)

and let x_factura_example (k : i32) : x_factura =
    x_factura {
        info_tributaria = x_info_tributaria_example k
        info_factura = x_factura_info_factura_example k
        detalles = x_factura_detalles_example k
        reembolsos = None
        retenciones = None
        tipo_negociable = None
        maquina_fiscal = None
        info_adicional = None
        signature = None
        id = None
        version = None
    }


