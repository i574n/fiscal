    match f with
    | RSAKeyValueType_field_Modulus => { tag = "Modulus"; min = 1i32; max = Some 1i32 }
    | RSAKeyValueType_field_Exponent => { tag = "Exponent"; min = 1i32; max = Some 1i32 }

let rec x_rsa_key_value_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_rsa_key_value_type) (list xml_codec.decode_error)
    =
    inl errors = []
    inl o_modulus, errors = xml_codec.read_required "Modulus" xml_codec.read_text children errors
    inl o_exponent, errors = xml_codec.read_required "Exponent" xml_codec.read_text children errors
    xml_codec.decoded_by errors fun () =>
        x_rsa_key_value_type { modulus = xml_codec.present o_modulus; exponent = xml_codec.present o_exponent }

and let x_rsa_key_value_type_of_xml (c : xml.xml_node) : result (x_rsa_key_value_type) (list xml_codec.decode_error) =
    x_rsa_key_value_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_rsa_key_value_type_children (x : x_rsa_key_value_type) : list xml.xml_node =
    inl nodes forall r. (f : x_rsa_key_value_type_field r) (v : r) : list xml.xml_node =
        match f with
        | RSAKeyValueType_field_Modulus => [ xml.element "Modulus" [] (xml.text_children v) ]
        | RSAKeyValueType_field_Exponent => [ xml.element "Exponent" [] (xml.text_children v) ]
    inl rec walk (fields : list (exists r. x_rsa_key_value_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_rsa_key_value_type_get f x)) (walk rest)
        | [] => []
    walk [ exists RSAKeyValueType_field_Modulus; exists RSAKeyValueType_field_Exponent ]

and let x_rsa_key_value_type_attributes (x : x_rsa_key_value_type) : list (string * string) = []

