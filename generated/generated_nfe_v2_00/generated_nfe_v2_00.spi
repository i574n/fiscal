let rec x_tn_fe_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tn_fe s
    =
    {
        inf_n_fe = (fun c => x_tn_fe_inf_n_fe_of_xml c) (xml.required_child "infNFe" children)
        signature =
            staged_of witness fun () =>
                (fun c => x_signature_type_of_xml c) (xml.required_child "ds:Signature" children)
    }

and let x_tn_fe_of_xml forall s. (witness : stage s) (c : xml.xml_node) : x_tn_fe s =
    x_tn_fe_of_children witness (xml.element_attributes c) (xml.element_children c)

