and let x_tn_fe_children forall s. (x : x_tn_fe s) : list xml.xml_node =
    listm.concat [
        [ x_tn_fe_inf_n_fe_to_xml "infNFe" x.inf_n_fe ]
        staged_list (fun v => x_signature_type_to_xml "ds:Signature" v) x.signature
    ]

and let x_tn_fe_attributes forall s. (x : x_tn_fe s) : list (string * string) = []

and let x_tn_fe_to_xml forall s. (name : string) (x : x_tn_fe s) : xml.xml_node =
    xml.element name (x_tn_fe_attributes x) (x_tn_fe_children x)

and let x_tn_fe_inf_n_fe_children (x : x_tn_fe_inf_n_fe) : list xml.xml_node =
    inl nodes forall r. (f : x_tn_fe_inf_n_fe_field r) (v : r) : list xml.xml_node =
        match f with
        | TNFe_infNFe_field_ide => [ x_tn_fe_inf_n_fe_ide_to_xml "ide" v ]
        | TNFe_infNFe_field_emit => [ x_tn_fe_inf_n_fe_emit_to_xml "emit" v ]
        | TNFe_infNFe_field_avulsa =>
            xml.option_list (optionm.map (fun v => x_tn_fe_inf_n_fe_avulsa_to_xml "avulsa" v) v)
        | TNFe_infNFe_field_dest => [ x_tn_fe_inf_n_fe_dest_to_xml "dest" v ]
        | TNFe_infNFe_field_retirada => xml.option_list (optionm.map (fun v => x_t_local_to_xml "retirada" v) v)
        | TNFe_infNFe_field_entrega => xml.option_list (optionm.map (fun v => x_t_local_to_xml "entrega" v) v)
        | TNFe_infNFe_field_det => listm.map (fun v => x_tn_fe_inf_n_fe_det_to_xml "det" v) v
        | TNFe_infNFe_field_total => [ x_tn_fe_inf_n_fe_total_to_xml "total" v ]
        | TNFe_infNFe_field_transp => [ x_tn_fe_inf_n_fe_transp_to_xml "transp" v ]
        | TNFe_infNFe_field_cobr => xml.option_list (optionm.map (fun v => x_tn_fe_inf_n_fe_cobr_to_xml "cobr" v) v)
        | TNFe_infNFe_field_infAdic =>
            xml.option_list (optionm.map (fun v => x_tn_fe_inf_n_fe_inf_adic_to_xml "infAdic" v) v)
        | TNFe_infNFe_field_exporta =>
            xml.option_list (optionm.map (fun v => x_tn_fe_inf_n_fe_exporta_to_xml "exporta" v) v)
        | TNFe_infNFe_field_compra =>
            xml.option_list (optionm.map (fun v => x_tn_fe_inf_n_fe_compra_to_xml "compra" v) v)
        | TNFe_infNFe_field_cana => xml.option_list (optionm.map (fun v => x_tn_fe_inf_n_fe_cana_to_xml "cana" v) v)
    inl rec walk (fields : list (exists r. x_tn_fe_inf_n_fe_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tn_fe_inf_n_fe_get f x)) (walk rest)
        | [] => []
    walk [
        exists TNFe_infNFe_field_ide
        exists TNFe_infNFe_field_emit
        exists TNFe_infNFe_field_avulsa
        exists TNFe_infNFe_field_dest
        exists TNFe_infNFe_field_retirada
        exists TNFe_infNFe_field_entrega
        exists TNFe_infNFe_field_det
        exists TNFe_infNFe_field_total
        exists TNFe_infNFe_field_transp
        exists TNFe_infNFe_field_cobr
        exists TNFe_infNFe_field_infAdic
        exists TNFe_infNFe_field_exporta
        exists TNFe_infNFe_field_compra
        exists TNFe_infNFe_field_cana
    ]

and let x_tn_fe_inf_n_fe_attributes (x : x_tn_fe_inf_n_fe) : list (string * string) =
    listm.concat [ [ ("versao", to_text x.versao) ]; [ ("Id", to_text x.id) ] ]

