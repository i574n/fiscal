inl x_tpais_of_string (s : string) : option x_tpais =
    if xsd_regex.table_matches (x_tpais_table ()) s then Some (x_tpais s) else None

inl x_tpais_to_string (x : x_tpais) : string = match x with x_tpais s => s
instance to_text x_tpais = fun x => x_tpais_to_string x

inl x_tpais_example (k : i32) : x_tpais =
    inl index = ((k % 8i32) + 8i32) % 8i32
    if index = 0i32 then x_tpais "132"
    elif index = 1i32 then x_tpais "175"
    elif index = 2i32 then x_tpais "230"
    elif index = 3i32 then x_tpais "310"
    elif index = 4i32 then x_tpais "370"
    elif index = 5i32 then x_tpais "400"
    elif index = 6i32 then x_tpais "418"
    else x_tpais "434"

inl x_tpais_example_text (k : i32) : string = x_tpais_to_string (x_tpais_example k)

let rec xsd_pattern_2d10bacd_20 (state : i32) (s : string) (i : i32) : bool =
    if i >= sm'.length s then state = 1i32 || state = 2i32 || state = 3i32
    else
        inl c = xml.code_point_at s i
        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if c = 48u32 then xsd_pattern_2d10bacd_20 1i32 s next
            elif 49u32 <= c && c <= 57u32 then xsd_pattern_2d10bacd_20 2i32 s next
            else false
        elif state = 1i32 then
            false
        elif state = 2i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2d10bacd_20 3i32 s next
            else false
        elif state = 3i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2d10bacd_20 1i32 s next
            else false
        else false

