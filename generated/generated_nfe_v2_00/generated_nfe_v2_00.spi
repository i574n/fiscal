        )
    elif xml.has_child "CPF" children then
        TNFe_infNFe_ide_NFref_choice_refNFe_refNFP_choice_CNPJ_CPF (
            (fun c => xml.required_value "x_t_cpf" (x_t_cpf_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CPF" children)
        )
    else failwith "x_tn_fe_inf_n_fe_ide_n_fref_choice_ref_n_fe_ref_nfp_choice_cnpj: no alternative present"

