let rec xsd_pattern_4ed14858_37 (state : i32) (s : string) (i : i32) : bool =
    if i >= sm'.length s then state = 9i32 || state = 10i32
    else
        inl c = xml.code_point_at s i
        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if 65u32 <= c && c <= 90u32 then xsd_pattern_4ed14858_37 1i32 s next
            else false
        elif state = 1i32 then
            if 65u32 <= c && c <= 90u32 then xsd_pattern_4ed14858_37 2i32 s next
            else false
        elif state = 2i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_4ed14858_37 3i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_4ed14858_37 4i32 s next
            else false
        elif state = 3i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_4ed14858_37 5i32 s next
            else false
        elif state = 4i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_4ed14858_37 6i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_4ed14858_37 3i32 s next
            else false
        elif state = 5i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_4ed14858_37 7i32 s next
            else false
        elif state = 6i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_4ed14858_37 8i32 s next
            else false
        elif state = 7i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_4ed14858_37 9i32 s next
            else false
        elif state = 8i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_4ed14858_37 10i32 s next
            else false
        elif state = 9i32 then
            false
        elif state = 10i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_4ed14858_37 9i32 s next
            else false
        else false

