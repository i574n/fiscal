            (fun c => xml.required_value "x_t_local_x_bairro" (x_t_local_x_bairro_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "xBairro" children)
        c_mun =
            (fun c => xml.required_value "x_t_cod_mun_ibge" (x_t_cod_mun_ibge_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "cMun" children)
        x_mun =
            (fun c => xml.required_value "x_t_local_x_mun" (x_t_local_x_mun_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "xMun" children)
        uf =
            (fun c => xml.required_value "x_t_uf" (x_t_uf_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "UF" children)
    }

and let x_t_local_of_xml (c : xml.xml_node) : x_t_local =
    x_t_local_of_children (xml.element_attributes c) (xml.element_children c)

and let x_t_local_choice_cnpj_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_t_local_choice_cnpj
    =
    if false then failwith "unreachable"
    elif xml.has_child "CNPJ" children then
        TLocal_choice_CNPJ_CNPJ (
            (fun c => xml.required_value "x_t_cnpj_opc" (x_t_cnpj_opc_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CNPJ" children)
        )
    elif xml.has_child "CPF" children then
        TLocal_choice_CNPJ_CPF (
            (fun c => xml.required_value "x_t_cpf" (x_t_cpf_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CPF" children)
        )
    else failwith "x_t_local_choice_cnpj: no alternative present"

and let x_t_veiculo_of_children (attributes : list (string * string)) (children : list xml.xml_node) : x_t_veiculo =
    {
        placa =
            (fun c => xml.required_value "x_t_veiculo_placa" (x_t_veiculo_placa_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "placa" children)
        uf =
            (fun c => xml.required_value "x_t_uf" (x_t_uf_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "UF" children)
        rntc =
            optionm.map
                fun c =>
                    xml.required_value "x_t_veiculo_rntc" (x_t_veiculo_rntc_of_string (xml.text_in (
                        xml.element_children c)))
                (xml.first_child "RNTC" children)
    }

