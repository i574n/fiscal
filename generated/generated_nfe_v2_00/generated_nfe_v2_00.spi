    if index = 0i32 then TUf_AC
    elif index = 1i32 then TUf_AL
    elif index = 2i32 then TUf_AM
    elif index = 3i32 then TUf_AP
    elif index = 4i32 then TUf_BA
    elif index = 5i32 then TUf_CE
    elif index = 6i32 then TUf_DF
    else TUf_ES

inl x_t_uf_example_text (k : i32) : string = x_t_uf_to_string (x_t_uf_example k)

