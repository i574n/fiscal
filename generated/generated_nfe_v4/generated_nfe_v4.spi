and let x_tn_fe_children (x : x_tn_fe) : list xml.xml_node =
    inl nodes forall r. (f : x_tn_fe_field r) (v : r) : list xml.xml_node =
        match f with
        | TNFe_field_infNFe => [ x_tn_fe_inf_n_fe_to_xml "infNFe" v ]
        | TNFe_field_infNFeSupl =>
            xml.option_list (optionm.map (fun v => x_tn_fe_inf_n_fe_supl_to_xml "infNFeSupl" v) v)
        | TNFe_field_ds_Signature => [ x_signature_type_to_xml "ds:Signature" v ]
    inl rec walk (fields : list (exists r. x_tn_fe_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tn_fe_get f x)) (walk rest)
        | [] => []
    walk [ exists TNFe_field_infNFe; exists TNFe_field_infNFeSupl; exists TNFe_field_ds_Signature ]

