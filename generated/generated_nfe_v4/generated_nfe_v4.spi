let rec x_tn_fe_of_children (attributes : list (string * string)) (children : list xml.xml_node) : x_tn_fe =
    {
        inf_n_fe = (fun c => x_tn_fe_inf_n_fe_of_xml c) (xml.required_child "infNFe" children)
        inf_n_fe_supl = optionm.map (fun c => x_tn_fe_inf_n_fe_supl_of_xml c) (xml.first_child "infNFeSupl" children)
