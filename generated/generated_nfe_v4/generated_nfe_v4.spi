        TNFe_infNFe_agropecuario_choice_defensivo_guiaTransito (
            (fun c => x_tn_fe_inf_n_fe_agropecuario_choice_defensivo_guia_transito_of_xml c) (xml.required_child "guiaTransito" children)
        )
    else failwith "x_tn_fe_inf_n_fe_agropecuario_choice_defensivo: no alternative present"

