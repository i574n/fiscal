nominal private x_tn_fe_inf_n_fe_supl_qr_code = string

inl x_tn_fe_inf_n_fe_supl_qr_code_is_valid (s : string) : bool =
    (
        xsd_regex.table_matches (xsd_pattern_ef8672c2_341_table ()) s
        || xsd_pattern_0f92142f_128 0i32 s 0i32
        || xsd_regex.table_matches (xsd_pattern_ca5e59d5_239_table ()) s
        || xsd_pattern_12b0656b_84 0i32 s 0i32
        || xsd_pattern_c4553c89_259 0i32 s 0i32
    )
    && xml.code_point_count s >= 60
    && xml.code_point_count s <= 1000

