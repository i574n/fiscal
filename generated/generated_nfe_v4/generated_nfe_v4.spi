inl sample_path (name : string) : string =
    inl from_env = env.get_environment_variable "FISCAL_ROOT"
    inl root =
        if from_env <> "" then from_env
        else
            inl here = file_system.get_current_directory ()
            match here |> file_system.find_parent file_system.File "src/generator.spi" with
            | Ok dir => dir
            | Error message => failwith message
    sm'.(++#) (sm'.(++#) root "/samples/") name
///> rust
test generated_nfe_model_type_checks =
    match x_t_cod_uf_ibge_of_string "35" with
    | Some code => if x_t_cod_uf_ibge_to_string code <> "35" then failwith "TCodUfIBGE 35 round trip"
    | None => failwith "35 parses as TCodUfIBGE"
    if x_t_cnpj_is_valid "12345678000195" = false then failwith "a 14-digit CNPJ is valid"
    if x_t_cnpj_is_valid "1234567800019" then failwith "a 13-digit CNPJ is not"
    inl example = x_tn_fe_example 0i32
    inl document =
        xml.element
            "NFe"
            (("xmlns", "http://www.portalfiscal.inf.br/nfe") :: x_tn_fe_attributes example)
            (x_tn_fe_children example)
    file_system.write_all_text
        (sample_path "nfe_v4_example.xml")
        (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
    match
        xml.read_xml (
            "<enderEmit><xLgr>Rua A</xLgr><nro>10</nro><xBairro>Centro</xBairro><cMun>3550308</cMun><xMun>Sao "
            ^^ "Paulo</xMun><UF>SP</UF><CEP>01001000</CEP><cPais>1058</cPais></enderEmit>"
        )
    with
    | node :: [] =>
        inl address = x_t_ender_emi_of_xml node
        if
            x_t_ender_emi_x_mun_to_string address.x_mun <> "Sao Paulo"
            || x_t_ender_emi_cep_to_string address.cep <> "01001000"
        then failwith "TEnderEmi text fields"
        if x_t_uf_emi_to_string address.uf <> "SP" then failwith "TEnderEmi UF enumeration"
        if xml.same_node node (x_t_ender_emi_to_xml "enderEmit" address) = false
        then failwith "TEnderEmi XML round trip"
        match address.c_pais with
        | Some _ => ()
        | None => failwith "TEnderEmi optional cPais"
    | _ => failwith "one enderEmit element"
