and let x_cross_industry_invoice_type_children (x' : x_cross_industry_invoice_type) : list xml.xml_node =
    inl x = match x' with | Record_x_cross_industry_invoice_type r => r
    inl nodes forall r. (f : x_cross_industry_invoice_type_field r) (v : r) : list xml.xml_node =
        match f with
        | CrossIndustryInvoiceType_field_ExchangedDocumentContext =>
            [ x_exchanged_document_context_type_to_xml "ExchangedDocumentContext" v ]
        | CrossIndustryInvoiceType_field_ExchangedDocument => [ x_exchanged_document_type_to_xml "ExchangedDocument" v ]
        | CrossIndustryInvoiceType_field_SupplyChainTradeTransaction =>
            [ x_supply_chain_trade_transaction_type_to_xml "SupplyChainTradeTransaction" v ]
        | CrossIndustryInvoiceType_field_ValuationBreakdownStatement =>
            xml.option_list (
                optionm.map (fun v => x_valuation_breakdown_statement_type_to_xml "ValuationBreakdownStatement" v) v
            )
    inl rec walk (fields : list (exists r. x_cross_industry_invoice_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_cross_industry_invoice_type_get f x')) (walk rest)
        | [] => []
    walk [
        exists CrossIndustryInvoiceType_field_ExchangedDocumentContext
        exists CrossIndustryInvoiceType_field_ExchangedDocument
        exists CrossIndustryInvoiceType_field_SupplyChainTradeTransaction
        exists CrossIndustryInvoiceType_field_ValuationBreakdownStatement
    ]

and let x_cross_industry_invoice_type_attributes (x' : x_cross_industry_invoice_type) : list (string * string) =
    inl x = match x' with | Record_x_cross_industry_invoice_type r => r
    []

