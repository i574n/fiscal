union x_cross_industry_invoice_type_field r =
    | CrossIndustryInvoiceType_field_ExchangedDocumentContext ::
        x_cross_industry_invoice_type_field (x_exchanged_document_context_type)
    | CrossIndustryInvoiceType_field_ExchangedDocument ::
        x_cross_industry_invoice_type_field (x_exchanged_document_type)
    | CrossIndustryInvoiceType_field_SupplyChainTradeTransaction ::
        x_cross_industry_invoice_type_field (x_supply_chain_trade_transaction_type)
    | CrossIndustryInvoiceType_field_ValuationBreakdownStatement ::
        x_cross_industry_invoice_type_field (option (x_valuation_breakdown_statement_type))

inl x_cross_industry_invoice_type_get forall r.
    (f : x_cross_industry_invoice_type_field r) (x' : x_cross_industry_invoice_type)
    : r
    =
