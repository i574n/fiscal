///> rust
test generated_cii_d16b_writes_its_example =
    inl example = x_cross_industry_invoice_type_example 0i32
    inl document =
        xml.element
            "CrossIndustryInvoice"
            (
                ("xmlns", "urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100")
                :: x_cross_industry_invoice_type_attributes example
            )
            (x_cross_industry_invoice_type_children example)
    file_system.directory_create_all (generated_fiscal_runtime.sample_path "") |> ignore
    file_system.write_all_text
        (generated_fiscal_runtime.sample_path "generated_cii_d16b_example.xml")
        (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
    inl documents =
        [
            "deps/corpus/eu/en16931-cii/cii/examples/CII_business_example_01.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_business_example_02.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_business_example_Z.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example1.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example2.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example3.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example4.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example5.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example6.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example7.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example8.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII_example9.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/CII-BR-CO-10-RoundingIssue.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/huf_example_cii.xml"
            "deps/corpus/eu/en16931-cii/cii/examples/XRechnung-O.xml"
        ]
    inl check (path : string) : list string =
        inl text = file_system.read_all_text (generated_fiscal_runtime.sample_path (sm'.(++#) "../" path))
        match xml.read_xml text with
        | node :: [] =>
            match
                xml_codec.read_back_difference
                    (x_cross_industry_invoice_type_of_xml)
                    (x_cross_industry_invoice_type_to_xml "CrossIndustryInvoice")
                    node
            with
            | Some difference => [ sm'.(++#) path (sm'.(++#) ": " difference) ]
            | None => []
        | _ => [ sm'.(++#) path ": not one root element" ]
    inl failures = listm.concat (listm.map check documents)
    inl _ =
        match failures with
        | first :: _ =>
            inl count = sm'.obj_to_string (listm.length failures : i32)
            inl message = sm'.(++#) " real documents do not read back unchanged; first: " first
            failwith (sm'.(++#) count message)
        | [] => ()
    inl text = file_system.read_all_text (generated_fiscal_runtime.sample_path "generated_cii_d16b_example.xml")
    let rec runs (left : i32) (parses : list i64) (writes : list i64) (bytes : i64) : list i64 * list i64 * i64 =
        if left = 0i32 then parses, writes, bytes
        else
            inl watch = date_time.stopwatch ()
            date_time.stopwatch_start watch
            inl start = date_time.stopwatch_elapsed_microseconds watch
            match xml.read_xml text with
            | node :: [] =>
                inl parsed = xml_codec.expect_decoded (x_cross_industry_invoice_type_of_xml node)
                inl parsed_at = date_time.stopwatch_elapsed_microseconds watch
                inl written = xml.write_node (x_cross_industry_invoice_type_to_xml "CrossIndustryInvoice" parsed)
                inl written_at = date_time.stopwatch_elapsed_microseconds watch
                inl parses = generated_fiscal_runtime.insert_run (parsed_at - start) parses
                inl writes = generated_fiscal_runtime.insert_run (written_at - parsed_at) writes
                runs (left - 1i32) parses writes (bytes + sm'.length written)
            | _ => failwith "one CrossIndustryInvoice element"
    inl _ = runs (dyn 5i32) [] [] 0i64
    inl parses, writes, bytes = runs (dyn 31i32) [] [] 0i64
    inl row = sm'.(++#) "generated_cii_d16b parse_us " (generated_fiscal_runtime.median parses)
    inl row = sm'.(++#) row (sm'.(++#) " write_us " (generated_fiscal_runtime.median writes))
    inl row = sm'.(++#) row (sm'.(++#) " runs 31 bytes " (sm'.obj_to_string bytes))
    console.write_line row
    match xml.read_xml text with
    | node :: [] =>
        inl parsed = xml_codec.expect_decoded (x_cross_industry_invoice_type_of_xml node)
        inl document =
            xml.element
                "CrossIndustryInvoice"
                (
                    ("xmlns", "urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100")
                    :: x_cross_industry_invoice_type_attributes parsed
                )
                (x_cross_industry_invoice_type_children parsed)
        inl folder = generated_fiscal_runtime.sample_path "../target/bench"
        match file_system.directory_create_all folder with
        | Ok _ =>
            file_system.write_all_text
                (sm'.(++#) folder "/ours-generated_cii_d16b_example.xml")
                (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
        | Error _ => failwith "cannot create target/bench"
    | _ => failwith "one CrossIndustryInvoice element"

///> rust
test generated_cii_d16b_keeps_raw_strings_out fails "Unification failure" =
    x_linear_unit_measure_unit_code_content_type_to_string "raw"
