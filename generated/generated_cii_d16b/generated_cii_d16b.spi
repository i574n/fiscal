and let x_formatted_date_time_type_children (x : x_formatted_date_time_type) : list xml.xml_node =
    inl nodes forall r. (f : x_formatted_date_time_type_field r) (v : r) : list xml.xml_node =
        match f with
        | FormattedDateTimeType_field_DateTimeString =>
            [ x_formatted_date_time_type_date_time_string_to_xml "DateTimeString" v ]
    inl rec walk (fields : list (exists r. x_formatted_date_time_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_formatted_date_time_type_get f x)) (walk rest)
        | [] => []
    walk [ exists FormattedDateTimeType_field_DateTimeString ]

and let x_formatted_date_time_type_attributes (x : x_formatted_date_time_type) : list (string * string) = []

