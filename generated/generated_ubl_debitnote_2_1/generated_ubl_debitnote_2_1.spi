        exists UtilityItemType_field_cbc_CurrentChargeTypeCode
        exists UtilityItemType_field_cbc_OneTimeChargeType
        exists UtilityItemType_field_cbc_OneTimeChargeTypeCode
        exists UtilityItemType_field_cac_TaxCategory
        exists UtilityItemType_field_cac_Contract
