            xml.option_list (optionm.map (fun v => x_pack_quantity_type_to_xml "cbc:PackQuantity" v) v)
        | UtilityItemType_field_cbc_PackSizeNumeric =>
            xml.option_list (optionm.map (fun v => x_pack_size_numeric_type_to_xml "cbc:PackSizeNumeric" v) v)
        | UtilityItemType_field_cbc_ConsumptionType =>
            xml.option_list (optionm.map (fun v => x_consumption_type_type_to_xml "cbc:ConsumptionType" v) v)
        | UtilityItemType_field_cbc_ConsumptionTypeCode =>
            xml.option_list (optionm.map (fun v => x_consumption_type_code_type_to_xml "cbc:ConsumptionTypeCode" v) v)
        | UtilityItemType_field_cbc_CurrentChargeType =>
            xml.option_list (optionm.map (fun v => x_current_charge_type_type_to_xml "cbc:CurrentChargeType" v) v)
        | UtilityItemType_field_cbc_CurrentChargeTypeCode =>
            xml.option_list (
                optionm.map (fun v => x_current_charge_type_code_type_to_xml "cbc:CurrentChargeTypeCode" v) v
            )
        | UtilityItemType_field_cbc_OneTimeChargeType =>
            xml.option_list (optionm.map (fun v => x_one_time_charge_type_type_to_xml "cbc:OneTimeChargeType" v) v)
        | UtilityItemType_field_cbc_OneTimeChargeTypeCode =>
            xml.option_list (
                optionm.map (fun v => x_one_time_charge_type_code_type_to_xml "cbc:OneTimeChargeTypeCode" v) v
            )
        | UtilityItemType_field_cac_TaxCategory =>
            xml.option_list (optionm.map (fun v => x_tax_category_type_to_xml "cac:TaxCategory" v) v)
        | UtilityItemType_field_cac_Contract =>
            xml.option_list (optionm.map (fun v => x_contract_type_to_xml "cac:Contract" v) v)
    inl rec walk (fields : list (exists r. x_utility_item_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_utility_item_type_get f x')) (walk rest)
        | [] => []
    walk [
        exists UtilityItemType_field_cbc_ID
        exists UtilityItemType_field_cbc_SubscriberID
        exists UtilityItemType_field_cbc_SubscriberType
        exists UtilityItemType_field_cbc_SubscriberTypeCode
        exists UtilityItemType_field_cbc_Description
        exists UtilityItemType_field_cbc_PackQuantity
        exists UtilityItemType_field_cbc_PackSizeNumeric
        exists UtilityItemType_field_cbc_ConsumptionType
