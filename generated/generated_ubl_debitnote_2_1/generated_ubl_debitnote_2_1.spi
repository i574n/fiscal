and let x_common_aggregate_components_2_signature_type_children
    (x' : x_common_aggregate_components_2_signature_type)
    : list xml.xml_node
    =
    inl x = match x' with | Record_x_common_aggregate_components_2_signature_type r => r
    inl nodes forall r. (f : x_common_aggregate_components_2_signature_type_field r) (v : r) : list xml.xml_node =
        match f with
        | CommonAggregateComponents_2_SignatureType_field_cbc_ID => [ x_id_type_to_xml "cbc:ID" v ]
        | CommonAggregateComponents_2_SignatureType_field_cbc_Note =>
            listm.map (fun v => x_note_type_to_xml "cbc:Note" v) v
        | CommonAggregateComponents_2_SignatureType_field_cbc_ValidationDate =>
            xml.option_list (optionm.map (fun v => x_validation_date_type_to_xml "cbc:ValidationDate" v) v)
        | CommonAggregateComponents_2_SignatureType_field_cbc_ValidationTime =>
            xml.option_list (optionm.map (fun v => x_validation_time_type_to_xml "cbc:ValidationTime" v) v)
        | CommonAggregateComponents_2_SignatureType_field_cbc_ValidatorID =>
            xml.option_list (optionm.map (fun v => x_validator_id_type_to_xml "cbc:ValidatorID" v) v)
        | CommonAggregateComponents_2_SignatureType_field_cbc_CanonicalizationMethod =>
            xml.option_list (
                optionm.map
                    fun v =>
                        x_common_basic_components_2_canonicalization_method_type_to_xml "cbc:CanonicalizationMethod" v
                    v
            )
        | CommonAggregateComponents_2_SignatureType_field_cbc_SignatureMethod =>
            xml.option_list (
                optionm.map
                    fun v => x_common_basic_components_2_signature_method_type_to_xml "cbc:SignatureMethod" v
                    v
            )
        | CommonAggregateComponents_2_SignatureType_field_cac_SignatoryParty =>
            xml.option_list (optionm.map (fun v => x_party_type_to_xml "cac:SignatoryParty" v) v)
        | CommonAggregateComponents_2_SignatureType_field_cac_DigitalSignatureAttachment =>
            xml.option_list (optionm.map (fun v => x_attachment_type_to_xml "cac:DigitalSignatureAttachment" v) v)
        | CommonAggregateComponents_2_SignatureType_field_cac_OriginalDocumentReference =>
            xml.option_list (
                optionm.map (fun v => x_document_reference_type_to_xml "cac:OriginalDocumentReference" v) v
            )
    inl rec walk
        (fields : list (exists r. x_common_aggregate_components_2_signature_type_field r))
        : list xml.xml_node
        =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_common_aggregate_components_2_signature_type_get f x')) (walk rest)
        | [] => []
    walk [
        exists CommonAggregateComponents_2_SignatureType_field_cbc_ID
        exists CommonAggregateComponents_2_SignatureType_field_cbc_Note
        exists CommonAggregateComponents_2_SignatureType_field_cbc_ValidationDate
        exists CommonAggregateComponents_2_SignatureType_field_cbc_ValidationTime
