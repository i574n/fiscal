    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_generic_time_stamp_type_choice_include
    =
    if false then failwith "unreachable"
    elif xml.has_child "Include" children then
        GenericTimeStampType_choice_Include_Include (
            listm.map (fun c => x_include_type_of_xml c) (xml.children_named "Include" children)
        )
    elif xml.has_child "ReferenceInfo" children then
        GenericTimeStampType_choice_Include_ReferenceInfo (
            listm.map (fun c => x_reference_info_type_of_xml c) (xml.children_named "ReferenceInfo" children)
        )
    else
        GenericTimeStampType_choice_Include_Include (
            listm.map (fun c => x_include_type_of_xml c) (xml.children_named "Include" children)
        )

