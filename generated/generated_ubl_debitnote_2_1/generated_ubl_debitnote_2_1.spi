    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_generic_time_stamp_type
    =
    {
        choice_include =
            if xml.has_any_child [ "Include"; "ReferenceInfo" ] children
            then Some (x_generic_time_stamp_type_choice_include_of_children attributes children)
            else None
        canonicalization_method =
            optionm.map
                fun c => x_common_basic_components_2_canonicalization_method_type_of_xml c
                (xml.first_child "ds:CanonicalizationMethod" children)
        choice_encapsulated_time_stamp =
            listm.map
                fun c => x_generic_time_stamp_type_choice_encapsulated_time_stamp_of_children attributes [ c ]
                (xml.claimed_children [ "EncapsulatedTimeStamp"; "XMLTimeStamp" ] children)
        id = xml.attribute_of "Id" attributes
    }

