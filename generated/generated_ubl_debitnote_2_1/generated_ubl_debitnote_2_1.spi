and let x_utility_item_type_children (x' : x_utility_item_type) : list xml.xml_node =
    inl x = match x' with | Record_x_utility_item_type r => r
    inl nodes forall r. (f : x_utility_item_type_field r) (v : r) : list xml.xml_node =
        match f with
        | UtilityItemType_field_cbc_ID => [ x_id_type_to_xml "cbc:ID" v ]
        | UtilityItemType_field_cbc_SubscriberID =>
            xml.option_list (optionm.map (fun v => x_subscriber_id_type_to_xml "cbc:SubscriberID" v) v)
        | UtilityItemType_field_cbc_SubscriberType =>
