and let x_debit_note_type_children (x' : x_debit_note_type) : list xml.xml_node =
    inl x = match x' with | Record_x_debit_note_type r => r
    inl nodes forall r. (f : x_debit_note_type_field r) (v : r) : list xml.xml_node =
        match f with
        | DebitNoteType_field_ext_UBLExtensions =>
            xml.option_list (optionm.map (fun v => x_ubl_extensions_type_to_xml "ext:UBLExtensions" v) v)
        | DebitNoteType_field_cbc_UBLVersionID =>
            xml.option_list (optionm.map (fun v => x_ubl_version_id_type_to_xml "cbc:UBLVersionID" v) v)
        | DebitNoteType_field_cbc_CustomizationID =>
            xml.option_list (optionm.map (fun v => x_customization_id_type_to_xml "cbc:CustomizationID" v) v)
        | DebitNoteType_field_cbc_ProfileID =>
            xml.option_list (optionm.map (fun v => x_profile_id_type_to_xml "cbc:ProfileID" v) v)
        | DebitNoteType_field_cbc_ProfileExecutionID =>
            xml.option_list (optionm.map (fun v => x_profile_execution_id_type_to_xml "cbc:ProfileExecutionID" v) v)
        | DebitNoteType_field_cbc_ID => [ x_id_type_to_xml "cbc:ID" v ]
        | DebitNoteType_field_cbc_CopyIndicator =>
            xml.option_list (optionm.map (fun v => x_copy_indicator_type_to_xml "cbc:CopyIndicator" v) v)
        | DebitNoteType_field_cbc_UUID => xml.option_list (optionm.map (fun v => x_uuid_type_to_xml "cbc:UUID" v) v)
        | DebitNoteType_field_cbc_IssueDate => [ x_issue_date_type_to_xml "cbc:IssueDate" v ]
        | DebitNoteType_field_cbc_IssueTime =>
            xml.option_list (optionm.map (fun v => x_issue_time_type_to_xml "cbc:IssueTime" v) v)
        | DebitNoteType_field_cbc_Note => listm.map (fun v => x_note_type_to_xml "cbc:Note" v) v
        | DebitNoteType_field_cbc_TaxPointDate =>
            xml.option_list (optionm.map (fun v => x_tax_point_date_type_to_xml "cbc:TaxPointDate" v) v)
        | DebitNoteType_field_cbc_DocumentCurrencyCode =>
            xml.option_list (optionm.map (fun v => x_document_currency_code_type_to_xml "cbc:DocumentCurrencyCode" v) v)
        | DebitNoteType_field_cbc_TaxCurrencyCode =>
            xml.option_list (optionm.map (fun v => x_tax_currency_code_type_to_xml "cbc:TaxCurrencyCode" v) v)
        | DebitNoteType_field_cbc_PricingCurrencyCode =>
            xml.option_list (optionm.map (fun v => x_pricing_currency_code_type_to_xml "cbc:PricingCurrencyCode" v) v)
        | DebitNoteType_field_cbc_PaymentCurrencyCode =>
            xml.option_list (optionm.map (fun v => x_payment_currency_code_type_to_xml "cbc:PaymentCurrencyCode" v) v)
        | DebitNoteType_field_cbc_PaymentAlternativeCurrencyCode =>
            xml.option_list (
                optionm.map
                    fun v => x_payment_alternative_currency_code_type_to_xml "cbc:PaymentAlternativeCurrencyCode" v
                    v
            )
        | DebitNoteType_field_cbc_AccountingCostCode =>
            xml.option_list (optionm.map (fun v => x_accounting_cost_code_type_to_xml "cbc:AccountingCostCode" v) v)
        | DebitNoteType_field_cbc_AccountingCost =>
            xml.option_list (optionm.map (fun v => x_accounting_cost_type_to_xml "cbc:AccountingCost" v) v)
        | DebitNoteType_field_cbc_LineCountNumeric =>
            xml.option_list (optionm.map (fun v => x_line_count_numeric_type_to_xml "cbc:LineCountNumeric" v) v)
        | DebitNoteType_field_cac_InvoicePeriod => listm.map (fun v => x_period_type_to_xml "cac:InvoicePeriod" v) v
        | DebitNoteType_field_cac_DiscrepancyResponse =>
            listm.map (fun v => x_response_type_to_xml "cac:DiscrepancyResponse" v) v
        | DebitNoteType_field_cac_OrderReference =>
            xml.option_list (optionm.map (fun v => x_order_reference_type_to_xml "cac:OrderReference" v) v)
        | DebitNoteType_field_cac_BillingReference =>
            listm.map (fun v => x_billing_reference_type_to_xml "cac:BillingReference" v) v
        | DebitNoteType_field_cac_DespatchDocumentReference =>
            listm.map (fun v => x_document_reference_type_to_xml "cac:DespatchDocumentReference" v) v
        | DebitNoteType_field_cac_ReceiptDocumentReference =>
            listm.map (fun v => x_document_reference_type_to_xml "cac:ReceiptDocumentReference" v) v
        | DebitNoteType_field_cac_StatementDocumentReference =>
            listm.map (fun v => x_document_reference_type_to_xml "cac:StatementDocumentReference" v) v
        | DebitNoteType_field_cac_ContractDocumentReference =>
            listm.map (fun v => x_document_reference_type_to_xml "cac:ContractDocumentReference" v) v
        | DebitNoteType_field_cac_AdditionalDocumentReference =>
            listm.map (fun v => x_document_reference_type_to_xml "cac:AdditionalDocumentReference" v) v
        | DebitNoteType_field_cac_Signature =>
            listm.map (fun v => x_common_aggregate_components_2_signature_type_to_xml "cac:Signature" v) v
        | DebitNoteType_field_cac_AccountingSupplierParty =>
            [ x_supplier_party_type_to_xml "cac:AccountingSupplierParty" v ]
        | DebitNoteType_field_cac_AccountingCustomerParty =>
            [ x_customer_party_type_to_xml "cac:AccountingCustomerParty" v ]
        | DebitNoteType_field_cac_PayeeParty =>
            xml.option_list (optionm.map (fun v => x_party_type_to_xml "cac:PayeeParty" v) v)
        | DebitNoteType_field_cac_BuyerCustomerParty =>
            xml.option_list (optionm.map (fun v => x_customer_party_type_to_xml "cac:BuyerCustomerParty" v) v)
        | DebitNoteType_field_cac_SellerSupplierParty =>
            xml.option_list (optionm.map (fun v => x_supplier_party_type_to_xml "cac:SellerSupplierParty" v) v)
        | DebitNoteType_field_cac_TaxRepresentativeParty =>
            xml.option_list (optionm.map (fun v => x_party_type_to_xml "cac:TaxRepresentativeParty" v) v)
        | DebitNoteType_field_cac_PrepaidPayment => listm.map (fun v => x_payment_type_to_xml "cac:PrepaidPayment" v) v
        | DebitNoteType_field_cac_AllowanceCharge =>
            listm.map (fun v => x_allowance_charge_type_to_xml "cac:AllowanceCharge" v) v
        | DebitNoteType_field_cac_Delivery => listm.map (fun v => x_delivery_type_to_xml "cac:Delivery" v) v
        | DebitNoteType_field_cac_DeliveryTerms =>
            listm.map (fun v => x_delivery_terms_type_to_xml "cac:DeliveryTerms" v) v
        | DebitNoteType_field_cac_PaymentMeans =>
            listm.map (fun v => x_payment_means_type_to_xml "cac:PaymentMeans" v) v
        | DebitNoteType_field_cac_PaymentTerms =>
            listm.map (fun v => x_payment_terms_type_to_xml "cac:PaymentTerms" v) v
        | DebitNoteType_field_cac_TaxExchangeRate =>
            xml.option_list (optionm.map (fun v => x_exchange_rate_type_to_xml "cac:TaxExchangeRate" v) v)
        | DebitNoteType_field_cac_PricingExchangeRate =>
            xml.option_list (optionm.map (fun v => x_exchange_rate_type_to_xml "cac:PricingExchangeRate" v) v)
        | DebitNoteType_field_cac_PaymentExchangeRate =>
            xml.option_list (optionm.map (fun v => x_exchange_rate_type_to_xml "cac:PaymentExchangeRate" v) v)
        | DebitNoteType_field_cac_PaymentAlternativeExchangeRate =>
            xml.option_list (
                optionm.map (fun v => x_exchange_rate_type_to_xml "cac:PaymentAlternativeExchangeRate" v) v
            )
        | DebitNoteType_field_cac_TaxTotal => listm.map (fun v => x_tax_total_type_to_xml "cac:TaxTotal" v) v
        | DebitNoteType_field_cac_RequestedMonetaryTotal =>
            [ x_monetary_total_type_to_xml "cac:RequestedMonetaryTotal" v ]
        | DebitNoteType_field_cac_DebitNoteLine =>
            listm.map (fun v => x_debit_note_line_type_to_xml "cac:DebitNoteLine" v) v
    inl rec walk (fields : list (exists r. x_debit_note_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_debit_note_type_get f x')) (walk rest)
        | [] => []
    walk [
        exists DebitNoteType_field_ext_UBLExtensions
        exists DebitNoteType_field_cbc_UBLVersionID
        exists DebitNoteType_field_cbc_CustomizationID
        exists DebitNoteType_field_cbc_ProfileID
        exists DebitNoteType_field_cbc_ProfileExecutionID
        exists DebitNoteType_field_cbc_ID
        exists DebitNoteType_field_cbc_CopyIndicator
        exists DebitNoteType_field_cbc_UUID
        exists DebitNoteType_field_cbc_IssueDate
        exists DebitNoteType_field_cbc_IssueTime
        exists DebitNoteType_field_cbc_Note
        exists DebitNoteType_field_cbc_TaxPointDate
        exists DebitNoteType_field_cbc_DocumentCurrencyCode
        exists DebitNoteType_field_cbc_TaxCurrencyCode
        exists DebitNoteType_field_cbc_PricingCurrencyCode
        exists DebitNoteType_field_cbc_PaymentCurrencyCode
        exists DebitNoteType_field_cbc_PaymentAlternativeCurrencyCode
        exists DebitNoteType_field_cbc_AccountingCostCode
        exists DebitNoteType_field_cbc_AccountingCost
        exists DebitNoteType_field_cbc_LineCountNumeric
        exists DebitNoteType_field_cac_InvoicePeriod
        exists DebitNoteType_field_cac_DiscrepancyResponse
        exists DebitNoteType_field_cac_OrderReference
        exists DebitNoteType_field_cac_BillingReference
        exists DebitNoteType_field_cac_DespatchDocumentReference
        exists DebitNoteType_field_cac_ReceiptDocumentReference
        exists DebitNoteType_field_cac_StatementDocumentReference
        exists DebitNoteType_field_cac_ContractDocumentReference
        exists DebitNoteType_field_cac_AdditionalDocumentReference
        exists DebitNoteType_field_cac_Signature
        exists DebitNoteType_field_cac_AccountingSupplierParty
        exists DebitNoteType_field_cac_AccountingCustomerParty
        exists DebitNoteType_field_cac_PayeeParty
        exists DebitNoteType_field_cac_BuyerCustomerParty
        exists DebitNoteType_field_cac_SellerSupplierParty
        exists DebitNoteType_field_cac_TaxRepresentativeParty
        exists DebitNoteType_field_cac_PrepaidPayment
        exists DebitNoteType_field_cac_AllowanceCharge
        exists DebitNoteType_field_cac_Delivery
