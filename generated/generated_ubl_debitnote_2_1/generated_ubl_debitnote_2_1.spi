    inl rec walk (fields : list (exists r. x_extension_content_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_extension_content_type_get f x)) (walk rest)
        | [] => []
    walk [ exists ExtensionContentType_field_any ]

