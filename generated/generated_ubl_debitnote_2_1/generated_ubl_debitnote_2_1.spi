and let x_ubl_extensions_type_children (x : x_ubl_extensions_type) : list xml.xml_node =
    inl nodes forall r. (f : x_ubl_extensions_type_field r) (v : r) : list xml.xml_node =
        match f with
        | UBLExtensionsType_field_UBLExtension => listm.map (fun v => x_ubl_extension_type_to_xml "UBLExtension" v) v
    inl rec walk (fields : list (exists r. x_ubl_extensions_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_ubl_extensions_type_get f x)) (walk rest)
        | [] => []
    walk [ exists UBLExtensionsType_field_UBLExtension ]

