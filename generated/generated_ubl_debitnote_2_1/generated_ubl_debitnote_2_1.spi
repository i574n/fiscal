            (fun c => x_x_ad_es_time_stamp_type_of_xml c) (xml.required_child "RefsOnlyTimeStamp" children)
        )
    elif xml.has_child "CertificateValues" children then
        UnsignedSignaturePropertiesType_choice_CounterSignature_CertificateValues (
