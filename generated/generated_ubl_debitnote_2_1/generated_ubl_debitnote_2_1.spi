and let x_ubl_extension_type_children (x : x_ubl_extension_type) : list xml.xml_node =
    inl nodes forall r. (f : x_ubl_extension_type_field r) (v : r) : list xml.xml_node =
        match f with
        | UBLExtensionType_field_cbc_ID => xml.option_list (optionm.map (fun v => x_id_type_to_xml "cbc:ID" v) v)
        | UBLExtensionType_field_cbc_Name =>
            xml.option_list (optionm.map (fun v => x_common_basic_components_2_name_type_to_xml "cbc:Name" v) v)
        | UBLExtensionType_field_ExtensionAgencyID =>
            xml.option_list (optionm.map (fun v => x_extension_agency_id_type_to_xml "ExtensionAgencyID" v) v)
        | UBLExtensionType_field_ExtensionAgencyName =>
            xml.option_list (optionm.map (fun v => x_extension_agency_name_type_to_xml "ExtensionAgencyName" v) v)
        | UBLExtensionType_field_ExtensionVersionID =>
            xml.option_list (optionm.map (fun v => x_extension_version_id_type_to_xml "ExtensionVersionID" v) v)
        | UBLExtensionType_field_ExtensionAgencyURI =>
