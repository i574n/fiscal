        | UBLExtensionType_field_ExtensionURI =>
            xml.option_list (optionm.map (fun v => x_extension_uri_type_to_xml "ExtensionURI" v) v)
        | UBLExtensionType_field_ExtensionReasonCode =>
            xml.option_list (optionm.map (fun v => x_extension_reason_code_type_to_xml "ExtensionReasonCode" v) v)
        | UBLExtensionType_field_ExtensionReason =>
            xml.option_list (optionm.map (fun v => x_extension_reason_type_to_xml "ExtensionReason" v) v)
        | UBLExtensionType_field_ExtensionContent => [ x_extension_content_type_to_xml "ExtensionContent" v ]
    inl rec walk (fields : list (exists r. x_ubl_extension_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_ubl_extension_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists UBLExtensionType_field_cbc_ID
        exists UBLExtensionType_field_cbc_Name
        exists UBLExtensionType_field_ExtensionAgencyID
        exists UBLExtensionType_field_ExtensionAgencyName
        exists UBLExtensionType_field_ExtensionVersionID
