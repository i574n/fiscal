inl sample_path (name : string) : string =
    inl from_env = env.get_environment_variable "FISCAL_ROOT"
    inl root =
        if from_env <> "" then from_env
        else
            inl here = file_system.get_current_directory ()
            match here |> file_system.find_parent file_system.File "src/generator.spi" with
            | Ok dir => dir
            | Error message => failwith message
    sm'.(++#) (sm'.(++#) root "/samples/") name
///> rust
test generated_ubl_debitnote_2_1_writes_its_example =
    inl example = x_debit_note_type_example 0i32
    inl document =
        xml.element
            "DebitNote"
            (
                ("xmlns", "urn:oasis:names:specification:ubl:schema:xsd:DebitNote-2")
                :: ("xmlns:cac", "urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2")
                :: ("xmlns:cbc", "urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2")
                :: ("xmlns:ext", "urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2")
                :: x_debit_note_type_attributes example
            )
            (x_debit_note_type_children example)
    file_system.write_all_text
        (sample_path "generated_ubl_debitnote_2_1_example.xml")
        (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
    inl documents =
        [
            "deps/corpus/co/dian/Caja de herramientas FE_V19_(v2026)/Ejemplificaciones/XMLs de ejemplo/DebitNote "
            ^^ "impuestos salidables.xml"
            "deps/corpus/co/dian/Caja de herramientas FE_V19_(v2026)/Ejemplificaciones/XMLs de ejemplo/DebitNote.xml"
            "deps/corpus/co/dian/Caja de herramientas FE_V19_(v2026)/Ejemplificaciones/XMLs de "
            ^^ "ejemplo/Ejemplificacion nota debito sin referencia a factura.xml"
            "deps/corpus/pe/sunat-homologacion/Group1Test/notaDeDebitoDeFactura2.xml"
            "deps/corpus/pe/sunat-homologacion/Group1Test/notaDeDebitoDeFactura3.xml"
            "deps/corpus/pe/sunat-homologacion/Group1Test/notaDeDebitoDeFactura4.xml"
            "deps/corpus/pe/sunat-homologacion/Group2ExoneradoTest/notaDeDebitoDeFactura1.xml"
            "deps/corpus/pe/sunat-homologacion/Group2ExoneradoTest/notaDeDebitoDeFactura3.xml"
            "deps/corpus/pe/sunat-homologacion/Group2ExoneradoTest/notaDeDebitoDeFactura5.xml"
            "deps/corpus/pe/sunat-homologacion/Group2InafectoTest/notaDeDebitoDeFactura1.xml"
            "deps/corpus/pe/sunat-homologacion/Group2InafectoTest/notaDeDebitoDeFactura3.xml"
            "deps/corpus/pe/sunat-homologacion/Group2InafectoTest/notaDeDebitoDeFactura5.xml"
            "deps/corpus/pe/sunat-homologacion/Group4Test/notaDeDebitoDeFactura2.xml"
            "deps/corpus/pe/sunat-homologacion/Group4Test/notaDeDebitoDeFactura3.xml"
            "deps/corpus/pe/sunat-homologacion/Group4Test/notaDeDebitoDeFactura5.xml"
            "deps/corpus/pe/sunat-homologacion/Group5Test/notaDeDebitoDeFactura2.xml"
            "deps/corpus/pe/sunat-homologacion/Group6Test/notaDeDebitoDeFactura1.xml"
            "deps/corpus/pe/sunat-homologacion/Group7Test/notaDeDebitoDeFactura2.xml"
        ]
    inl check (path : string) : list string =
        inl text = file_system.read_all_text (sample_path (sm'.(++#) "../" path))
        match xml.read_xml text with
        | node :: [] =>
            match xml.first_difference node (x_debit_note_type_to_xml "DebitNote" (x_debit_note_type_of_xml node)) with
            | Some difference => [ sm'.(++#) path (sm'.(++#) ": " difference) ]
            | None => []
        | _ => [ sm'.(++#) path ": not one root element" ]
    inl failures = listm.concat (listm.map check documents)
    inl _ =
        match failures with
        | first :: _ =>
            inl count = sm'.obj_to_string (listm.length failures : i32)
            inl message = sm'.(++#) " real documents do not read back unchanged; first: " first
            failwith (sm'.(++#) count message)
        | [] => ()
    inl text = file_system.read_all_text (sample_path "generated_ubl_debitnote_2_1_example.xml")
    let rec insert (x : i64) (xs : list i64) : list i64 =
        match xs with
        | y :: rest => if x <= y then x :: xs else y :: insert x rest
        | [] => x :: []
    let rec nth (i : i32) (xs : list i64) : i64 =
        match xs with
        | y :: rest => if i = 0i32 then y else nth (i - 1i32) rest
        | [] => -1i64
    let rec runs (left : i32) (parses : list i64) (writes : list i64) (bytes : i64) : list i64 * list i64 * i64 =
        if left = 0i32 then parses, writes, bytes
        else
            inl watch = date_time.stopwatch ()
            date_time.stopwatch_start watch
            inl start = date_time.stopwatch_elapsed_microseconds watch
            match xml.read_xml text with
            | node :: [] =>
                inl parsed = x_debit_note_type_of_xml node
                inl parsed_at = date_time.stopwatch_elapsed_microseconds watch
                inl written = xml.write_node (x_debit_note_type_to_xml "DebitNote" parsed)
                inl written_at = date_time.stopwatch_elapsed_microseconds watch
                inl parses = insert (parsed_at - start) parses
                inl writes = insert (written_at - parsed_at) writes
                runs (left - 1i32) parses writes (bytes + sm'.length written)
            | _ => failwith "one DebitNote element"
    inl _ = runs (dyn 5i32) [] [] 0i64
    inl parses, writes, bytes = runs (dyn 31i32) [] [] 0i64
    inl cell (x : i64) : string = sm'.obj_to_string x
    inl row = sm'.(++#) "generated_ubl_debitnote_2_1 parse_us " (cell (nth 15i32 parses))
    inl row = sm'.(++#) row (sm'.(++#) " write_us " (cell (nth 15i32 writes)))
    inl row = sm'.(++#) row (sm'.(++#) " runs 31 bytes " (cell bytes))
    console.write_line row
    match xml.read_xml text with
    | node :: [] =>
        inl parsed = x_debit_note_type_of_xml node
        inl document =
            xml.element
                "DebitNote"
                (
                    ("xmlns", "urn:oasis:names:specification:ubl:schema:xsd:DebitNote-2")
                    :: ("xmlns:cac", "urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2")
                    :: ("xmlns:cbc", "urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2")
                    :: ("xmlns:ext", "urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2")
                    :: x_debit_note_type_attributes parsed
                )
                (x_debit_note_type_children parsed)
        inl folder = sample_path "../target/bench"
        match file_system.create_dir_all folder |> resultm.unbox with
        | Ok _ =>
            file_system.write_all_text
                (sm'.(++#) folder "/ours-generated_ubl_debitnote_2_1_example.xml")
                (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
        | Error _ => failwith "cannot create target/bench"
    | _ => failwith "one DebitNote element"
