        )
    elif xml.has_child "SigAndRefsTimeStamp" children then
        UnsignedSignaturePropertiesType_choice_CounterSignature_SigAndRefsTimeStamp (
            (fun c => x_x_ad_es_time_stamp_type_of_xml c) (xml.required_child "SigAndRefsTimeStamp" children)
        )
    elif xml.has_child "RefsOnlyTimeStamp" children then
