and let x_generic_time_stamp_type_choice_encapsulated_time_stamp_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_generic_time_stamp_type_choice_encapsulated_time_stamp
    =
    if false then failwith "unreachable"
    elif xml.has_child "EncapsulatedTimeStamp" children then
        GenericTimeStampType_choice_EncapsulatedTimeStamp_EncapsulatedTimeStamp (
            (fun c => x_encapsulated_pki_data_type_of_xml c) (xml.required_child "EncapsulatedTimeStamp" children)
        )
    elif xml.has_child "XMLTimeStamp" children then
        GenericTimeStampType_choice_EncapsulatedTimeStamp_XMLTimeStamp (
            (fun c => x_any_type_of_xml c) (xml.required_child "XMLTimeStamp" children)
        )
    else failwith "x_generic_time_stamp_type_choice_encapsulated_time_stamp: no alternative present"

