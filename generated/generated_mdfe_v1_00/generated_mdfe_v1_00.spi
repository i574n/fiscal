let rec x_tmd_fe_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tmd_fe s
    =
    {
        inf_md_fe = (fun c => x_tmd_fe_inf_md_fe_of_xml c) (xml.required_child "infMDFe" children)
        signature =
            staged_of witness fun () =>
                (fun c => x_signature_type_of_xml c) (xml.required_child "ds:Signature" children)
    }

and let x_tmd_fe_of_xml forall s. (witness : stage s) (c : xml.xml_node) : x_tmd_fe s =
    x_tmd_fe_of_children witness (xml.element_attributes c) (xml.element_children c)

and let x_tmd_fe_inf_md_fe_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tmd_fe_inf_md_fe
    =
    {
        ide = (fun c => x_tmd_fe_inf_md_fe_ide_of_xml c) (xml.required_child "ide" children)
        emit = (fun c => x_tmd_fe_inf_md_fe_emit_of_xml c) (xml.required_child "emit" children)
        inf_modal = (fun c => x_tmd_fe_inf_md_fe_inf_modal_of_xml c) (xml.required_child "infModal" children)
        inf_doc = (fun c => x_tmd_fe_inf_md_fe_inf_doc_of_xml c) (xml.required_child "infDoc" children)
        tot = (fun c => x_tmd_fe_inf_md_fe_tot_of_xml c) (xml.required_child "tot" children)
        lacres = listm.map (fun c => x_tmd_fe_inf_md_fe_lacres_of_xml c) (xml.children_named "lacres" children)
        aut_xml = listm.map (fun c => x_tmd_fe_inf_md_fe_aut_xml_of_xml c) (xml.children_named "autXML" children)
        inf_adic = optionm.map (fun c => x_tmd_fe_inf_md_fe_inf_adic_of_xml c) (xml.first_child "infAdic" children)
        versao = xml.required_value "x_t_ver_m_de" (x_t_ver_m_de_of_string (xml.required_attribute "versao" attributes))
        id =
            xml.required_value
                "x_tmd_fe_inf_md_fe_id"
                (x_tmd_fe_inf_md_fe_id_of_string (xml.required_attribute "Id" attributes))
    }

and let x_tmd_fe_inf_md_fe_of_xml (c : xml.xml_node) : x_tmd_fe_inf_md_fe =
    x_tmd_fe_inf_md_fe_of_children (xml.element_attributes c) (xml.element_children c)

and let x_tmd_fe_inf_md_fe_inf_adic_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tmd_fe_inf_md_fe_inf_adic
    =
    {
        inf_ad_fisco =
            optionm.map
                fun c =>
                    xml.required_value "x_tmd_fe_inf_md_fe_inf_adic_inf_ad_fisco" (
                        x_tmd_fe_inf_md_fe_inf_adic_inf_ad_fisco_of_string (xml.text_in (xml.element_children c)))
                (xml.first_child "infAdFisco" children)
        inf_cpl =
            optionm.map
                fun c =>
                    xml.required_value "x_tmd_fe_inf_md_fe_inf_adic_inf_cpl" (
                        x_tmd_fe_inf_md_fe_inf_adic_inf_cpl_of_string (xml.text_in (xml.element_children c)))
                (xml.first_child "infCpl" children)
    }

and let x_tmd_fe_inf_md_fe_inf_adic_of_xml (c : xml.xml_node) : x_tmd_fe_inf_md_fe_inf_adic =
    x_tmd_fe_inf_md_fe_inf_adic_of_children (xml.element_attributes c) (xml.element_children c)

and let x_tmd_fe_inf_md_fe_aut_xml_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tmd_fe_inf_md_fe_aut_xml
    =
    {
        choice_cnpj = x_tmd_fe_inf_md_fe_aut_xml_choice_cnpj_of_children attributes children
    }

and let x_tmd_fe_inf_md_fe_aut_xml_of_xml (c : xml.xml_node) : x_tmd_fe_inf_md_fe_aut_xml =
    x_tmd_fe_inf_md_fe_aut_xml_of_children (xml.element_attributes c) (xml.element_children c)

and let x_tmd_fe_inf_md_fe_aut_xml_choice_cnpj_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tmd_fe_inf_md_fe_aut_xml_choice_cnpj
    =
    if false then failwith "unreachable"
    elif xml.has_child "CNPJ" children then
        TMDFe_infMDFe_autXML_choice_CNPJ_CNPJ (
            (fun c => xml.required_value "x_t_cnpj" (x_t_cnpj_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CNPJ" children)
        )
    elif xml.has_child "CPF" children then
        TMDFe_infMDFe_autXML_choice_CNPJ_CPF (
            (fun c => xml.required_value "x_t_cpf" (x_t_cpf_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CPF" children)
        )
    else failwith "x_tmd_fe_inf_md_fe_aut_xml_choice_cnpj: no alternative present"

