        | TMDFe_infMDFe_field_infDoc => [ x_tmd_fe_inf_md_fe_inf_doc_to_xml "infDoc" v ]
        | TMDFe_infMDFe_field_tot => [ x_tmd_fe_inf_md_fe_tot_to_xml "tot" v ]
        | TMDFe_infMDFe_field_lacres => listm.map (fun v => x_tmd_fe_inf_md_fe_lacres_to_xml "lacres" v) v
        | TMDFe_infMDFe_field_autXML => listm.map (fun v => x_tmd_fe_inf_md_fe_aut_xml_to_xml "autXML" v) v
        | TMDFe_infMDFe_field_infAdic =>
            xml.option_list (optionm.map (fun v => x_tmd_fe_inf_md_fe_inf_adic_to_xml "infAdic" v) v)
    inl rec walk (fields : list (exists r. x_tmd_fe_inf_md_fe_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tmd_fe_inf_md_fe_get f x)) (walk rest)
        | [] => []
    walk [
        exists TMDFe_infMDFe_field_ide
        exists TMDFe_infMDFe_field_emit
        exists TMDFe_infMDFe_field_infModal
        exists TMDFe_infMDFe_field_infDoc
        exists TMDFe_infMDFe_field_tot
        exists TMDFe_infMDFe_field_lacres
        exists TMDFe_infMDFe_field_autXML
        exists TMDFe_infMDFe_field_infAdic
    ]

and let x_tmd_fe_inf_md_fe_attributes (x : x_tmd_fe_inf_md_fe) : list (string * string) =
    listm.concat [ [ ("versao", to_text x.versao) ]; [ ("Id", to_text x.id) ] ]

and let x_tmd_fe_inf_md_fe_to_xml (name : string) (x : x_tmd_fe_inf_md_fe) : xml.xml_node =
    xml.element name (x_tmd_fe_inf_md_fe_attributes x) (x_tmd_fe_inf_md_fe_children x)

and let x_tmd_fe_inf_md_fe_example (k : i32) : x_tmd_fe_inf_md_fe =
    x_tmd_fe_inf_md_fe {
        ide = x_tmd_fe_inf_md_fe_ide_example k
        emit = x_tmd_fe_inf_md_fe_emit_example k
        inf_modal = x_tmd_fe_inf_md_fe_inf_modal_example k
        inf_doc = x_tmd_fe_inf_md_fe_inf_doc_example k
        tot = x_tmd_fe_inf_md_fe_tot_example k
        lacres = []
        aut_xml = []
        inf_adic = None
        versao = x_t_ver_m_de_example k
        id = x_tmd_fe_inf_md_fe_id_example k
    }


let rec x_tmd_fe_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_tmd_fe s) (list xml_codec.decode_error)
    =
    inl errors = []
    inl o_inf_md_fe, errors = xml_codec.read_required "infMDFe" x_tmd_fe_inf_md_fe_of_xml children errors
    inl o_signature, errors =
        staged_read witness
            fun errors => xml_codec.read_required "ds:Signature" x_signature_type_of_xml children errors
            errors
    xml_codec.decoded_by errors fun () =>
        x_tmd_fe { inf_md_fe = xml_codec.present o_inf_md_fe; signature = xml_codec.present o_signature }

and let x_tmd_fe_of_xml forall s.
    (witness : stage s) (c : xml.xml_node)
    : result (x_tmd_fe s) (list xml_codec.decode_error)
    =
    x_tmd_fe_of_children witness (xml.element_attributes c) (xml.element_children c)

and let x_tmd_fe_children forall s. (x : x_tmd_fe s) : list xml.xml_node =
    listm.concat [
        [ x_tmd_fe_inf_md_fe_to_xml "infMDFe" x.inf_md_fe ]
        staged_list (fun v => x_signature_type_to_xml "ds:Signature" v) x.signature
    ]

and let x_tmd_fe_attributes forall s. (x : x_tmd_fe s) : list (string * string) = []

and let x_tmd_fe_to_xml forall s. (name : string) (x : x_tmd_fe s) : xml.xml_node =
    xml.element name (x_tmd_fe_attributes x) (x_tmd_fe_children x)

and let x_tmd_fe_example (k : i32) : x_tmd_fe unsigned =
    x_tmd_fe {
        inf_md_fe = x_tmd_fe_inf_md_fe_example k
        signature = Pending "an unsigned example"
    }


let rec x_t_envi_md_fe_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_t_envi_md_fe s) (list xml_codec.decode_error)
    =
    inl errors = []
    inl o_id_lote, errors =
        xml_codec.read_required "idLote" (xml_codec.read_value x_t_id_lote_of_string) children errors
    inl o_md_fe, errors = xml_codec.read_required "MDFe" (x_tmd_fe_of_xml witness) children errors
    inl o_versao, errors = xml_codec.attribute_parsed x_t_ver_m_de_of_string "versao" attributes errors
    xml_codec.decoded_by errors fun () =>
        x_t_envi_md_fe {
            id_lote = xml_codec.present o_id_lote
            md_fe = xml_codec.present o_md_fe
            versao = xml_codec.present o_versao
        }

and let x_t_envi_md_fe_of_xml forall s.
    (witness : stage s) (c : xml.xml_node)
    : result (x_t_envi_md_fe s) (list xml_codec.decode_error)
    =
    x_t_envi_md_fe_of_children witness (xml.element_attributes c) (xml.element_children c)

and let x_t_envi_md_fe_children forall s. (x : x_t_envi_md_fe s) : list xml.xml_node =
    listm.concat [ [ text_node "idLote" x.id_lote ]; [ x_tmd_fe_to_xml "MDFe" x.md_fe ] ]

and let x_t_envi_md_fe_attributes forall s. (x : x_t_envi_md_fe s) : list (string * string) =
    [ ("versao", to_text x.versao) ]

and let x_t_envi_md_fe_to_xml forall s. (name : string) (x : x_t_envi_md_fe s) : xml.xml_node =
    xml.element name (x_t_envi_md_fe_attributes x) (x_t_envi_md_fe_children x)

and let x_t_envi_md_fe_example (k : i32) : x_t_envi_md_fe unsigned =
    x_t_envi_md_fe {
        id_lote = x_t_id_lote_example k
        md_fe = x_tmd_fe_example k
        versao = x_t_ver_m_de_example k
    }


