                (xml.first_child "qMDFe" children)
        v_carga =
            (fun c => xml.required_value "x_t_dec_1302" (x_t_dec_1302_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "vCarga" children)
        c_unid =
            (fun c => xml.required_value "x_tmd_fe_inf_md_fe_tot_c_unid" (x_tmd_fe_inf_md_fe_tot_c_unid_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "cUnid" children)
        q_carga =
            (fun c => xml.required_value "x_t_dec_1104" (x_t_dec_1104_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "qCarga" children)
    }

