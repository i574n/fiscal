    inl nodes forall r. (f : x_transforms_type_field r) (v : r) : list xml.xml_node =
        match f with
        | TransformsType_field_Transform => listm.map (fun v => x_transform_type_to_xml "Transform" v) v
    inl rec walk (fields : list (exists r. x_transforms_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_transforms_type_get f x)) (walk rest)
        | [] => []
    walk [ exists TransformsType_field_Transform ]

