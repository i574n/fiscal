and let x_signed_info_type_attributes (x : x_signed_info_type) : list (string * string) =
    xml.option_list (optionm.map (fun v => ("Id", v)) x.id)

and let x_signed_info_type_to_xml (name : string) (x : x_signed_info_type) : xml.xml_node =
    xml.element name (x_signed_info_type_attributes x) (x_signed_info_type_children x)

