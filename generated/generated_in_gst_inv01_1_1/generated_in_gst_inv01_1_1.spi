///- --package . --timeout 2400000
prototype to_text t : t -> string

inl text_node forall t {to_text}. (name : string) (v : t) : xml.xml_node =
    xml.element name [] (xml.text_children (to_text v))

inl optional_text_nodes forall t {to_text}. (name : string) (v : option t) : list xml.xml_node =
    xml.option_list (optionm.map (text_node name) v)

inl repeated_text_nodes forall t {to_text}. (name : string) (vs : list t) : list xml.xml_node =
    listm.map (text_node name) vs

nominal private x_gst_invoice_version = string

inl x_gst_invoice_version_is_valid (s : string) : bool = xml.code_point_count s <= 6 && xml.code_point_count s >= 1

inl x_gst_invoice_version_of_string (s : string) : option x_gst_invoice_version =
    if x_gst_invoice_version_is_valid s then Some (x_gst_invoice_version s) else None

inl x_gst_invoice_version_to_string (x : x_gst_invoice_version) : string = match x with x_gst_invoice_version s => s

instance to_text x_gst_invoice_version = fun x => x_gst_invoice_version_to_string x
inl x_gst_invoice_version_example (_ : i32) : x_gst_invoice_version = x_gst_invoice_version "1"

inl x_gst_invoice_version_example_text (k : i32) : string =
    x_gst_invoice_version_to_string (x_gst_invoice_version_example k)

