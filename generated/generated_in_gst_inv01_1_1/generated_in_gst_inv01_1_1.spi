let rec x_gst_invoice_of_children (attributes : list (string * string)) (children : list xml.xml_node) : x_gst_invoice =
    {
        version =
            (fun c => xml.required_value "x_gst_invoice_version" (x_gst_invoice_version_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "Version" children)
        irn =
            optionm.map
                fun c =>
                    xml.required_value "x_gst_invoice_irn" (x_gst_invoice_irn_of_string (xml.text_in (
                        xml.element_children c)))
                (xml.first_child "Irn" children)
        tran_dtls = (fun c => x_gst_invoice_tran_dtls_of_xml c) (xml.required_child "TranDtls" children)
        doc_dtls = (fun c => x_gst_invoice_doc_dtls_of_xml c) (xml.required_child "DocDtls" children)
        seller_dtls = (fun c => x_gst_invoice_seller_dtls_of_xml c) (xml.required_child "SellerDtls" children)
        buyer_dtls = (fun c => x_gst_invoice_buyer_dtls_of_xml c) (xml.required_child "BuyerDtls" children)
        disp_dtls = optionm.map (fun c => x_gst_invoice_disp_dtls_of_xml c) (xml.first_child "DispDtls" children)
        ship_dtls = optionm.map (fun c => x_gst_invoice_ship_dtls_of_xml c) (xml.first_child "ShipDtls" children)
        item_list = listm.map (fun c => x_gst_invoice_item_list_of_xml c) (xml.children_named "ItemList" children)
        val_dtls = (fun c => x_gst_invoice_val_dtls_of_xml c) (xml.required_child "ValDtls" children)
        pay_dtls = optionm.map (fun c => x_gst_invoice_pay_dtls_of_xml c) (xml.first_child "PayDtls" children)
        ref_dtls = optionm.map (fun c => x_gst_invoice_ref_dtls_of_xml c) (xml.first_child "RefDtls" children)
        addl_doc_dtls =
            listm.map (fun c => x_gst_invoice_addl_doc_dtls_of_xml c) (xml.children_named "AddlDocDtls" children)
        exp_dtls = optionm.map (fun c => x_gst_invoice_exp_dtls_of_xml c) (xml.first_child "ExpDtls" children)
        ewb_dtls = optionm.map (fun c => x_gst_invoice_ewb_dtls_of_xml c) (xml.first_child "EwbDtls" children)
    }

and let x_gst_invoice_of_xml (c : xml.xml_node) : x_gst_invoice =
    x_gst_invoice_of_children (xml.element_attributes c) (xml.element_children c)

