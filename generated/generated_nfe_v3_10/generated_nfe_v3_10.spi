nominal private x_tn_fe_inf_n_fe_supl_qr_code = string

inl x_tn_fe_inf_n_fe_supl_qr_code_is_valid (s : string) : bool =
    xsd_regex.table_matches (xsd_pattern_39cbdaf9_326_table ()) s
    && xml.code_point_count s >= 100
    && xml.code_point_count s <= 600

inl x_tn_fe_inf_n_fe_supl_qr_code_of_string (s : string) : option x_tn_fe_inf_n_fe_supl_qr_code =
    if x_tn_fe_inf_n_fe_supl_qr_code_is_valid s then Some (x_tn_fe_inf_n_fe_supl_qr_code s) else None

inl x_tn_fe_inf_n_fe_supl_qr_code_to_string (x : x_tn_fe_inf_n_fe_supl_qr_code) : string =
    match x with x_tn_fe_inf_n_fe_supl_qr_code s => s

instance to_text x_tn_fe_inf_n_fe_supl_qr_code = fun x => x_tn_fe_inf_n_fe_supl_qr_code_to_string x
inl x_tn_fe_inf_n_fe_supl_qr_code_example (_ : i32) : x_tn_fe_inf_n_fe_supl_qr_code =
    x_tn_fe_inf_n_fe_supl_qr_code (
        "HTTP://?chNFe=00000000000000000000000000000000000000000000&nVersao=000&tpAmb=1&dhEmi=000000000000000000000"
        ^^ "00000000000000000000000000000&vNF=0&vICMS=0&digVal=0000000000000000000000000000000000000000000000000000000"
        ^^ "0&cIdToken=000000&cHashQRCode=0000000000000000000000000000000000000000"
