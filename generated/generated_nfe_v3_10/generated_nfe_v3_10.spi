    inl nodes forall r. (f : x_x509_data_type_field r) (v : r) : list xml.xml_node =
        match f with
        | X509DataType_field_X509Certificate => [ xml.element "X509Certificate" [] (xml.text_children v) ]
    inl rec walk (fields : list (exists r. x_x509_data_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_x509_data_type_get f x)) (walk rest)
        | [] => []
    walk [ exists X509DataType_field_X509Certificate ]

and let x_x509_data_type_attributes (x : x_x509_data_type) : list (string * string) = []

and let x_x509_data_type_to_xml (name : string) (x : x_x509_data_type) : xml.xml_node =
    xml.element name (x_x509_data_type_attributes x) (x_x509_data_type_children x)

