    elif index = 1i32 then CausalePagamentoType_B
    elif index = 2i32 then CausalePagamentoType_C
    elif index = 3i32 then CausalePagamentoType_D
    elif index = 4i32 then CausalePagamentoType_E
    elif index = 5i32 then CausalePagamentoType_G
    elif index = 6i32 then CausalePagamentoType_H
    else CausalePagamentoType_I

