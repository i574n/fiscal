let rec xsd_pattern_62c794f2_13 (state : i32) (s : string) (i : i32) : bool =
    if i >= sm'.length s then state = 6i32 || state = 7i32
    else
        inl c = xml.code_point_at s i
        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_62c794f2_13 1i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_62c794f2_13 1i32 s next
            else false
        elif state = 1i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_62c794f2_13 2i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_62c794f2_13 2i32 s next
            else false
        elif state = 2i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_62c794f2_13 3i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_62c794f2_13 3i32 s next
            else false
        elif state = 3i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_62c794f2_13 4i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_62c794f2_13 4i32 s next
            else false
        elif state = 4i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_62c794f2_13 5i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_62c794f2_13 5i32 s next
            else false
        elif state = 5i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_62c794f2_13 6i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_62c794f2_13 6i32 s next
            else false
        elif state = 6i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_62c794f2_13 7i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_62c794f2_13 7i32 s next
            else false
        elif state = 7i32 then
            false
        else false

