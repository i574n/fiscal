and let x_fattura_elettronica_type_children (x : x_fattura_elettronica_type) : list xml.xml_node =
    inl nodes forall r. (f : x_fattura_elettronica_type_field r) (v : r) : list xml.xml_node =
        match f with
        | FatturaElettronicaType_field_FatturaElettronicaHeader =>
            [ x_fattura_elettronica_header_type_to_xml "FatturaElettronicaHeader" v ]
        | FatturaElettronicaType_field_FatturaElettronicaBody =>
            listm.map (fun v => x_fattura_elettronica_body_type_to_xml "FatturaElettronicaBody" v) v
        | FatturaElettronicaType_field_ds_Signature =>
            xml.option_list (optionm.map (fun v => x_signature_type_to_xml "ds:Signature" v) v)
    inl rec walk (fields : list (exists r. x_fattura_elettronica_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_fattura_elettronica_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists FatturaElettronicaType_field_FatturaElettronicaHeader
        exists FatturaElettronicaType_field_FatturaElettronicaBody
        exists FatturaElettronicaType_field_ds_Signature
    ]

