and let x_anagrafica_type_choice_denominazione_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_anagrafica_type_choice_denominazione
    =
    if false then failwith "unreachable"
    elif xml.has_child "Denominazione" children then
        AnagraficaType_choice_Denominazione_group_Denominazione (
            x_anagrafica_type_choice_denominazione_group_denominazione_of_children attributes children
        )
    elif xml.has_child "Nome" children then
        AnagraficaType_choice_Denominazione_group_Nome (
            x_anagrafica_type_choice_denominazione_group_nome_of_children attributes children
        )
    else failwith "x_anagrafica_type_choice_denominazione: no alternative present"

