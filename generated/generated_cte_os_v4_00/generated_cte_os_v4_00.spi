    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tgt_ve_inf_cte_aut_xml
    =
    {
        choice_cnpj = x_tgt_ve_inf_cte_aut_xml_choice_cnpj_of_children attributes children
    }

