        match f with
        | TGTVe_infCte_autXML_field_choice_cnpj => x_tgt_ve_inf_cte_aut_xml_choice_cnpj_children v
    inl rec walk (fields : list (exists r. x_tgt_ve_inf_cte_aut_xml_field r)) : list xml.xml_node =
