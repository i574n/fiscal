and let x_tgt_ve_children forall s. (x : x_tgt_ve s) : list xml.xml_node =
    listm.concat [
        [ x_tgt_ve_inf_cte_to_xml "infCte" x.inf_cte ]
        xml.option_list (optionm.map (fun v => x_tgt_ve_inf_c_te_supl_to_xml "infCTeSupl" v) x.inf_c_te_supl)
        staged_list (fun v => x_signature_type_to_xml "ds:Signature" v) x.signature
    ]

and let x_tgt_ve_attributes forall s. (x : x_tgt_ve s) : list (string * string) = [ ("versao", x.versao) ]

and let x_tgt_ve_to_xml forall s. (name : string) (x : x_tgt_ve s) : xml.xml_node =
    xml.element name (x_tgt_ve_attributes x) (x_tgt_ve_children x)

and let x_tgt_ve_inf_c_te_supl_children (x : x_tgt_ve_inf_c_te_supl) : list xml.xml_node =
    inl nodes forall r. (f : x_tgt_ve_inf_c_te_supl_field r) (v : r) : list xml.xml_node =
        match f with
        | TGTVe_infCTeSupl_field_qrCodCTe => [ text_node "qrCodCTe" v ]
    inl rec walk (fields : list (exists r. x_tgt_ve_inf_c_te_supl_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tgt_ve_inf_c_te_supl_get f x)) (walk rest)
        | [] => []
    walk [ exists TGTVe_infCTeSupl_field_qrCodCTe ]

and let x_tgt_ve_inf_c_te_supl_attributes (x : x_tgt_ve_inf_c_te_supl) : list (string * string) = []

and let x_tgt_ve_inf_c_te_supl_to_xml (name : string) (x : x_tgt_ve_inf_c_te_supl) : xml.xml_node =
    xml.element name (x_tgt_ve_inf_c_te_supl_attributes x) (x_tgt_ve_inf_c_te_supl_children x)

and let x_tgt_ve_inf_cte_children (x : x_tgt_ve_inf_cte) : list xml.xml_node =
    inl nodes forall r. (f : x_tgt_ve_inf_cte_field r) (v : r) : list xml.xml_node =
        match f with
        | TGTVe_infCte_field_ide => [ x_tgt_ve_inf_cte_ide_to_xml "ide" v ]
        | TGTVe_infCte_field_compl => xml.option_list (optionm.map (fun v => x_tgt_ve_inf_cte_compl_to_xml "compl" v) v)
        | TGTVe_infCte_field_emit => [ x_tgt_ve_inf_cte_emit_to_xml "emit" v ]
        | TGTVe_infCte_field_rem => [ x_tgt_ve_inf_cte_rem_to_xml "rem" v ]
        | TGTVe_infCte_field_dest => [ x_tgt_ve_inf_cte_dest_to_xml "dest" v ]
        | TGTVe_infCte_field_origem => xml.option_list (optionm.map (fun v => x_t_ende_emi_to_xml "origem" v) v)
        | TGTVe_infCte_field_destino => xml.option_list (optionm.map (fun v => x_t_ende_emi_to_xml "destino" v) v)
        | TGTVe_infCte_field_detGTV => [ x_tgt_ve_inf_cte_det_gtv_to_xml "detGTV" v ]
        | TGTVe_infCte_field_autXML => listm.map (fun v => x_tgt_ve_inf_cte_aut_xml_to_xml "autXML" v) v
        | TGTVe_infCte_field_infRespTec => xml.option_list (optionm.map (fun v => x_t_resp_tec_to_xml "infRespTec" v) v)
    inl rec walk (fields : list (exists r. x_tgt_ve_inf_cte_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tgt_ve_inf_cte_get f x)) (walk rest)
        | [] => []
    walk [
        exists TGTVe_infCte_field_ide
        exists TGTVe_infCte_field_compl
        exists TGTVe_infCte_field_emit
        exists TGTVe_infCte_field_rem
        exists TGTVe_infCte_field_dest
        exists TGTVe_infCte_field_origem
        exists TGTVe_infCte_field_destino
        exists TGTVe_infCte_field_detGTV
        exists TGTVe_infCte_field_autXML
        exists TGTVe_infCte_field_infRespTec
    ]

