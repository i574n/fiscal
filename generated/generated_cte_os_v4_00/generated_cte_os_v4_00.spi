let rec x_tgt_ve_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tgt_ve s
    =
    {
        inf_cte = (fun c => x_tgt_ve_inf_cte_of_xml c) (xml.required_child "infCte" children)
        inf_c_te_supl = optionm.map (fun c => x_tgt_ve_inf_c_te_supl_of_xml c) (xml.first_child "infCTeSupl" children)
        signature =
            staged_of witness fun () =>
                (fun c => x_signature_type_of_xml c) (xml.required_child "ds:Signature" children)
        versao = xml.required_attribute "versao" attributes
    }

and let x_tgt_ve_of_xml forall s. (witness : stage s) (c : xml.xml_node) : x_tgt_ve s =
    x_tgt_ve_of_children witness (xml.element_attributes c) (xml.element_children c)

and let x_tgt_ve_inf_c_te_supl_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tgt_ve_inf_c_te_supl
    =
    {
        qr_cod_c_te =
            (fun c => xml.required_value "x_tgt_ve_inf_c_te_supl_qr_cod_c_te" (x_tgt_ve_inf_c_te_supl_qr_cod_c_te_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "qrCodCTe" children)
    }

and let x_tgt_ve_inf_c_te_supl_of_xml (c : xml.xml_node) : x_tgt_ve_inf_c_te_supl =
    x_tgt_ve_inf_c_te_supl_of_children (xml.element_attributes c) (xml.element_children c)

and let x_tgt_ve_inf_cte_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tgt_ve_inf_cte
    =
    {
        ide = (fun c => x_tgt_ve_inf_cte_ide_of_xml c) (xml.required_child "ide" children)
        compl = optionm.map (fun c => x_tgt_ve_inf_cte_compl_of_xml c) (xml.first_child "compl" children)
        emit = (fun c => x_tgt_ve_inf_cte_emit_of_xml c) (xml.required_child "emit" children)
        rem = (fun c => x_tgt_ve_inf_cte_rem_of_xml c) (xml.required_child "rem" children)
        dest = (fun c => x_tgt_ve_inf_cte_dest_of_xml c) (xml.required_child "dest" children)
        origem = optionm.map (fun c => x_t_ende_emi_of_xml c) (xml.first_child "origem" children)
        destino = optionm.map (fun c => x_t_ende_emi_of_xml c) (xml.first_child "destino" children)
        det_gtv = (fun c => x_tgt_ve_inf_cte_det_gtv_of_xml c) (xml.required_child "detGTV" children)
        aut_xml = listm.map (fun c => x_tgt_ve_inf_cte_aut_xml_of_xml c) (xml.children_named "autXML" children)
        inf_resp_tec = optionm.map (fun c => x_t_resp_tec_of_xml c) (xml.first_child "infRespTec" children)
        versao = xml.required_attribute "versao" attributes
        id =
            xml.required_value
                "x_tgt_ve_inf_cte_id"
                (x_tgt_ve_inf_cte_id_of_string (xml.required_attribute "Id" attributes))
    }

