        id = xml.attribute_of "Id" attributes
    }

and let x_key_info_type_of_xml (c : xml.xml_node) : x_key_info_type =
    x_key_info_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_x509_data_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_x509_data_type
    =
    {
        x509_certificate =
            (fun c => xml.text_in (xml.element_children c)) (xml.required_child "X509Certificate" children)
    }

and let x_x509_data_type_of_xml (c : xml.xml_node) : x_x509_data_type =
    x_x509_data_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_mensaje_hacienda_children forall s. (x : x_mensaje_hacienda s) : list xml.xml_node =
    listm.concat [
        [ text_node "Clave" x.clave ]
        [ text_node "NombreEmisor" x.nombre_emisor ]
        [ text_node "TipoIdentificacionEmisor" x.tipo_identificacion_emisor ]
        [ text_node "NumeroCedulaEmisor" x.numero_cedula_emisor ]
        optional_text_nodes "NombreReceptor" x.nombre_receptor
        optional_text_nodes "TipoIdentificacionReceptor" x.tipo_identificacion_receptor
        optional_text_nodes "NumeroCedulaReceptor" x.numero_cedula_receptor
        [ text_node "Mensaje" x.mensaje ]
        [ text_node "EstadoMensaje" x.estado_mensaje ]
        [ xml.element "DetalleMensaje" [] (xml.text_children x.detalle_mensaje) ]
        xml.option_list (
            optionm.map (fun v => xml.element "MontoTotalImpuesto" [] (xml.text_children v)) x.monto_total_impuesto
        )
        [ xml.element "TotalFactura" [] (xml.text_children x.total_factura) ]
        staged_list (fun v => x_signature_type_to_xml "ds:Signature" v) x.signature
    ]

