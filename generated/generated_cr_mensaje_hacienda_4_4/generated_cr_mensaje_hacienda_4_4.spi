        clave : x_mensaje_hacienda_clave
        nombre_emisor : x_mensaje_hacienda_nombre_emisor
        tipo_identificacion_emisor : x_mensaje_hacienda_tipo_identificacion_emisor
        numero_cedula_emisor : x_mensaje_hacienda_numero_cedula_emisor
        nombre_receptor : option (x_mensaje_hacienda_nombre_receptor)
        tipo_identificacion_receptor : option (x_mensaje_hacienda_tipo_identificacion_receptor)
        numero_cedula_receptor : option (x_mensaje_hacienda_numero_cedula_receptor)
        mensaje : x_mensaje_hacienda_mensaje
        estado_mensaje : x_mensaje_hacienda_estado_mensaje
        detalle_mensaje : x_mensaje_hacienda_detalle_mensaje
        monto_total_impuesto : option (x_mensaje_hacienda_monto_total_impuesto)
        total_factura : x_mensaje_hacienda_total_factura
        signature : staged s x_signature_type
    }

union x_signature_type_field r =
    | SignatureType_field_SignedInfo :: x_signature_type_field (x_signed_info_type)
    | SignatureType_field_SignatureValue :: x_signature_type_field (x_signature_value_type)
    | SignatureType_field_KeyInfo :: x_signature_type_field (x_key_info_type)

inl x_signature_type_get forall r. (f : x_signature_type_field r) (x : x_signature_type) : r =
    match f with
    | SignatureType_field_SignedInfo => x.signed_info
    | SignatureType_field_SignatureValue => x.signature_value
    | SignatureType_field_KeyInfo => x.key_info

union x_signed_info_type_field r =
    | SignedInfoType_field_CanonicalizationMethod ::
        x_signed_info_type_field (x_signed_info_type_canonicalization_method)
    | SignedInfoType_field_SignatureMethod :: x_signed_info_type_field (x_signed_info_type_signature_method)
    | SignedInfoType_field_Reference :: x_signed_info_type_field (x_reference_type)

inl x_signed_info_type_get forall r. (f : x_signed_info_type_field r) (x : x_signed_info_type) : r =
    match f with
    | SignedInfoType_field_CanonicalizationMethod => x.canonicalization_method
    | SignedInfoType_field_SignatureMethod => x.signature_method
    | SignedInfoType_field_Reference => x.reference

union x_reference_type_field r =
    | ReferenceType_field_Transforms :: x_reference_type_field (x_transforms_type)
    | ReferenceType_field_DigestMethod :: x_reference_type_field (x_reference_type_digest_method)
    | ReferenceType_field_DigestValue :: x_reference_type_field (x_digest_value_type)

inl x_reference_type_get forall r. (f : x_reference_type_field r) (x : x_reference_type) : r =
    match f with
    | ReferenceType_field_Transforms => x.transforms
    | ReferenceType_field_DigestMethod => x.digest_method
    | ReferenceType_field_DigestValue => x.digest_value

union x_transforms_type_field r =
    | TransformsType_field_Transform :: x_transforms_type_field (list (x_transform_type))

inl x_transforms_type_get forall r. (f : x_transforms_type_field r) (x : x_transforms_type) : r =
    match f with
    | TransformsType_field_Transform => x.transform

union x_transform_type_field r =
    | TransformType_field_XPath :: x_transform_type_field (string)

inl x_transform_type_get forall r. (f : x_transform_type_field r) (x : x_transform_type) : r =
    match f with
    | TransformType_field_XPath => x.x_path

union x_key_info_type_field r =
    | KeyInfoType_field_X509Data :: x_key_info_type_field (x_x509_data_type)

inl x_key_info_type_get forall r. (f : x_key_info_type_field r) (x : x_key_info_type) : r =
    match f with
    | KeyInfoType_field_X509Data => x.x509_data

union x_x509_data_type_field r =
    | X509DataType_field_X509Certificate :: x_x509_data_type_field (string)

inl x_x509_data_type_get forall r. (f : x_x509_data_type_field r) (x : x_x509_data_type) : r =
    match f with
    | X509DataType_field_X509Certificate => x.x509_certificate

let rec x_mensaje_hacienda_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : x_mensaje_hacienda s
    =
    {
        clave =
            (fun c => xml.required_value "x_mensaje_hacienda_clave" (x_mensaje_hacienda_clave_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "Clave" children)
        nombre_emisor =
            (fun c => xml.required_value "x_mensaje_hacienda_nombre_emisor" (x_mensaje_hacienda_nombre_emisor_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "NombreEmisor" children)
        tipo_identificacion_emisor =
            (fun c => xml.required_value "x_mensaje_hacienda_tipo_identificacion_emisor" (x_mensaje_hacienda_tipo_identificacion_emisor_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "TipoIdentificacionEmisor" children)
        numero_cedula_emisor =
            (fun c => xml.required_value "x_mensaje_hacienda_numero_cedula_emisor" (x_mensaje_hacienda_numero_cedula_emisor_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "NumeroCedulaEmisor" children)
        nombre_receptor =
            optionm.map
                fun c =>
                    xml.required_value "x_mensaje_hacienda_nombre_receptor" (
                        x_mensaje_hacienda_nombre_receptor_of_string (xml.text_in (xml.element_children c)))
                (xml.first_child "NombreReceptor" children)
        tipo_identificacion_receptor =
            optionm.map
                fun c =>
                    xml.required_value
                        "x_mensaje_hacienda_tipo_identificacion_receptor"
                        (
                            x_mensaje_hacienda_tipo_identificacion_receptor_of_string (
                                xml.text_in (xml.element_children c)
                            )
                        )
                (xml.first_child "TipoIdentificacionReceptor" children)
        numero_cedula_receptor =
            optionm.map
                fun c =>
                    xml.required_value "x_mensaje_hacienda_numero_cedula_receptor" (
                        x_mensaje_hacienda_numero_cedula_receptor_of_string (xml.text_in (xml.element_children c)))
                (xml.first_child "NumeroCedulaReceptor" children)
        mensaje =
            (fun c => xml.required_value "x_mensaje_hacienda_mensaje" (x_mensaje_hacienda_mensaje_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "Mensaje" children)
        estado_mensaje =
            (fun c => xml.required_value "x_mensaje_hacienda_estado_mensaje" (x_mensaje_hacienda_estado_mensaje_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "EstadoMensaje" children)
        detalle_mensaje = (fun c => xml.text_in (xml.element_children c)) (xml.required_child "DetalleMensaje" children)
        monto_total_impuesto =
            optionm.map (fun c => xml.text_in (xml.element_children c)) (xml.first_child "MontoTotalImpuesto" children)
        total_factura = (fun c => xml.text_in (xml.element_children c)) (xml.required_child "TotalFactura" children)
        signature =
            staged_of witness fun () =>
                (fun c => x_signature_type_of_xml c) (xml.required_child "ds:Signature" children)
    }

and let x_mensaje_hacienda_of_xml forall s. (witness : stage s) (c : xml.xml_node) : x_mensaje_hacienda s =
    x_mensaje_hacienda_of_children witness (xml.element_attributes c) (xml.element_children c)

and let x_signature_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_signature_type
    =
    {
        signed_info = (fun c => x_signed_info_type_of_xml c) (xml.required_child "SignedInfo" children)
        signature_value = (fun c => x_signature_value_type_of_xml c) (xml.required_child "SignatureValue" children)
        key_info = (fun c => x_key_info_type_of_xml c) (xml.required_child "KeyInfo" children)
        id = xml.attribute_of "Id" attributes
    }

and let x_signature_type_of_xml (c : xml.xml_node) : x_signature_type =
    x_signature_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_signature_value_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_signature_value_type
    =
    {
        base = xml.text_in children
        id = xml.attribute_of "Id" attributes
    }

and let x_signature_value_type_of_xml (c : xml.xml_node) : x_signature_value_type =
    x_signature_value_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_signed_info_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_signed_info_type
    =
    {
        canonicalization_method =
            (fun c => x_signed_info_type_canonicalization_method_of_xml c) (xml.required_child "CanonicalizationMethod" children)
        signature_method =
            (fun c => x_signed_info_type_signature_method_of_xml c) (xml.required_child "SignatureMethod" children)
        reference = (fun c => x_reference_type_of_xml c) (xml.required_child "Reference" children)
        id = xml.attribute_of "Id" attributes
    }

and let x_signed_info_type_of_xml (c : xml.xml_node) : x_signed_info_type =
    x_signed_info_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_signed_info_type_signature_method_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_signed_info_type_signature_method
    =
    {
        algorithm =
            xml.required_attribute
                "Algorithm"
                (xml.checked_fixed "Algorithm" "http://www.w3.org/2000/09/xmldsig#rsa-sha1" attributes)
    }

and let x_signed_info_type_signature_method_of_xml (c : xml.xml_node) : x_signed_info_type_signature_method =
    x_signed_info_type_signature_method_of_children (xml.element_attributes c) (xml.element_children c)

and let x_signed_info_type_canonicalization_method_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_signed_info_type_canonicalization_method
    =
    {
        algorithm =
            xml.required_attribute
                "Algorithm"
                (xml.checked_fixed "Algorithm" "http://www.w3.org/TR/2001/REC-xml-c14n-20010315" attributes)
    }

and let x_signed_info_type_canonicalization_method_of_xml (c : xml.xml_node) : x_signed_info_type_canonicalization_method =
    x_signed_info_type_canonicalization_method_of_children (xml.element_attributes c) (xml.element_children c)

and let x_reference_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_reference_type
    =
    {
        transforms = (fun c => x_transforms_type_of_xml c) (xml.required_child "Transforms" children)
        digest_method = (fun c => x_reference_type_digest_method_of_xml c) (xml.required_child "DigestMethod" children)
        digest_value = (fun c => xml.text_in (xml.element_children c)) (xml.required_child "DigestValue" children)
        id = xml.attribute_of "Id" attributes
        uri =
            xml.required_value
                "x_reference_type_uri"
                (x_reference_type_uri_of_string (xml.required_attribute "URI" attributes))
        type_value = xml.attribute_of "Type" attributes
    }

and let x_reference_type_of_xml (c : xml.xml_node) : x_reference_type =
    x_reference_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_reference_type_digest_method_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_reference_type_digest_method
    =
    {
        algorithm =
            xml.required_attribute
                "Algorithm"
                (xml.checked_fixed "Algorithm" "http://www.w3.org/2000/09/xmldsig#sha1" attributes)
    }

and let x_reference_type_digest_method_of_xml (c : xml.xml_node) : x_reference_type_digest_method =
    x_reference_type_digest_method_of_children (xml.element_attributes c) (xml.element_children c)

and let x_transforms_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_transforms_type
    =
    {
        transform = listm.map (fun c => x_transform_type_of_xml c) (xml.children_named "Transform" children)
    }

and let x_transforms_type_of_xml (c : xml.xml_node) : x_transforms_type =
    x_transforms_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_transform_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_transform_type
    =
    {
        x_path = (fun c => xml.text_in (xml.element_children c)) (xml.required_child "XPath" children)
        algorithm =
            xml.required_value
                "x_t_transform_uri"
                (x_t_transform_uri_of_string (xml.required_attribute "Algorithm" attributes))
    }

and let x_transform_type_of_xml (c : xml.xml_node) : x_transform_type =
    x_transform_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_key_info_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_key_info_type
    =
