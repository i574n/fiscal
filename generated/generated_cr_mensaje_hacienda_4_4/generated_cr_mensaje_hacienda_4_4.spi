///- --package . --timeout 2400000
prototype to_text t : t -> string

inl text_node forall t {to_text}. (name : string) (v : t) : xml.xml_node =
    xml.element name [] (xml.text_children (to_text v))

inl optional_text_nodes forall t {to_text}. (name : string) (v : option t) : list xml.xml_node =
    xml.option_list (optionm.map (text_node name) v)

inl repeated_text_nodes forall t {to_text}. (name : string) (vs : list t) : list xml.xml_node =
    listm.map (text_node name) vs

nominal unsigned = ()
nominal signed = ()

union staged s a =
    | Pending :: forall a. string -> staged unsigned a
    | Present :: forall a. a -> staged signed a

union stage s =
    | Unsigned :: stage unsigned
    | Signed :: stage signed

inl staged_of forall s a. (witness : stage s) (read : () -> a) : staged s a =
    match witness with
    | Unsigned => Pending "unsigned"
    | Signed => Present (read ())

inl signed_value forall a. (x : staged signed a) : a =
    match x with
    | Present v => v

inl staged_list forall s a b. (f : a -> b) (x : staged s a) : list b =
    match x with
    | Pending _ => []
    | Present v => [ f v ]

union x_t_transform_uri =
    | TTransformURI_enveloped_signature
    | TTransformURI_REC_xml_c14n_20010315

inl x_t_transform_uri_of_string (s : string) : option x_t_transform_uri =
    inl s = xml.collapsed_space s
    match s with
    | "http://www.w3.org/2000/09/xmldsig#enveloped-signature" => Some TTransformURI_enveloped_signature
    | "http://www.w3.org/TR/2001/REC-xml-c14n-20010315" => Some TTransformURI_REC_xml_c14n_20010315
    | _ => None

inl x_t_transform_uri_to_string (x : x_t_transform_uri) : string =
    match x with
    | TTransformURI_enveloped_signature => "http://www.w3.org/2000/09/xmldsig#enveloped-signature"
    | TTransformURI_REC_xml_c14n_20010315 => "http://www.w3.org/TR/2001/REC-xml-c14n-20010315"

instance to_text x_t_transform_uri = fun x => x_t_transform_uri_to_string x

inl x_t_transform_uri_example (k : i32) : x_t_transform_uri =
    inl index = ((k % 2i32) + 2i32) % 2i32
    if index = 0i32 then TTransformURI_enveloped_signature
    else TTransformURI_REC_xml_c14n_20010315

inl x_t_transform_uri_example_text (k : i32) : string = x_t_transform_uri_to_string (x_t_transform_uri_example k)

type x_digest_value_type = string

inl x_digest_value_type_is_valid (s : string) : bool = true

inl x_digest_value_type_example (_ : i32) : string = "AAAA"

inl x_digest_value_type_example_text (k : i32) : string = x_digest_value_type_example k

type x_x509_data_type =
    {
        x509_certificate : string
    }

type x_key_info_type =
    {
        x509_data : x_x509_data_type
        id : option (string)
    }

type x_transform_type =
    {
        x_path : string
        algorithm : x_t_transform_uri
    }

type x_transforms_type =
    {
        transform : list (x_transform_type)
    }

type x_reference_type_digest_method =
    {
        algorithm : string
    }

nominal private x_reference_type_uri = string

inl x_reference_type_uri_is_valid (s : string) : bool = xml.code_point_count s >= 2

inl x_reference_type_uri_of_string (s : string) : option x_reference_type_uri =
    match xml.collapsed_space s with
    | s => if x_reference_type_uri_is_valid s then Some (x_reference_type_uri s) else None

inl x_reference_type_uri_to_string (x : x_reference_type_uri) : string = match x with x_reference_type_uri s => s

instance to_text x_reference_type_uri = fun x => x_reference_type_uri_to_string x
inl x_reference_type_uri_example (_ : i32) : x_reference_type_uri = x_reference_type_uri "http://example.com"

inl x_reference_type_uri_example_text (k : i32) : string =
    x_reference_type_uri_to_string (x_reference_type_uri_example k)

type x_reference_type =
    {
        transforms : x_transforms_type
        digest_method : x_reference_type_digest_method
        digest_value : x_digest_value_type
        id : option (string)
        uri : x_reference_type_uri
        type_value : option (string)
    }

type x_signed_info_type_canonicalization_method =
    {
        algorithm : string
    }

type x_signed_info_type_signature_method =
    {
        algorithm : string
    }

type x_signed_info_type =
    {
        canonicalization_method : x_signed_info_type_canonicalization_method
        signature_method : x_signed_info_type_signature_method
        reference : x_reference_type
        id : option (string)
    }

type x_signature_value_type =
    {
        base : string
        id : option (string)
    }

type x_signature_type =
    {
        signed_info : x_signed_info_type
        signature_value : x_signature_value_type
        key_info : x_key_info_type
        id : option (string)
    }

