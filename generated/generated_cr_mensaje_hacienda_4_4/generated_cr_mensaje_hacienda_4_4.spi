        match f with
        | SignedInfoType_field_CanonicalizationMethod =>
            [ x_signed_info_type_canonicalization_method_to_xml "CanonicalizationMethod" v ]
        | SignedInfoType_field_SignatureMethod => [ x_signed_info_type_signature_method_to_xml "SignatureMethod" v ]
        | SignedInfoType_field_Reference => [ x_reference_type_to_xml "Reference" v ]
    inl rec walk (fields : list (exists r. x_signed_info_type_field r)) : list xml.xml_node =
