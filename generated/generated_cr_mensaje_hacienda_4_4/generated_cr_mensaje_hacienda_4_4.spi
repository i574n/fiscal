and let x_mensaje_hacienda_to_xml forall s. (name : string) (x : x_mensaje_hacienda s) : xml.xml_node =
    xml.element name (x_mensaje_hacienda_attributes x) (x_mensaje_hacienda_children x)

and let x_signature_type_children (x : x_signature_type) : list xml.xml_node =
    inl nodes forall r. (f : x_signature_type_field r) (v : r) : list xml.xml_node =
        match f with
        | SignatureType_field_SignedInfo => [ x_signed_info_type_to_xml "SignedInfo" v ]
        | SignatureType_field_SignatureValue => [ x_signature_value_type_to_xml "SignatureValue" v ]
        | SignatureType_field_KeyInfo => [ x_key_info_type_to_xml "KeyInfo" v ]
    inl rec walk (fields : list (exists r. x_signature_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_signature_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists SignatureType_field_SignedInfo
        exists SignatureType_field_SignatureValue
        exists SignatureType_field_KeyInfo
    ]

and let x_signature_type_attributes (x : x_signature_type) : list (string * string) =
    xml.option_list (optionm.map (fun v => ("Id", v)) x.id)

