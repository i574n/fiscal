    xml.element name (x_t_evento_inf_evento_attributes x) (x_t_evento_inf_evento_children x)

and let x_t_evento_inf_evento_det_evento_children (x : x_t_evento_inf_evento_det_evento) : list xml.xml_node =
    inl nodes forall r. (f : x_t_evento_inf_evento_det_evento_field r) (v : r) : list xml.xml_node =
        match f with
        | TEvento_infEvento_detEvento_field_descEvento => [ text_node "descEvento" v ]
        | TEvento_infEvento_detEvento_field_xJust => optional_text_nodes "xJust" v
    inl rec walk (fields : list (exists r. x_t_evento_inf_evento_det_evento_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_t_evento_inf_evento_det_evento_get f x)) (walk rest)
        | [] => []
    walk [ exists TEvento_infEvento_detEvento_field_descEvento; exists TEvento_infEvento_detEvento_field_xJust ]

