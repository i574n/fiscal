and let x_t_evento_inf_evento_children (x : x_t_evento_inf_evento) : list xml.xml_node =
    inl nodes forall r. (f : x_t_evento_inf_evento_field r) (v : r) : list xml.xml_node =
        match f with
        | TEvento_infEvento_field_cOrgao => [ text_node "cOrgao" v ]
        | TEvento_infEvento_field_tpAmb => [ text_node "tpAmb" v ]
        | TEvento_infEvento_field_choice_cnpj => x_t_evento_inf_evento_choice_cnpj_children v
        | TEvento_infEvento_field_chNFe => [ text_node "chNFe" v ]
        | TEvento_infEvento_field_dhEvento => [ text_node "dhEvento" v ]
        | TEvento_infEvento_field_tpEvento => [ text_node "tpEvento" v ]
        | TEvento_infEvento_field_nSeqEvento => [ text_node "nSeqEvento" v ]
        | TEvento_infEvento_field_verEvento => [ text_node "verEvento" v ]
        | TEvento_infEvento_field_detEvento => [ x_t_evento_inf_evento_det_evento_to_xml "detEvento" v ]
    inl rec walk (fields : list (exists r. x_t_evento_inf_evento_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_t_evento_inf_evento_get f x)) (walk rest)
        | [] => []
    walk [
        exists TEvento_infEvento_field_cOrgao
        exists TEvento_infEvento_field_tpAmb
        exists TEvento_infEvento_field_choice_cnpj
        exists TEvento_infEvento_field_chNFe
        exists TEvento_infEvento_field_dhEvento
        exists TEvento_infEvento_field_tpEvento
        exists TEvento_infEvento_field_nSeqEvento
        exists TEvento_infEvento_field_verEvento
        exists TEvento_infEvento_field_detEvento
    ]

