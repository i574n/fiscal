        match f with
        | TretEvento_field_infEvento => [ x_tret_evento_inf_evento_to_xml "infEvento" v ]
        | TretEvento_field_ds_Signature =>
            xml.option_list (optionm.map (fun v => x_signature_type_to_xml "ds:Signature" v) v)
    inl rec walk (fields : list (exists r. x_tret_evento_field r)) : list xml.xml_node =
        match fields with
