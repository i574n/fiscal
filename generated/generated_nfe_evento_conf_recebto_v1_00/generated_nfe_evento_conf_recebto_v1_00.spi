        elif state = 2i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2d10bacd_20 3i32 s next
            else false
        elif state = 3i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2d10bacd_20 1i32 s next
            else false
        else false

