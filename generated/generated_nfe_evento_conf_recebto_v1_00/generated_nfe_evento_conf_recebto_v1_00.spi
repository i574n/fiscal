    else
        inl c = xml.code_point_at s i
        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if c = 48u32 then xsd_pattern_2d10bacd_20 1i32 s next
            elif 49u32 <= c && c <= 57u32 then xsd_pattern_2d10bacd_20 2i32 s next
            else false
        elif state = 1i32 then
