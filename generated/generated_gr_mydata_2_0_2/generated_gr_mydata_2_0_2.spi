and let x_delivery_event_type_choice_transport_details_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_delivery_event_type_choice_transport_details
    =
    if false then failwith "unreachable"
    elif xml.has_child "transportDetails" children then
        DeliveryEventType_choice_transportDetails_transportDetails (
            (fun c => x_transport_detail_type_of_xml c) (xml.required_child "transportDetails" children)
        )
    elif xml.has_child "outcomeDetails" children then
        DeliveryEventType_choice_transportDetails_outcomeDetails (
            (fun c => x_outcome_details_type_of_xml c) (xml.required_child "outcomeDetails" children)
        )
    elif xml.has_child "rejectionDetails" children then
        DeliveryEventType_choice_transportDetails_rejectionDetails (
            (fun c => x_rejection_details_type_of_xml c) (xml.required_child "rejectionDetails" children)
        )
    else failwith "x_delivery_event_type_choice_transport_details: no alternative present"

