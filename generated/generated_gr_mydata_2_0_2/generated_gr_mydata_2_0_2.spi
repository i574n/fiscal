        mark = optionm.map (fun c => xml.text_in (xml.element_children c)) (xml.first_child "mark" children)
        choice_transport_details =
            if xml.has_any_child [ "transportDetails"; "outcomeDetails"; "rejectionDetails" ] children
            then Some (x_delivery_event_type_choice_transport_details_of_children attributes children)
            else None
