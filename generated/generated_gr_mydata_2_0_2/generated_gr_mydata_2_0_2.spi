        match f with
        | InvoiceHeaderType_field_series => [ text_node "series" v ]
        | InvoiceHeaderType_field_aa => [ text_node "aa" v ]
        | InvoiceHeaderType_field_issueDate => [ xml.element "issueDate" [] (xml.text_children v) ]
        | InvoiceHeaderType_field_invoiceType => [ text_node "invoiceType" v ]
        | InvoiceHeaderType_field_vatPaymentSuspension =>
            xml.option_list (optionm.map (fun v => xml.element "vatPaymentSuspension" [] (xml.text_children v)) v)
        | InvoiceHeaderType_field_currency => optional_text_nodes "currency" v
        | InvoiceHeaderType_field_exchangeRate =>
            xml.option_list (optionm.map (fun v => xml.element "exchangeRate" [] (xml.text_children v)) v)
        | InvoiceHeaderType_field_correlatedInvoices =>
            listm.map (fun v => xml.element "correlatedInvoices" [] (xml.text_children v)) v
        | InvoiceHeaderType_field_selfPricing =>
            xml.option_list (optionm.map (fun v => xml.element "selfPricing" [] (xml.text_children v)) v)
