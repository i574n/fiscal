and let x_invoices_doc_children (x : x_invoices_doc) : list xml.xml_node =
    inl nodes forall r. (f : x_invoices_doc_field r) (v : r) : list xml.xml_node =
        match f with
        | InvoicesDoc_field_invoice => [ x_aade_book_invoice_type_to_xml "invoice" v ]
    inl rec walk (fields : list (exists r. x_invoices_doc_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_invoices_doc_get f x)) (walk rest)
        | [] => []
    walk [ exists InvoicesDoc_field_invoice ]

