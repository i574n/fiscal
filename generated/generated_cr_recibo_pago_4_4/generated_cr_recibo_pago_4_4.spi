and let x_dsa_key_value_type_children (x : x_dsa_key_value_type) : list xml.xml_node =
    inl nodes forall r. (f : x_dsa_key_value_type_field r) (v : r) : list xml.xml_node =
        match f with
        | DSAKeyValueType_field_P => [ xml.element "P" [] (xml.text_children v) ]
        | DSAKeyValueType_field_Q => [ xml.element "Q" [] (xml.text_children v) ]
        | DSAKeyValueType_field_G => xml.option_list (optionm.map (fun v => xml.element "G" [] (xml.text_children v)) v)
        | DSAKeyValueType_field_Y => [ xml.element "Y" [] (xml.text_children v) ]
        | DSAKeyValueType_field_J => xml.option_list (optionm.map (fun v => xml.element "J" [] (xml.text_children v)) v)
        | DSAKeyValueType_field_Seed => [ xml.element "Seed" [] (xml.text_children v) ]
        | DSAKeyValueType_field_PgenCounter => [ xml.element "PgenCounter" [] (xml.text_children v) ]
    inl rec walk (fields : list (exists r. x_dsa_key_value_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_dsa_key_value_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists DSAKeyValueType_field_P
        exists DSAKeyValueType_field_Q
        exists DSAKeyValueType_field_G
        exists DSAKeyValueType_field_Y
        exists DSAKeyValueType_field_J
        exists DSAKeyValueType_field_Seed
        exists DSAKeyValueType_field_PgenCounter
    ]

