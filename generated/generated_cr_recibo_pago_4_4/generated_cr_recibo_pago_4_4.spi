    inl rec walk (fields : list (exists r. x_impuesto_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_impuesto_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists ImpuestoType_field_Codigo
        exists ImpuestoType_field_CodigoImpuestoOTRO
        exists ImpuestoType_field_CodigoTarifaIVA
        exists ImpuestoType_field_Tarifa
        exists ImpuestoType_field_FactorCalculoIVA
        exists ImpuestoType_field_Monto
    ]

