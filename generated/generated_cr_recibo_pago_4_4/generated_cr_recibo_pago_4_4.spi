let rec x_recibo_electronico_pago_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_recibo_electronico_pago s) (list xml_codec.decode_error)
    =
    inl errors = []
    inl o_clave, errors = xml_codec.read_required "Clave" (xml_codec.read_value x_clave_type_of_string) children errors
    inl o_proveedor_sistemas, errors =
        xml_codec.read_required
            "ProveedorSistemas"
            (xml_codec.read_value x_recibo_electronico_pago_proveedor_sistemas_of_string)
            children
            errors
    inl o_numero_consecutivo, errors =
        xml_codec.read_required
            "NumeroConsecutivo"
            (xml_codec.read_value x_numero_consecutivo_type_of_string)
            children
            errors
    inl o_fecha_emision, errors = xml_codec.read_required "FechaEmision" xml_codec.read_text children errors
    inl o_emisor, errors = xml_codec.read_required "Emisor" x_emisor_type_of_xml children errors
    inl o_receptor, errors = xml_codec.read_required "Receptor" x_receptor_type_of_xml children errors
    inl o_condicion_venta, errors =
        xml_codec.read_required
            "CondicionVenta"
            (xml_codec.read_value x_recibo_electronico_pago_condicion_venta_of_string)
            children
            errors
    inl o_detalle_servicio, errors =
        xml_codec.read_required "DetalleServicio" x_recibo_electronico_pago_detalle_servicio_of_xml children errors
    inl o_resumen_factura, errors =
        xml_codec.read_required "ResumenFactura" x_recibo_electronico_pago_resumen_factura_of_xml children errors
    inl v_informacion_referencia, errors =
        xml_codec.read_repeated
            "InformacionReferencia"
            x_recibo_electronico_pago_informacion_referencia_of_xml
            children
            errors
    inl o_signature, errors =
        staged_read witness
            fun errors =>
                xml_codec.as_some (xml_codec.read_repeated "ds:Signature" x_signature_type_of_xml children errors)
            errors
    xml_codec.decoded_by errors fun () =>
        x_recibo_electronico_pago {
            clave = xml_codec.present o_clave
            proveedor_sistemas = xml_codec.present o_proveedor_sistemas
