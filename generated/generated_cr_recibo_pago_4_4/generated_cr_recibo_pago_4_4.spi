and let x_recibo_electronico_pago_children forall s. (x : x_recibo_electronico_pago s) : list xml.xml_node =
    listm.concat [
        [ text_node "Clave" x.clave ]
        [ text_node "ProveedorSistemas" x.proveedor_sistemas ]
        [ text_node "NumeroConsecutivo" x.numero_consecutivo ]
        [ xml.element "FechaEmision" [] (xml.text_children x.fecha_emision) ]
        [ x_emisor_type_to_xml "Emisor" x.emisor ]
        [ x_receptor_type_to_xml "Receptor" x.receptor ]
        [ text_node "CondicionVenta" x.condicion_venta ]
        [ x_recibo_electronico_pago_detalle_servicio_to_xml "DetalleServicio" x.detalle_servicio ]
