and let x_tc_te_inf_cte_children (x : x_tc_te_inf_cte) : list xml.xml_node =
    inl nodes forall r. (f : x_tc_te_inf_cte_field r) (v : r) : list xml.xml_node =
        match f with
        | TCTe_infCte_field_ide => [ x_tc_te_inf_cte_ide_to_xml "ide" v ]
        | TCTe_infCte_field_compl => xml.option_list (optionm.map (fun v => x_tc_te_inf_cte_compl_to_xml "compl" v) v)
        | TCTe_infCte_field_emit => [ x_tc_te_inf_cte_emit_to_xml "emit" v ]
        | TCTe_infCte_field_rem => xml.option_list (optionm.map (fun v => x_tc_te_inf_cte_rem_to_xml "rem" v) v)
        | TCTe_infCte_field_exped => xml.option_list (optionm.map (fun v => x_tc_te_inf_cte_exped_to_xml "exped" v) v)
        | TCTe_infCte_field_receb => xml.option_list (optionm.map (fun v => x_tc_te_inf_cte_receb_to_xml "receb" v) v)
        | TCTe_infCte_field_dest => xml.option_list (optionm.map (fun v => x_tc_te_inf_cte_dest_to_xml "dest" v) v)
        | TCTe_infCte_field_vPrest => [ x_tc_te_inf_cte_v_prest_to_xml "vPrest" v ]
        | TCTe_infCte_field_imp => [ x_tc_te_inf_cte_imp_to_xml "imp" v ]
        | TCTe_infCte_field_choice_inf_c_te_norm => x_tc_te_inf_cte_choice_inf_c_te_norm_children v
        | TCTe_infCte_field_autXML => listm.map (fun v => x_tc_te_inf_cte_aut_xml_to_xml "autXML" v) v
    inl rec walk (fields : list (exists r. x_tc_te_inf_cte_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tc_te_inf_cte_get f x)) (walk rest)
        | [] => []
    walk [
        exists TCTe_infCte_field_ide
        exists TCTe_infCte_field_compl
        exists TCTe_infCte_field_emit
        exists TCTe_infCte_field_rem
        exists TCTe_infCte_field_exped
        exists TCTe_infCte_field_receb
        exists TCTe_infCte_field_dest
        exists TCTe_infCte_field_vPrest
        exists TCTe_infCte_field_imp
        exists TCTe_infCte_field_choice_inf_c_te_norm
        exists TCTe_infCte_field_autXML
    ]

