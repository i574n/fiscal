let rec xsd_pattern_409741f2_36 (state : i32) (s : string) (i : i32) : bool =
    if i >= sm'.length s then state = 5i32
    else
        inl c = xml.code_point_at s i
        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if 49u32 <= c && c <= 51u32 then xsd_pattern_409741f2_36 1i32 s next
            elif 53u32 <= c && c <= 55u32 then xsd_pattern_409741f2_36 1i32 s next
            else false
        elif state = 1i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_409741f2_36 2i32 s next
            else false
        elif state = 2i32 then
            if c = 48u32 then xsd_pattern_409741f2_36 3i32 s next
            elif 49u32 <= c && c <= 57u32 then xsd_pattern_409741f2_36 4i32 s next
            else false
        elif state = 3i32 then
            if 49u32 <= c && c <= 57u32 then xsd_pattern_409741f2_36 5i32 s next
            else false
        elif state = 4i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_409741f2_36 5i32 s next
            else false
        elif state = 5i32 then
            false
        else false

