        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_325a99d4_9 1i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_325a99d4_9 1i32 s next
            else false
        elif state = 1i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_325a99d4_9 1i32 s next
            elif 65u32 <= c && c <= 90u32 then xsd_pattern_325a99d4_9 1i32 s next
            else false
        else false

