let rec x_tc_te_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tc_te s
    =
    {
        inf_cte = (fun c => x_tc_te_inf_cte_of_xml c) (xml.required_child "infCte" children)
        signature =
            staged_of witness fun () =>
                (fun c => x_signature_type_of_xml c) (xml.required_child "ds:Signature" children)
    }

and let x_tc_te_of_xml forall s. (witness : stage s) (c : xml.xml_node) : x_tc_te s =
    x_tc_te_of_children witness (xml.element_attributes c) (xml.element_children c)

and let x_tc_te_inf_cte_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tc_te_inf_cte
    =
    {
        ide = (fun c => x_tc_te_inf_cte_ide_of_xml c) (xml.required_child "ide" children)
        compl = optionm.map (fun c => x_tc_te_inf_cte_compl_of_xml c) (xml.first_child "compl" children)
        emit = (fun c => x_tc_te_inf_cte_emit_of_xml c) (xml.required_child "emit" children)
        rem = optionm.map (fun c => x_tc_te_inf_cte_rem_of_xml c) (xml.first_child "rem" children)
        exped = optionm.map (fun c => x_tc_te_inf_cte_exped_of_xml c) (xml.first_child "exped" children)
        receb = optionm.map (fun c => x_tc_te_inf_cte_receb_of_xml c) (xml.first_child "receb" children)
