and let x_mensaje_receptor_children forall s. (x : x_mensaje_receptor s) : list xml.xml_node =
    listm.concat [
        [ text_node "Clave" x.clave ]
        [ text_node "NumeroCedulaEmisor" x.numero_cedula_emisor ]
        [ xml.element "FechaEmisionDoc" [] (xml.text_children x.fecha_emision_doc) ]
        [ text_node "Mensaje" x.mensaje ]
        optional_text_nodes "DetalleMensaje" x.detalle_mensaje
        xml.option_list (
            optionm.map (fun v => xml.element "MontoTotalImpuesto" [] (xml.text_children v)) x.monto_total_impuesto
        )
        optional_text_nodes "CodigoActividad" x.codigo_actividad
        optional_text_nodes "CondicionImpuesto" x.condicion_impuesto
        xml.option_list (
            optionm.map
                fun v => xml.element "MontoTotalImpuestoAcreditar" [] (xml.text_children v)
                x.monto_total_impuesto_acreditar
        )
        xml.option_list (
            optionm.map
                fun v => xml.element "MontoTotalDeGastoAplicable" [] (xml.text_children v)
                x.monto_total_de_gasto_aplicable
        )
        [ xml.element "TotalFactura" [] (xml.text_children x.total_factura) ]
        [ text_node "NumeroCedulaReceptor" x.numero_cedula_receptor ]
        [ text_node "NumeroConsecutivoReceptor" x.numero_consecutivo_receptor ]
        listm.concat (
            staged_list (fun vs => listm.map (fun v => x_signature_type_to_xml "ds:Signature" v) vs) x.signature
        )
    ]

