and let x_signature_type_children (x : x_signature_type) : list xml.xml_node =
    inl nodes forall r. (f : x_signature_type_field r) (v : r) : list xml.xml_node =
        match f with
        | SignatureType_field_ds_SignedInfo => [ x_signed_info_type_to_xml "ds:SignedInfo" v ]
        | SignatureType_field_ds_SignatureValue => [ x_signature_value_type_to_xml "ds:SignatureValue" v ]
        | SignatureType_field_ds_KeyInfo =>
            xml.option_list (optionm.map (fun v => x_key_info_type_to_xml "ds:KeyInfo" v) v)
        | SignatureType_field_ds_Object => listm.map (fun v => x_object_type_to_xml "ds:Object" v) v
    inl rec walk (fields : list (exists r. x_signature_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_signature_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists SignatureType_field_ds_SignedInfo
        exists SignatureType_field_ds_SignatureValue
        exists SignatureType_field_ds_KeyInfo
        exists SignatureType_field_ds_Object
    ]

