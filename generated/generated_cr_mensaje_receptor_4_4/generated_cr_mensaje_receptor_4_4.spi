    }

nominal x_pgp_data_type_choice_pgp_key_id_group_pgp_key_packet =
    {
        pgp_key_packet : string
        any : any_content
    }

union x_pgp_data_type_choice_pgp_key_id =
    | PGPDataType_choice_PGPKeyID_group_PGPKeyID : x_pgp_data_type_choice_pgp_key_id_group_pgp_key_id
    | PGPDataType_choice_PGPKeyID_group_PGPKeyPacket : x_pgp_data_type_choice_pgp_key_id_group_pgp_key_packet

nominal x_pgp_data_type =
    {
        choice_pgp_key_id : x_pgp_data_type_choice_pgp_key_id
    }

nominal x_x509_issuer_serial_type =
    {
        x509_issuer_name : string
        x509_serial_number : xsd_integer
    }

union x_x509_data_type_choice_x509_issuer_serial =
    | X509DataType_choice_X509IssuerSerial_X509IssuerSerial : x_x509_issuer_serial_type
    | X509DataType_choice_X509IssuerSerial_X509SKI : string
    | X509DataType_choice_X509IssuerSerial_X509SubjectName : string
    | X509DataType_choice_X509IssuerSerial_X509Certificate : string
    | X509DataType_choice_X509IssuerSerial_X509CRL : string

nominal x_x509_data_type =
    {
        choice_x509_issuer_serial : list (x_x509_data_type_choice_x509_issuer_serial)
    }

union x_key_value_type_choice_ds_dsa_key_value =
    | KeyValueType_choice_ds_DSAKeyValue_ds_DSAKeyValue : x_dsa_key_value_type
    | KeyValueType_choice_ds_DSAKeyValue_ds_RSAKeyValue : x_rsa_key_value_type

nominal x_key_value_type =
    {
        choice_dsa_key_value : x_key_value_type_choice_ds_dsa_key_value
    }

nominal x_digest_method_type =
    {
        any : any_content
        algorithm : string
    }

union x_transform_type_choice_x_path =
    | TransformType_choice_XPath_XPath : string

nominal x_transform_type =
    {
        choice_x_path : list (x_transform_type_choice_x_path)
        algorithm : string
    }

nominal x_transforms_type =
    {
        transform : list (x_transform_type)
    }

nominal x_reference_type =
    {
        transforms : option (x_transforms_type)
        digest_method : x_digest_method_type
        digest_value : x_digest_value_type
        id : option (string)
        uri : option (string)
        type_value : option (string)
    }

nominal x_signature_method_type =
    {
        hmac_output_length : option (x_hmac_output_length_type)
        any : any_content
        algorithm : string
    }

nominal x_canonicalization_method_type =
    {
        any : any_content
        algorithm : string
    }

nominal x_signed_info_type =
    {
        canonicalization_method : x_canonicalization_method_type
        signature_method : x_signature_method_type
        reference : list (x_reference_type)
        id : option (string)
    }

nominal x_signature_value_type =
    {
        base : string
        id : option (string)
    }

