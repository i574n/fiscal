let rec x_mensaje_receptor_of_children forall s.
    (witness : stage s) (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_mensaje_receptor s) (list xml_codec.decode_error)
    =
    inl errors = []
    inl o_clave, errors =
        xml_codec.read_required "Clave" (xml_codec.read_value x_mensaje_receptor_clave_of_string) children errors
    inl o_numero_cedula_emisor, errors =
        xml_codec.read_required
            "NumeroCedulaEmisor"
