and let x_consumption_type_children (x' : x_consumption_type) : list xml.xml_node =
    inl x = match x' with | Record_x_consumption_type r => r
    inl nodes forall r. (f : x_consumption_type_field r) (v : r) : list xml.xml_node =
        match f with
        | ConsumptionType_field_cbc_UtilityStatementTypeCode =>
            xml.option_list (
                optionm.map (fun v => x_utility_statement_type_code_type_to_xml "cbc:UtilityStatementTypeCode" v) v
            )
        | ConsumptionType_field_cac_MainPeriod =>
            xml.option_list (optionm.map (fun v => x_period_type_to_xml "cac:MainPeriod" v) v)
        | ConsumptionType_field_cac_AllowanceCharge =>
            listm.map (fun v => x_allowance_charge_type_to_xml "cac:AllowanceCharge" v) v
        | ConsumptionType_field_cac_TaxTotal => listm.map (fun v => x_tax_total_type_to_xml "cac:TaxTotal" v) v
        | ConsumptionType_field_cac_EnergyWaterSupply =>
            xml.option_list (optionm.map (fun v => x_energy_water_supply_type_to_xml "cac:EnergyWaterSupply" v) v)
        | ConsumptionType_field_cac_TelecommunicationsSupply =>
            xml.option_list (
                optionm.map (fun v => x_telecommunications_supply_type_to_xml "cac:TelecommunicationsSupply" v) v
            )
        | ConsumptionType_field_cac_LegalMonetaryTotal => [ x_monetary_total_type_to_xml "cac:LegalMonetaryTotal" v ]
    inl rec walk (fields : list (exists r. x_consumption_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_consumption_type_get f x')) (walk rest)
        | [] => []
    walk [
        exists ConsumptionType_field_cbc_UtilityStatementTypeCode
        exists ConsumptionType_field_cac_MainPeriod
        exists ConsumptionType_field_cac_AllowanceCharge
        exists ConsumptionType_field_cac_TaxTotal
        exists ConsumptionType_field_cac_EnergyWaterSupply
        exists ConsumptionType_field_cac_TelecommunicationsSupply
        exists ConsumptionType_field_cac_LegalMonetaryTotal
