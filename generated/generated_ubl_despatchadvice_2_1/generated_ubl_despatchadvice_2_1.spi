        xml_codec.read_optional "cbc:CopyIndicator" x_copy_indicator_type_of_xml children errors
    inl v_uuid, errors = xml_codec.read_optional "cbc:UUID" x_uuid_type_of_xml children errors
    inl o_issue_date, errors = xml_codec.read_required "cbc:IssueDate" x_issue_date_type_of_xml children errors
    inl v_issue_time, errors = xml_codec.read_optional "cbc:IssueTime" x_issue_time_type_of_xml children errors
