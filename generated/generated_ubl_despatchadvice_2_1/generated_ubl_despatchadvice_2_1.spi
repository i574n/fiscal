///> rust
test generated_ubl_despatchadvice_2_1_writes_its_example =
    inl example = x_despatch_advice_type_example 0i32
    inl document =
        xml.element
            "DespatchAdvice"
            (
                ("xmlns", "urn:oasis:names:specification:ubl:schema:xsd:DespatchAdvice-2")
                :: ("xmlns:cac", "urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2")
                :: ("xmlns:cbc", "urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2")
                :: ("xmlns:ext", "urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2")
                :: x_despatch_advice_type_attributes example
            )
            (x_despatch_advice_type_children example)
    file_system.directory_create_all (generated_fiscal_runtime.sample_path "") |> ignore
    file_system.write_all_text
        (generated_fiscal_runtime.sample_path "generated_ubl_despatchadvice_2_1_example.xml")
        (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
    inl documents =
        [
            "deps/corpus/tr/ubltr/UBLTR_1.2.1_Paketi/xml/IDIS_Irsaliye.xml"
            "deps/corpus/tr/ubltr/UBLTR_1.2.1_Paketi/xml/Irsaliye-Matbudan.xml"
            "deps/corpus/tr/ubltr/UBLTR_1.2.1_Paketi/xml/Irsaliye-Ornek1.xml"
            "deps/corpus/tr/ubltr/UBLTR_1.2.1_Paketi/xml/Irsaliye-Ornek2.xml"
            "deps/corpus/tr/ubltr/UBLTR_1.2.1_Paketi/xml/Irsaliye-Ornek3.xml"
        ]
    inl check (path : string) : list string =
        inl text = file_system.read_all_text (generated_fiscal_runtime.sample_path (sm'.(++#) "../" path))
        match xml.read_xml text with
        | node :: [] =>
            match
                xml_codec.read_back_difference
                    (x_despatch_advice_type_of_xml)
                    (x_despatch_advice_type_to_xml "DespatchAdvice")
                    node
            with
            | Some difference => [ sm'.(++#) path (sm'.(++#) ": " difference) ]
            | None => []
        | _ => [ sm'.(++#) path ": not one root element" ]
    inl failures = listm.concat (listm.map check documents)
    inl _ =
        match failures with
        | first :: _ =>
            inl count = sm'.obj_to_string (listm.length failures : i32)
            inl message = sm'.(++#) " real documents do not read back unchanged; first: " first
            failwith (sm'.(++#) count message)
        | [] => ()
    inl text =
        file_system.read_all_text (generated_fiscal_runtime.sample_path "generated_ubl_despatchadvice_2_1_example.xml")
    let rec runs (left : i32) (parses : list i64) (writes : list i64) (bytes : i64) : list i64 * list i64 * i64 =
        if left = 0i32 then parses, writes, bytes
        else
            inl watch = date_time.stopwatch ()
            date_time.stopwatch_start watch
            inl start = date_time.stopwatch_elapsed_microseconds watch
            match xml.read_xml text with
            | node :: [] =>
                inl parsed = xml_codec.expect_decoded (x_despatch_advice_type_of_xml node)
                inl parsed_at = date_time.stopwatch_elapsed_microseconds watch
                inl written = xml.write_node (x_despatch_advice_type_to_xml "DespatchAdvice" parsed)
                inl written_at = date_time.stopwatch_elapsed_microseconds watch
                inl parses = generated_fiscal_runtime.insert_run (parsed_at - start) parses
                inl writes = generated_fiscal_runtime.insert_run (written_at - parsed_at) writes
                runs (left - 1i32) parses writes (bytes + sm'.length written)
            | _ => failwith "one DespatchAdvice element"
    inl _ = runs (dyn 5i32) [] [] 0i64
    inl parses, writes, bytes = runs (dyn 31i32) [] [] 0i64
    inl row = sm'.(++#) "generated_ubl_despatchadvice_2_1 parse_us " (generated_fiscal_runtime.median parses)
    inl row = sm'.(++#) row (sm'.(++#) " write_us " (generated_fiscal_runtime.median writes))
    inl row = sm'.(++#) row (sm'.(++#) " runs 31 bytes " (sm'.obj_to_string bytes))
    console.write_line row
    match xml.read_xml text with
    | node :: [] =>
        inl parsed = xml_codec.expect_decoded (x_despatch_advice_type_of_xml node)
        inl document =
            xml.element
                "DespatchAdvice"
                (
                    ("xmlns", "urn:oasis:names:specification:ubl:schema:xsd:DespatchAdvice-2")
                    :: ("xmlns:cac", "urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2")
                    :: ("xmlns:cbc", "urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2")
                    :: ("xmlns:ext", "urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2")
                    :: x_despatch_advice_type_attributes parsed
                )
                (x_despatch_advice_type_children parsed)
        inl folder = generated_fiscal_runtime.sample_path "../target/bench"
        match file_system.directory_create_all folder with
        | Ok _ =>
            file_system.write_all_text
                (sm'.(++#) folder "/ours-generated_ubl_despatchadvice_2_1_example.xml")
                (xml.write_node (xml.with_namespace "Signature" "http://www.w3.org/2000/09/xmldsig#" document))
        | Error _ => failwith "cannot create target/bench"
    | _ => failwith "one DespatchAdvice element"

///> rust
test generated_ubl_despatchadvice_2_1_reports_a_missing_element_with_its_path =
    inl document =
        xml_codec.pruned "ID" (x_despatch_advice_type_to_xml "DespatchAdvice" (x_despatch_advice_type_example 0i32))
    if xml_codec.reports "missing cbc:ID" (x_despatch_advice_type_of_xml document) = false then
        failwith "a document without cbc:ID is reported as missing, not raised"
