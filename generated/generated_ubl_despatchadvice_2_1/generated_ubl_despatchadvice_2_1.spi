and let x_object_type_attributes (x : x_object_type) : list (string * string) =
    listm.concat [
        xml.option_list (optionm.map (fun v => "Id", v) x.id)
        xml.option_list (optionm.map (fun v => "MimeType", v) x.mime_type)
        xml.option_list (optionm.map (fun v => "Encoding", v) x.encoding)
    ]

and let x_object_type_to_xml (name : string) (x : x_object_type) : xml.xml_node =
    xml.element name (x_object_type_attributes x) (x_object_type_children x)

and let x_manifest_type_children (x : x_manifest_type) : list xml.xml_node =
    inl nodes forall r. (f : x_manifest_type_field r) (v : r) : list xml.xml_node =
        match f with
        | ManifestType_field_ds_Reference =>
            listm.map (fun v => x_common_basic_components_2_reference_type_to_xml "ds:Reference" v) v
    inl rec walk (fields : list (exists r. x_manifest_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_manifest_type_get f x)) (walk rest)
        | [] => []
    walk [ exists ManifestType_field_ds_Reference ]

and let x_manifest_type_attributes (x : x_manifest_type) : list (string * string) =
    xml.option_list (optionm.map (fun v => ("Id", v)) x.id)

and let x_manifest_type_to_xml (name : string) (x : x_manifest_type) : xml.xml_node =
    xml.element name (x_manifest_type_attributes x) (x_manifest_type_children x)

and let x_signature_properties_type_children (x : x_signature_properties_type) : list xml.xml_node =
    inl nodes forall r. (f : x_signature_properties_type_field r) (v : r) : list xml.xml_node =
        match f with
        | SignaturePropertiesType_field_ds_SignatureProperty =>
            listm.map (fun v => x_signature_property_type_to_xml "ds:SignatureProperty" v) v
    inl rec walk (fields : list (exists r. x_signature_properties_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_signature_properties_type_get f x)) (walk rest)
        | [] => []
    walk [ exists SignaturePropertiesType_field_ds_SignatureProperty ]

