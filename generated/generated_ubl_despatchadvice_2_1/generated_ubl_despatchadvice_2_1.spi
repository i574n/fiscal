    inl v_despatch_advice_type_code, errors =
        xml_codec.read_optional "cbc:DespatchAdviceTypeCode" x_despatch_advice_type_code_type_of_xml children errors
    inl v_note, errors = xml_codec.read_repeated "cbc:Note" x_note_type_of_xml children errors
    inl v_line_count_numeric, errors =
        xml_codec.read_optional "cbc:LineCountNumeric" x_line_count_numeric_type_of_xml children errors
