union x_consumption_type_field r =
    | ConsumptionType_field_cbc_UtilityStatementTypeCode ::
        x_consumption_type_field (option (x_utility_statement_type_code_type))
    | ConsumptionType_field_cac_MainPeriod :: x_consumption_type_field (option (x_period_type))
    | ConsumptionType_field_cac_AllowanceCharge :: x_consumption_type_field (list (x_allowance_charge_type))
    | ConsumptionType_field_cac_TaxTotal :: x_consumption_type_field (list (x_tax_total_type))
    | ConsumptionType_field_cac_EnergyWaterSupply :: x_consumption_type_field (option (x_energy_water_supply_type))
    | ConsumptionType_field_cac_TelecommunicationsSupply ::
        x_consumption_type_field (option (x_telecommunications_supply_type))
    | ConsumptionType_field_cac_LegalMonetaryTotal :: x_consumption_type_field (x_monetary_total_type)

inl x_consumption_type_get forall r. (f : x_consumption_type_field r) (x' : x_consumption_type) : r =
    inl x = match x' with | Record_x_consumption_type r => r
    match f with
    | ConsumptionType_field_cbc_UtilityStatementTypeCode => x.utility_statement_type_code
    | ConsumptionType_field_cac_MainPeriod => x.main_period
    | ConsumptionType_field_cac_AllowanceCharge => x.allowance_charge
    | ConsumptionType_field_cac_TaxTotal => x.tax_total
    | ConsumptionType_field_cac_EnergyWaterSupply => x.energy_water_supply
    | ConsumptionType_field_cac_TelecommunicationsSupply => x.telecommunications_supply
    | ConsumptionType_field_cac_LegalMonetaryTotal => x.legal_monetary_total

inl x_consumption_type_fields () : list (exists r. x_consumption_type_field r) =
    [
        exists ConsumptionType_field_cbc_UtilityStatementTypeCode
        exists ConsumptionType_field_cac_MainPeriod
        exists ConsumptionType_field_cac_AllowanceCharge
        exists ConsumptionType_field_cac_TaxTotal
        exists ConsumptionType_field_cac_EnergyWaterSupply
        exists ConsumptionType_field_cac_TelecommunicationsSupply
        exists ConsumptionType_field_cac_LegalMonetaryTotal
