and let x_signature_property_type_children (x : x_signature_property_type) : list xml.xml_node =
    inl nodes forall r. (f : x_signature_property_type_field r) (v : r) : list xml.xml_node =
        match f with
        | SignaturePropertyType_field_any => any_content_to v
    inl rec walk (fields : list (exists r. x_signature_property_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_signature_property_type_get f x)) (walk rest)
