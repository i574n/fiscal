            [ x_attribute_id_type_to_xml "cbc:AttributeID" v ]
        | CommonAggregateComponents_2_ConditionType_field_cbc_Measure =>
            xml.option_list (optionm.map (fun v => x_common_basic_components_2_measure_type_to_xml "cbc:Measure" v) v)
        | CommonAggregateComponents_2_ConditionType_field_cbc_Description =>
            listm.map (fun v => x_description_type_to_xml "cbc:Description" v) v
        | CommonAggregateComponents_2_ConditionType_field_cbc_MinimumMeasure =>
            xml.option_list (optionm.map (fun v => x_minimum_measure_type_to_xml "cbc:MinimumMeasure" v) v)
        | CommonAggregateComponents_2_ConditionType_field_cbc_MaximumMeasure =>
            xml.option_list (optionm.map (fun v => x_maximum_measure_type_to_xml "cbc:MaximumMeasure" v) v)
    inl rec walk
        (fields : list (exists r. x_common_aggregate_components_2_condition_type_field r))
        : list xml.xml_node
        =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_common_aggregate_components_2_condition_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists CommonAggregateComponents_2_ConditionType_field_cbc_AttributeID
        exists CommonAggregateComponents_2_ConditionType_field_cbc_Measure
        exists CommonAggregateComponents_2_ConditionType_field_cbc_Description
        exists CommonAggregateComponents_2_ConditionType_field_cbc_MinimumMeasure
        exists CommonAggregateComponents_2_ConditionType_field_cbc_MaximumMeasure
    ]

and let x_common_aggregate_components_2_condition_type_attributes
    (x : x_common_aggregate_components_2_condition_type)
    : list (string * string)
    =
    []

and let x_common_aggregate_components_2_condition_type_to_xml
    (name : string) (x : x_common_aggregate_components_2_condition_type)
    : xml.xml_node
    =
    xml.element name
        (x_common_aggregate_components_2_condition_type_attributes x)
        (x_common_aggregate_components_2_condition_type_children x)

