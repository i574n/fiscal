and let x_winning_party_type_to_xml (name : string) (x : x_winning_party_type) : xml.xml_node =
    xml.element name (x_winning_party_type_attributes x) (x_winning_party_type_children x)

and let x_work_phase_reference_type_children (x' : x_work_phase_reference_type) : list xml.xml_node =
    inl x = match x' with | Record_x_work_phase_reference_type r => r
    inl nodes forall r. (f : x_work_phase_reference_type_field r) (v : r) : list xml.xml_node =
        match f with
        | WorkPhaseReferenceType_field_cbc_ID => xml.option_list (optionm.map (fun v => x_id_type_to_xml "cbc:ID" v) v)
        | WorkPhaseReferenceType_field_cbc_WorkPhaseCode =>
            xml.option_list (optionm.map (fun v => x_work_phase_code_type_to_xml "cbc:WorkPhaseCode" v) v)
        | WorkPhaseReferenceType_field_cbc_WorkPhase =>
            listm.map (fun v => x_work_phase_type_to_xml "cbc:WorkPhase" v) v
        | WorkPhaseReferenceType_field_cbc_ProgressPercent =>
            xml.option_list (optionm.map (fun v => x_progress_percent_type_to_xml "cbc:ProgressPercent" v) v)
        | WorkPhaseReferenceType_field_cbc_StartDate =>
            xml.option_list (optionm.map (fun v => x_start_date_type_to_xml "cbc:StartDate" v) v)
        | WorkPhaseReferenceType_field_cbc_EndDate =>
            xml.option_list (optionm.map (fun v => x_end_date_type_to_xml "cbc:EndDate" v) v)
        | WorkPhaseReferenceType_field_cac_WorkOrderDocumentReference =>
            listm.map (fun v => x_document_reference_type_to_xml "cac:WorkOrderDocumentReference" v) v
    inl rec walk (fields : list (exists r. x_work_phase_reference_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_work_phase_reference_type_get f x')) (walk rest)
        | [] => []
    walk [
        exists WorkPhaseReferenceType_field_cbc_ID
        exists WorkPhaseReferenceType_field_cbc_WorkPhaseCode
        exists WorkPhaseReferenceType_field_cbc_WorkPhase
        exists WorkPhaseReferenceType_field_cbc_ProgressPercent
        exists WorkPhaseReferenceType_field_cbc_StartDate
        exists WorkPhaseReferenceType_field_cbc_EndDate
        exists WorkPhaseReferenceType_field_cac_WorkOrderDocumentReference
    ]

and let x_work_phase_reference_type_attributes (x' : x_work_phase_reference_type) : list (string * string) =
    inl x = match x' with | Record_x_work_phase_reference_type r => r
    []

and let x_work_phase_reference_type_to_xml (name : string) (x : x_work_phase_reference_type) : xml.xml_node =
    xml.element name (x_work_phase_reference_type_attributes x) (x_work_phase_reference_type_children x)

