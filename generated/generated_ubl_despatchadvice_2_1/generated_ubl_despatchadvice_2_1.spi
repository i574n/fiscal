and let x_activity_data_line_type_children (x' : x_activity_data_line_type) : list xml.xml_node =
    inl x = match x' with | Record_x_activity_data_line_type r => r
    inl nodes forall r. (f : x_activity_data_line_type_field r) (v : r) : list xml.xml_node =
        match f with
        | ActivityDataLineType_field_cbc_ID => [ x_id_type_to_xml "cbc:ID" v ]
        | ActivityDataLineType_field_cbc_SupplyChainActivityTypeCode =>
            [ x_supply_chain_activity_type_code_type_to_xml "cbc:SupplyChainActivityTypeCode" v ]
        | ActivityDataLineType_field_cac_BuyerCustomerParty =>
            xml.option_list (optionm.map (fun v => x_customer_party_type_to_xml "cac:BuyerCustomerParty" v) v)
        | ActivityDataLineType_field_cac_SellerSupplierParty =>
            xml.option_list (optionm.map (fun v => x_supplier_party_type_to_xml "cac:SellerSupplierParty" v) v)
        | ActivityDataLineType_field_cac_ActivityPeriod =>
            xml.option_list (optionm.map (fun v => x_period_type_to_xml "cac:ActivityPeriod" v) v)
        | ActivityDataLineType_field_cac_ActivityOriginLocation =>
            [ x_common_aggregate_components_2_location_type_to_xml "cac:ActivityOriginLocation" v ]
        | ActivityDataLineType_field_cac_ActivityFinalLocation =>
            xml.option_list (
                optionm.map
                    fun v => x_common_aggregate_components_2_location_type_to_xml "cac:ActivityFinalLocation" v
                    v
            )
        | ActivityDataLineType_field_cac_SalesItem => listm.map (fun v => x_sales_item_type_to_xml "cac:SalesItem" v) v
    inl rec walk (fields : list (exists r. x_activity_data_line_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_activity_data_line_type_get f x')) (walk rest)
        | [] => []
    walk [
        exists ActivityDataLineType_field_cbc_ID
        exists ActivityDataLineType_field_cbc_SupplyChainActivityTypeCode
        exists ActivityDataLineType_field_cac_BuyerCustomerParty
        exists ActivityDataLineType_field_cac_SellerSupplierParty
        exists ActivityDataLineType_field_cac_ActivityPeriod
        exists ActivityDataLineType_field_cac_ActivityOriginLocation
        exists ActivityDataLineType_field_cac_ActivityFinalLocation
        exists ActivityDataLineType_field_cac_SalesItem
    ]

and let x_activity_data_line_type_attributes (x' : x_activity_data_line_type) : list (string * string) =
    inl x = match x' with | Record_x_activity_data_line_type r => r
    []

