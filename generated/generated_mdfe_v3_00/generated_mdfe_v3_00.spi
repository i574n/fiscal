nominal private x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe = string

inl x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_is_valid (s : string) : bool =
    xsd_regex.table_matches (xsd_pattern_b81a9d0c_119_table ()) s
    && xml.code_point_count s >= 50
    && xml.code_point_count s <= 1000

inl x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_of_string (s : string) : option x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe =
    if x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_is_valid s then Some (x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe s) else None

inl x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_to_string (x : x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe) : string =
    match x with x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe s => s

instance to_text x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe = fun x => x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_to_string x
inl x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_example (_ : i32) : x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe =
    x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe "HTTP://?chMDFe=00000000000000000000000000000000000000000000&tpAmb=1"

inl x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_example_text (k : i32) : string =
    x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_to_string (x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe_example k)

type x_tmd_fe_inf_md_fe_supl =
    {
        qr_cod_md_fe : x_tmd_fe_inf_md_fe_supl_qr_cod_md_fe
    }

type x_tmd_fe s =
    {
        inf_md_fe : x_tmd_fe_inf_md_fe
        inf_md_fe_supl : option (x_tmd_fe_inf_md_fe_supl)
        signature : staged s x_signature_type
    }

type x_t_envi_md_fe s =
    {
        id_lote : x_t_id_lote
        md_fe : x_tmd_fe s
        versao : x_t_ver_m_de
    }

