    inl nodes forall r. (f : x_x509_data_type_field r) (v : r) : list xml.xml_node =
        match f with
        | X509DataType_field_X509Certificate => [ xml.element "X509Certificate" [] (xml.text_children v) ]
    inl rec walk (fields : list (exists r. x_x509_data_type_field r)) : list xml.xml_node =
        match fields with
