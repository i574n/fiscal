    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tmd_fe_inf_md_fe_emit_choice_cnpj
    =
    if false then failwith "unreachable"
    elif xml.has_child "CNPJ" children then
        TMDFe_infMDFe_emit_choice_CNPJ_CNPJ (
            (fun c => xml.required_value "x_t_cnpj" (x_t_cnpj_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CNPJ" children)
        )
    elif xml.has_child "CPF" children then
        TMDFe_infMDFe_emit_choice_CNPJ_CPF (
            (fun c => xml.required_value "x_t_cpf" (x_t_cpf_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "CPF" children)
        )
    else failwith "x_tmd_fe_inf_md_fe_emit_choice_cnpj: no alternative present"

