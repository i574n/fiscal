    xml.element name (x_reference_type_digest_method_attributes x) (x_reference_type_digest_method_children x)

and let x_transforms_type_children (x : x_transforms_type) : list xml.xml_node =
    inl nodes forall r. (f : x_transforms_type_field r) (v : r) : list xml.xml_node =
        match f with
        | TransformsType_field_Transform => listm.map (fun v => x_transform_type_to_xml "Transform" v) v
    inl rec walk (fields : list (exists r. x_transforms_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_transforms_type_get f x)) (walk rest)
        | [] => []
    walk [ exists TransformsType_field_Transform ]

and let x_transforms_type_attributes (x : x_transforms_type) : list (string * string) = []

and let x_transforms_type_to_xml (name : string) (x : x_transforms_type) : xml.xml_node =
    xml.element name (x_transforms_type_attributes x) (x_transforms_type_children x)

and let x_transform_type_children (x : x_transform_type) : list xml.xml_node =
    inl nodes forall r. (f : x_transform_type_field r) (v : r) : list xml.xml_node =
        match f with
        | TransformType_field_XPath => [ xml.element "XPath" [] (xml.text_children v) ]
    inl rec walk (fields : list (exists r. x_transform_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_transform_type_get f x)) (walk rest)
        | [] => []
    walk [ exists TransformType_field_XPath ]

and let x_transform_type_attributes (x : x_transform_type) : list (string * string) =
    [ ("Algorithm", to_text x.algorithm) ]

and let x_transform_type_to_xml (name : string) (x : x_transform_type) : xml.xml_node =
    xml.element name (x_transform_type_attributes x) (x_transform_type_children x)

and let x_key_info_type_children (x : x_key_info_type) : list xml.xml_node =
    inl nodes forall r. (f : x_key_info_type_field r) (v : r) : list xml.xml_node =
        match f with
        | KeyInfoType_field_X509Data => [ x_x509_data_type_to_xml "X509Data" v ]
    inl rec walk (fields : list (exists r. x_key_info_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_key_info_type_get f x)) (walk rest)
        | [] => []
    walk [ exists KeyInfoType_field_X509Data ]

and let x_key_info_type_attributes (x : x_key_info_type) : list (string * string) =
    xml.option_list (optionm.map (fun v => ("Id", v)) x.id)

and let x_key_info_type_to_xml (name : string) (x : x_key_info_type) : xml.xml_node =
    xml.element name (x_key_info_type_attributes x) (x_key_info_type_children x)

