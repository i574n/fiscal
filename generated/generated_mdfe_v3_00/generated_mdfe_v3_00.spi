and let x_tmd_fe_children forall s. (x : x_tmd_fe s) : list xml.xml_node =
    listm.concat [
        [ x_tmd_fe_inf_md_fe_to_xml "infMDFe" x.inf_md_fe ]
        xml.option_list (optionm.map (fun v => x_tmd_fe_inf_md_fe_supl_to_xml "infMDFeSupl" v) x.inf_md_fe_supl)
        staged_list (fun v => x_signature_type_to_xml "ds:Signature" v) x.signature
    ]

and let x_tmd_fe_attributes forall s. (x : x_tmd_fe s) : list (string * string) = []

and let x_tmd_fe_to_xml forall s. (name : string) (x : x_tmd_fe s) : xml.xml_node =
    xml.element name (x_tmd_fe_attributes x) (x_tmd_fe_children x)

and let x_tmd_fe_inf_md_fe_supl_children (x : x_tmd_fe_inf_md_fe_supl) : list xml.xml_node =
    inl nodes forall r. (f : x_tmd_fe_inf_md_fe_supl_field r) (v : r) : list xml.xml_node =
        match f with
        | TMDFe_infMDFeSupl_field_qrCodMDFe => [ text_node "qrCodMDFe" v ]
    inl rec walk (fields : list (exists r. x_tmd_fe_inf_md_fe_supl_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tmd_fe_inf_md_fe_supl_get f x)) (walk rest)
        | [] => []
    walk [ exists TMDFe_infMDFeSupl_field_qrCodMDFe ]

and let x_tmd_fe_inf_md_fe_supl_attributes (x : x_tmd_fe_inf_md_fe_supl) : list (string * string) = []

and let x_tmd_fe_inf_md_fe_supl_to_xml (name : string) (x : x_tmd_fe_inf_md_fe_supl) : xml.xml_node =
    xml.element name (x_tmd_fe_inf_md_fe_supl_attributes x) (x_tmd_fe_inf_md_fe_supl_children x)

and let x_tmd_fe_inf_md_fe_children (x : x_tmd_fe_inf_md_fe) : list xml.xml_node =
    inl nodes forall r. (f : x_tmd_fe_inf_md_fe_field r) (v : r) : list xml.xml_node =
        match f with
        | TMDFe_infMDFe_field_ide => [ x_tmd_fe_inf_md_fe_ide_to_xml "ide" v ]
        | TMDFe_infMDFe_field_emit => [ x_tmd_fe_inf_md_fe_emit_to_xml "emit" v ]
        | TMDFe_infMDFe_field_infModal => [ x_tmd_fe_inf_md_fe_inf_modal_to_xml "infModal" v ]
        | TMDFe_infMDFe_field_infDoc => [ x_tmd_fe_inf_md_fe_inf_doc_to_xml "infDoc" v ]
        | TMDFe_infMDFe_field_seg => listm.map (fun v => x_tmd_fe_inf_md_fe_seg_to_xml "seg" v) v
        | TMDFe_infMDFe_field_prodPred =>
            xml.option_list (optionm.map (fun v => x_tmd_fe_inf_md_fe_prod_pred_to_xml "prodPred" v) v)
        | TMDFe_infMDFe_field_tot => [ x_tmd_fe_inf_md_fe_tot_to_xml "tot" v ]
        | TMDFe_infMDFe_field_lacres => listm.map (fun v => x_tmd_fe_inf_md_fe_lacres_to_xml "lacres" v) v
        | TMDFe_infMDFe_field_autXML => listm.map (fun v => x_tmd_fe_inf_md_fe_aut_xml_to_xml "autXML" v) v
        | TMDFe_infMDFe_field_infAdic =>
            xml.option_list (optionm.map (fun v => x_tmd_fe_inf_md_fe_inf_adic_to_xml "infAdic" v) v)
        | TMDFe_infMDFe_field_infRespTec =>
            xml.option_list (optionm.map (fun v => x_t_resp_tec_to_xml "infRespTec" v) v)
        | TMDFe_infMDFe_field_infSolicNFF =>
            xml.option_list (optionm.map (fun v => x_tmd_fe_inf_md_fe_inf_solic_nff_to_xml "infSolicNFF" v) v)
        | TMDFe_infMDFe_field_infPAA =>
            xml.option_list (optionm.map (fun v => x_tmd_fe_inf_md_fe_inf_paa_to_xml "infPAA" v) v)
    inl rec walk (fields : list (exists r. x_tmd_fe_inf_md_fe_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_tmd_fe_inf_md_fe_get f x)) (walk rest)
        | [] => []
    walk [
        exists TMDFe_infMDFe_field_ide
        exists TMDFe_infMDFe_field_emit
        exists TMDFe_infMDFe_field_infModal
        exists TMDFe_infMDFe_field_infDoc
        exists TMDFe_infMDFe_field_seg
        exists TMDFe_infMDFe_field_prodPred
        exists TMDFe_infMDFe_field_tot
        exists TMDFe_infMDFe_field_lacres
        exists TMDFe_infMDFe_field_autXML
        exists TMDFe_infMDFe_field_infAdic
        exists TMDFe_infMDFe_field_infRespTec
        exists TMDFe_infMDFe_field_infSolicNFF
        exists TMDFe_infMDFe_field_infPAA
    ]

and let x_tmd_fe_inf_md_fe_attributes (x : x_tmd_fe_inf_md_fe) : list (string * string) =
    listm.concat [ [ ("versao", to_text x.versao) ]; [ ("Id", to_text x.id) ] ]

and let x_tmd_fe_inf_md_fe_to_xml (name : string) (x : x_tmd_fe_inf_md_fe) : xml.xml_node =
    xml.element name (x_tmd_fe_inf_md_fe_attributes x) (x_tmd_fe_inf_md_fe_children x)

