inl x_currency_currency_code_is_valid (s : string) : bool = (xsd_pattern_6cc986d0_763 0i32 s 0i32)

inl x_currency_currency_code_of_string (s : string) : option x_currency_currency_code =
    if x_currency_currency_code_is_valid s then Some (x_currency_currency_code s) else None

inl x_currency_currency_code_to_string (x : x_currency_currency_code) : string =
    match x with x_currency_currency_code s => s

instance to_text x_currency_currency_code = fun x => x_currency_currency_code_to_string x
inl x_currency_currency_code_example (_ : i32) : x_currency_currency_code = x_currency_currency_code "AED"

inl x_currency_currency_code_example_text (k : i32) : string =
    x_currency_currency_code_to_string (x_currency_currency_code_example k)

type x_currency =
    {
        currency_code : x_currency_currency_code
        currency_amount : x_sa_fmonetary_type
        exchange_rate : x_sa_fdecimal_type
