union x_audit_file_field r =
    | AuditFile_field_Header :: x_audit_file_field (x_audit_file_header)
    | AuditFile_field_MasterFiles :: x_audit_file_field (x_audit_file_master_files)
    | AuditFile_field_GeneralLedgerEntries :: x_audit_file_field (option (x_audit_file_general_ledger_entries))
    | AuditFile_field_SourceDocuments :: x_audit_file_field (option (x_audit_file_source_documents))

inl x_audit_file_get forall r. (f : x_audit_file_field r) (x : x_audit_file) : r =
    match f with
    | AuditFile_field_Header => x.header
    | AuditFile_field_MasterFiles => x.master_files
    | AuditFile_field_GeneralLedgerEntries => x.general_ledger_entries
    | AuditFile_field_SourceDocuments => x.source_documents

union x_audit_file_source_documents_field r =
    | AuditFile_SourceDocuments_field_SalesInvoices ::
