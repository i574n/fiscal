let rec x_audit_file_of_children (attributes : list (string * string)) (children : list xml.xml_node) : x_audit_file =
    {
        header = (fun c => x_audit_file_header_of_xml c) (xml.required_child "Header" children)
        master_files = (fun c => x_audit_file_master_files_of_xml c) (xml.required_child "MasterFiles" children)
        general_ledger_entries =
            optionm.map
                fun c => x_audit_file_general_ledger_entries_of_xml c
                (xml.first_child "GeneralLedgerEntries" children)
        source_documents =
            optionm.map (fun c => x_audit_file_source_documents_of_xml c) (xml.first_child "SourceDocuments" children)
    }

