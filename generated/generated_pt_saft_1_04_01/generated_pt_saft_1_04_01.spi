and let x_audit_file_source_documents_payments_payment_line_choice_debit_amount_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_audit_file_source_documents_payments_payment_line_choice_debit_amount
    =
    if false then failwith "unreachable"
    elif xml.has_child "DebitAmount" children then
        AuditFile_SourceDocuments_Payments_Payment_Line_choice_DebitAmount_DebitAmount (
            (fun c => xml.text_in (xml.element_children c)) (xml.required_child "DebitAmount" children)
        )
    elif xml.has_child "CreditAmount" children then
        AuditFile_SourceDocuments_Payments_Payment_Line_choice_DebitAmount_CreditAmount (
            (fun c => xml.text_in (xml.element_children c)) (xml.required_child "CreditAmount" children)
        )
    else failwith "x_audit_file_source_documents_payments_payment_line_choice_debit_amount: no alternative present"

