            (fun c => xml.required_value "x_tax_tax_type" (x_tax_tax_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "TaxType" children)
        tax_country_region =
            (fun c => xml.required_value "x_tax_tax_country_region" (x_tax_tax_country_region_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "TaxCountryRegion" children)
        tax_code =
            (fun c => xml.required_value "x_tax_tax_code" (x_tax_tax_code_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "TaxCode" children)
        choice_tax_percentage = x_tax_choice_tax_percentage_of_children attributes children
    }

and let x_tax_of_xml (c : xml.xml_node) : x_tax = x_tax_of_children (xml.element_attributes c) (xml.element_children c)

and let x_tax_choice_tax_percentage_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_tax_choice_tax_percentage
    =
    if false then failwith "unreachable"
    elif xml.has_child "TaxPercentage" children then
        Tax_choice_TaxPercentage_TaxPercentage (
            (fun c => xml.text_in (xml.element_children c)) (xml.required_child "TaxPercentage" children)
        )
    elif xml.has_child "TaxAmount" children then
        Tax_choice_TaxPercentage_TaxAmount (
            (fun c => xml.text_in (xml.element_children c)) (xml.required_child "TaxAmount" children)
        )
    else failwith "x_tax_choice_tax_percentage: no alternative present"

and let x_withholding_tax_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_withholding_tax
    =
    {
        withholding_tax_type =
            optionm.map
                fun c =>
                    xml.required_value "x_withholding_tax_withholding_tax_type" (
                        x_withholding_tax_withholding_tax_type_of_string (xml.text_in (xml.element_children c)))
                (xml.first_child "WithholdingTaxType" children)
        withholding_tax_description =
            optionm.map
                fun c =>
                    xml.required_value "x_safp_ttext_type_mandatory_max60_car" (
                        x_safp_ttext_type_mandatory_max60_car_of_string (xml.text_in (xml.element_children c)))
                (xml.first_child "WithholdingTaxDescription" children)
        withholding_tax_amount =
            (fun c => xml.text_in (xml.element_children c)) (xml.required_child "WithholdingTaxAmount" children)
    }

and let x_withholding_tax_of_xml (c : xml.xml_node) : x_withholding_tax =
    x_withholding_tax_of_children (xml.element_attributes c) (xml.element_children c)

and let x_audit_file_children (x : x_audit_file) : list xml.xml_node =
    inl nodes forall r. (f : x_audit_file_field r) (v : r) : list xml.xml_node =
        match f with
        | AuditFile_field_Header => [ x_audit_file_header_to_xml "Header" v ]
        | AuditFile_field_MasterFiles => [ x_audit_file_master_files_to_xml "MasterFiles" v ]
        | AuditFile_field_GeneralLedgerEntries =>
            xml.option_list (
                optionm.map (fun v => x_audit_file_general_ledger_entries_to_xml "GeneralLedgerEntries" v) v
            )
        | AuditFile_field_SourceDocuments =>
            xml.option_list (optionm.map (fun v => x_audit_file_source_documents_to_xml "SourceDocuments" v) v)
    inl rec walk (fields : list (exists r. x_audit_file_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_audit_file_get f x)) (walk rest)
        | [] => []
    walk [
        exists AuditFile_field_Header
        exists AuditFile_field_MasterFiles
        exists AuditFile_field_GeneralLedgerEntries
        exists AuditFile_field_SourceDocuments
    ]

