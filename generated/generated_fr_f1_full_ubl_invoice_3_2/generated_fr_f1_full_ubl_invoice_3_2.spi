        issue_date = x_issue_date_type_example k
        due_date = None
        invoice_type_code = x_invoice_type_code_type_example k
        note = []
        document_currency_code = x_document_currency_code_type_example k
        invoice_period = None
        billing_reference = []
        accounting_supplier_party = x_supplier_party_type_example k
        accounting_customer_party = x_customer_party_type_example k
        tax_representative_party = None
        delivery = None
        allowance_charge = []
        tax_total = [ x_tax_total_type_example (k + 0i32) ]
        legal_monetary_total = x_monetary_total_type_example k
        invoice_line = [ x_invoice_line_type_example (k + 0i32) ]
    }


