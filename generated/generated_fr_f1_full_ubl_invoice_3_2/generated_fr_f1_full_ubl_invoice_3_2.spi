and let x_invoice_type_of_xml (c : xml.xml_node) : result (x_invoice_type) (list xml_codec.decode_error) =
    x_invoice_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_invoice_type_children (x : x_invoice_type) : list xml.xml_node =
    inl nodes forall r. (f : x_invoice_type_field r) (v : r) : list xml.xml_node =
        match f with
        | InvoiceType_field_cbc_CustomizationID => [ x_customization_id_type_to_xml "cbc:CustomizationID" v ]
        | InvoiceType_field_cbc_ProfileID => [ x_profile_id_type_to_xml "cbc:ProfileID" v ]
        | InvoiceType_field_cbc_ID => [ x_id_type_to_xml "cbc:ID" v ]
        | InvoiceType_field_cbc_IssueDate => [ x_issue_date_type_to_xml "cbc:IssueDate" v ]
        | InvoiceType_field_cbc_DueDate =>
            xml.option_list (optionm.map (fun v => x_due_date_type_to_xml "cbc:DueDate" v) v)
        | InvoiceType_field_cbc_InvoiceTypeCode => [ x_invoice_type_code_type_to_xml "cbc:InvoiceTypeCode" v ]
        | InvoiceType_field_cbc_Note => listm.map (fun v => x_note_type_to_xml "cbc:Note" v) v
        | InvoiceType_field_cbc_DocumentCurrencyCode =>
            [ x_document_currency_code_type_to_xml "cbc:DocumentCurrencyCode" v ]
        | InvoiceType_field_cac_InvoicePeriod =>
            xml.option_list (optionm.map (fun v => x_period_type_to_xml "cac:InvoicePeriod" v) v)
        | InvoiceType_field_cac_BillingReference =>
            listm.map (fun v => x_billing_reference_type_to_xml "cac:BillingReference" v) v
        | InvoiceType_field_cac_AccountingSupplierParty =>
            [ x_supplier_party_type_to_xml "cac:AccountingSupplierParty" v ]
        | InvoiceType_field_cac_AccountingCustomerParty =>
            [ x_customer_party_type_to_xml "cac:AccountingCustomerParty" v ]
        | InvoiceType_field_cac_TaxRepresentativeParty =>
            xml.option_list (optionm.map (fun v => x_party_type_to_xml "cac:TaxRepresentativeParty" v) v)
        | InvoiceType_field_cac_Delivery =>
            xml.option_list (optionm.map (fun v => x_delivery_type_to_xml "cac:Delivery" v) v)
        | InvoiceType_field_cac_AllowanceCharge =>
            listm.map (fun v => x_allowance_charge_type_to_xml "cac:AllowanceCharge" v) v
        | InvoiceType_field_cac_TaxTotal => listm.map (fun v => x_tax_total_type_to_xml "cac:TaxTotal" v) v
        | InvoiceType_field_cac_LegalMonetaryTotal => [ x_monetary_total_type_to_xml "cac:LegalMonetaryTotal" v ]
        | InvoiceType_field_cac_InvoiceLine => listm.map (fun v => x_invoice_line_type_to_xml "cac:InvoiceLine" v) v
    inl rec walk (fields : list (exists r. x_invoice_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_invoice_type_get f x)) (walk rest)
        | [] => []
    walk [
        exists InvoiceType_field_cbc_CustomizationID
        exists InvoiceType_field_cbc_ProfileID
        exists InvoiceType_field_cbc_ID
        exists InvoiceType_field_cbc_IssueDate
        exists InvoiceType_field_cbc_DueDate
        exists InvoiceType_field_cbc_InvoiceTypeCode
        exists InvoiceType_field_cbc_Note
        exists InvoiceType_field_cbc_DocumentCurrencyCode
        exists InvoiceType_field_cac_InvoicePeriod
        exists InvoiceType_field_cac_BillingReference
        exists InvoiceType_field_cac_AccountingSupplierParty
        exists InvoiceType_field_cac_AccountingCustomerParty
        exists InvoiceType_field_cac_TaxRepresentativeParty
        exists InvoiceType_field_cac_Delivery
        exists InvoiceType_field_cac_AllowanceCharge
        exists InvoiceType_field_cac_TaxTotal
        exists InvoiceType_field_cac_LegalMonetaryTotal
        exists InvoiceType_field_cac_InvoiceLine
    ]

and let x_invoice_type_attributes (x : x_invoice_type) : list (string * string) = []

and let x_invoice_type_to_xml (name : string) (x : x_invoice_type) : xml.xml_node =
    xml.element name (x_invoice_type_attributes x) (x_invoice_type_children x)

