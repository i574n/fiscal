let rec x_2_text_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_2_text_type) (list xml_codec.decode_error)
    =
    inl errors = []
    inl v_base, errors = xml.text_in children, errors
    inl v_language_id, errors = xml.attribute_of "languageID" attributes, errors
    inl v_language_locale_id, errors = xml.attribute_of "languageLocaleID" attributes, errors
    xml_codec.decoded_by errors fun () =>
        x_2_text_type { base = v_base; language_id = v_language_id; language_locale_id = v_language_locale_id }

and let x_2_text_type_of_xml (c : xml.xml_node) : result (x_2_text_type) (list xml_codec.decode_error) =
    x_2_text_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_2_text_type_children (x : x_2_text_type) : list xml.xml_node =
    inl nodes forall r. (f : x_2_text_type_field r) (v : r) : list xml.xml_node =
        match f with
        | X2_TextType_field_base => xml.text_children v
    inl rec walk (fields : list (exists r. x_2_text_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_2_text_type_get f x)) (walk rest)
        | [] => []
    walk [ exists X2_TextType_field_base ]

and let x_2_text_type_attributes (x : x_2_text_type) : list (string * string) =
    listm.concat [
        xml.option_list (optionm.map (fun v => "languageID", v) x.language_id)
        xml.option_list (optionm.map (fun v => "languageLocaleID", v) x.language_locale_id)
    ]

and let x_2_text_type_to_xml (name : string) (x : x_2_text_type) : xml.xml_node =
    xml.element name (x_2_text_type_attributes x) (x_2_text_type_children x)

and let x_2_text_type_example (k : i32) : x_2_text_type =
    x_2_text_type {
        base = "1"
        language_id = None
        language_locale_id = None
    }


let rec x_2_quantity_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_2_quantity_type) (list xml_codec.decode_error)
    =
    inl errors = []
    inl o_base, errors = xml_codec.taken (xml_codec.parsed_text xsd_decimal_of_string (xml.text_in children)) errors
    inl v_unit_code, errors = xml_codec.attribute_required "unitCode" attributes errors
    inl v_unit_code_list_id, errors = xml.attribute_of "unitCodeListID" attributes, errors
    inl v_unit_code_list_agency_id, errors = xml.attribute_of "unitCodeListAgencyID" attributes, errors
    inl v_unit_code_list_agency_name, errors = xml.attribute_of "unitCodeListAgencyName" attributes, errors
    xml_codec.decoded_by errors fun () =>
        x_2_quantity_type {
            base = xml_codec.present o_base
            unit_code = v_unit_code
            unit_code_list_id = v_unit_code_list_id
            unit_code_list_agency_id = v_unit_code_list_agency_id
            unit_code_list_agency_name = v_unit_code_list_agency_name
        }

and let x_2_quantity_type_of_xml (c : xml.xml_node) : result (x_2_quantity_type) (list xml_codec.decode_error) =
    x_2_quantity_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_2_quantity_type_children (x : x_2_quantity_type) : list xml.xml_node =
    inl nodes forall r. (f : x_2_quantity_type_field r) (v : r) : list xml.xml_node =
        match f with
        | X2_QuantityType_field_base => xml.text_children (to_text v)
    inl rec walk (fields : list (exists r. x_2_quantity_type_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_2_quantity_type_get f x)) (walk rest)
        | [] => []
    walk [ exists X2_QuantityType_field_base ]

and let x_2_quantity_type_attributes (x : x_2_quantity_type) : list (string * string) =
    listm.concat [
        [ ("unitCode", x.unit_code) ]
        xml.option_list (optionm.map (fun v => "unitCodeListID", v) x.unit_code_list_id)
