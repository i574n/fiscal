    | PaymentsReportType_Transactions_Payment_field_SubTotals => { tag = "SubTotals"; min = 1i32; max = None }

union x_payments_report_type_transactions_payment_sub_totals_field r =
    | PaymentsReportType_Transactions_Payment_SubTotals_field_TaxPercent ::
        x_payments_report_type_transactions_payment_sub_totals_field (xsd_decimal)
    | PaymentsReportType_Transactions_Payment_SubTotals_field_CurrencyCode ::
