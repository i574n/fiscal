nominal x_report_type =
    {
        report_document : x_report_document_type
        transactions_report : option (x_transactions_report_type)
        payments_report : option (x_payments_report_type)
    }

union x_report_type_field r =
    | ReportType_field_ReportDocument :: x_report_type_field (x_report_document_type)
    | ReportType_field_TransactionsReport :: x_report_type_field (option (x_transactions_report_type))
    | ReportType_field_PaymentsReport :: x_report_type_field (option (x_payments_report_type))

inl x_report_type_get forall r. (f : x_report_type_field r) (x : x_report_type) : r =
    match f with
    | ReportType_field_ReportDocument => x.report_document
    | ReportType_field_TransactionsReport => x.transactions_report
    | ReportType_field_PaymentsReport => x.payments_report

inl x_report_type_fields () : list (exists r. x_report_type_field r) =
    [
        exists ReportType_field_ReportDocument
        exists ReportType_field_TransactionsReport
        exists ReportType_field_PaymentsReport
    ]
inl x_report_type_field_meta forall r. (f : x_report_type_field r) : xml_codec.field_meta =
    match f with
    | ReportType_field_ReportDocument => { tag = "ReportDocument"; min = 1i32; max = Some 1i32 }
    | ReportType_field_TransactionsReport => { tag = "TransactionsReport"; min = 0i32; max = Some 1i32 }
    | ReportType_field_PaymentsReport => { tag = "PaymentsReport"; min = 0i32; max = Some 1i32 }

union x_payments_report_type_field r =
    | PaymentsReportType_field_ReportPeriod :: x_payments_report_type_field (x_payments_report_type_report_period)
    | PaymentsReportType_field_Invoice :: x_payments_report_type_field (list (x_payments_report_type_invoice))
    | PaymentsReportType_field_Transactions :: x_payments_report_type_field (list (x_payments_report_type_transactions))

inl x_payments_report_type_get forall r. (f : x_payments_report_type_field r) (x : x_payments_report_type) : r =
    match f with
    | PaymentsReportType_field_ReportPeriod => x.report_period
    | PaymentsReportType_field_Invoice => x.invoice
    | PaymentsReportType_field_Transactions => x.transactions

inl x_payments_report_type_fields () : list (exists r. x_payments_report_type_field r) =
    [
        exists PaymentsReportType_field_ReportPeriod
        exists PaymentsReportType_field_Invoice
        exists PaymentsReportType_field_Transactions
    ]
inl x_payments_report_type_field_meta forall r. (f : x_payments_report_type_field r) : xml_codec.field_meta =
    match f with
    | PaymentsReportType_field_ReportPeriod => { tag = "ReportPeriod"; min = 1i32; max = Some 1i32 }
    | PaymentsReportType_field_Invoice => { tag = "Invoice"; min = 0i32; max = None }
    | PaymentsReportType_field_Transactions => { tag = "Transactions"; min = 0i32; max = None }

union x_payments_report_type_transactions_field r =
    | PaymentsReportType_Transactions_field_Payment ::
        x_payments_report_type_transactions_field (x_payments_report_type_transactions_payment)

inl x_payments_report_type_transactions_get forall r.
    (f : x_payments_report_type_transactions_field r) (x : x_payments_report_type_transactions)
    : r
    =
    match f with
    | PaymentsReportType_Transactions_field_Payment => x.payment

inl x_payments_report_type_transactions_fields () : list (exists r. x_payments_report_type_transactions_field r) =
    [ exists PaymentsReportType_Transactions_field_Payment ]
inl x_payments_report_type_transactions_field_meta forall r.
    (f : x_payments_report_type_transactions_field r)
    : xml_codec.field_meta
    =
    match f with
    | PaymentsReportType_Transactions_field_Payment => { tag = "Payment"; min = 1i32; max = Some 1i32 }

union x_payments_report_type_transactions_payment_field r =
    | PaymentsReportType_Transactions_Payment_field_Date :: x_payments_report_type_transactions_payment_field (string)
    | PaymentsReportType_Transactions_Payment_field_SubTotals ::
        x_payments_report_type_transactions_payment_field
            (list (x_payments_report_type_transactions_payment_sub_totals))

inl x_payments_report_type_transactions_payment_get forall r.
    (f : x_payments_report_type_transactions_payment_field r) (x : x_payments_report_type_transactions_payment)
