    =
    match f with
    | PaymentsReportType_Transactions_Payment_field_Date => x.date
    | PaymentsReportType_Transactions_Payment_field_SubTotals => x.sub_totals

inl x_payments_report_type_transactions_payment_fields
    ()
    : list (exists r. x_payments_report_type_transactions_payment_field r)
    =
    [
        exists PaymentsReportType_Transactions_Payment_field_Date
        exists PaymentsReportType_Transactions_Payment_field_SubTotals
