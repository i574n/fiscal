    (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_account_type_choice_branch_in_spain_address) (list xml_codec.decode_error)
    =
    if false then xml_codec.no_alternative "x_account_type_choice_branch_in_spain_address"
    elif xml.has_child "BranchInSpainAddress" children then
        xml_codec.mapped
            fun v => AccountType_choice_BranchInSpainAddress_BranchInSpainAddress v
            (xml_codec.pair_decoded (xml_codec.read_optional "BranchInSpainAddress" x_address_type_of_xml children []))
    elif xml.has_child "OverseasBranchAddress" children then
        xml_codec.mapped
            fun v => AccountType_choice_BranchInSpainAddress_OverseasBranchAddress v
            (
                xml_codec.pair_decoded (
                    xml_codec.read_optional "OverseasBranchAddress" x_overseas_address_type_of_xml children []
                )
            )
    else
        xml_codec.mapped
            fun v => AccountType_choice_BranchInSpainAddress_BranchInSpainAddress v
            (xml_codec.pair_decoded (xml_codec.read_optional "BranchInSpainAddress" x_address_type_of_xml children []))

