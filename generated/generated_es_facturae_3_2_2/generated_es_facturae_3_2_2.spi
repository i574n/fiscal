and let x_facturae_children (x : x_facturae) : list xml.xml_node =
    inl nodes forall r. (f : x_facturae_field r) (v : r) : list xml.xml_node =
        match f with
        | Facturae_field_FileHeader => [ x_file_header_type_to_xml "FileHeader" v ]
        | Facturae_field_Parties => [ x_parties_type_to_xml "Parties" v ]
        | Facturae_field_Invoices => [ x_invoices_type_to_xml "Invoices" v ]
        | Facturae_field_Extensions =>
            xml.option_list (optionm.map (fun v => x_extensions_type_to_xml "Extensions" v) v)
        | Facturae_field_ds_Signature =>
            xml.option_list (optionm.map (fun v => x_signature_type_to_xml "ds:Signature" v) v)
    inl rec walk (fields : list (exists r. x_facturae_field r)) : list xml.xml_node =
        match fields with
        | packed :: rest =>
            inl exists r. f = packed
            listm.append (nodes f (x_facturae_get f x)) (walk rest)
        | [] => []
    walk [
        exists Facturae_field_FileHeader
        exists Facturae_field_Parties
        exists Facturae_field_Invoices
        exists Facturae_field_Extensions
        exists Facturae_field_ds_Signature
    ]

and let x_facturae_attributes (x : x_facturae) : list (string * string) = []

and let x_facturae_to_xml (name : string) (x : x_facturae) : xml.xml_node =
    xml.element name (x_facturae_attributes x) (x_facturae_children x)

and let x_file_header_type_children (x : x_file_header_type) : list xml.xml_node =
    inl nodes forall r. (f : x_file_header_type_field r) (v : r) : list xml.xml_node =
        match f with
        | FileHeaderType_field_SchemaVersion => [ text_node "SchemaVersion" v ]
