    =
    if false then xml_codec.no_alternative "x_account_type_choice_iban"
    elif xml.has_child "IBAN" children then
        xml_codec.mapped
            fun v => AccountType_choice_IBAN_IBAN v
            (xml_codec.read_child "IBAN" (xml_codec.read_value x_text_min5_max34_type_of_string) children)
    elif xml.has_child "AccountNumber" children then
