    {
        batch_identifier =
            (fun c => xml.required_value "x_text_max70_type" (x_text_max70_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "BatchIdentifier" children)
        invoices_count = (fun c => xml.text_in (xml.element_children c)) (xml.required_child "InvoicesCount" children)
        total_invoices_amount = (fun c => x_amount_type_of_xml c) (xml.required_child "TotalInvoicesAmount" children)
        total_outstanding_amount =
            (fun c => x_amount_type_of_xml c) (xml.required_child "TotalOutstandingAmount" children)
        total_executable_amount =
            (fun c => x_amount_type_of_xml c) (xml.required_child "TotalExecutableAmount" children)
        invoice_currency_code =
            (fun c => xml.required_value "x_currency_code_type" (x_currency_code_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "InvoiceCurrencyCode" children)
    }

