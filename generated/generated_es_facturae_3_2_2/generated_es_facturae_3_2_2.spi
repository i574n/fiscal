let rec x_facturae_of_children (attributes : list (string * string)) (children : list xml.xml_node) : x_facturae =
    {
        file_header = (fun c => x_file_header_type_of_xml c) (xml.required_child "FileHeader" children)
        parties = (fun c => x_parties_type_of_xml c) (xml.required_child "Parties" children)
        invoices = (fun c => x_invoices_type_of_xml c) (xml.required_child "Invoices" children)
        extensions = optionm.map (fun c => x_extensions_type_of_xml c) (xml.first_child "Extensions" children)
        signature = optionm.map (fun c => x_signature_type_of_xml c) (xml.first_child "ds:Signature" children)
    }

and let x_facturae_of_xml (c : xml.xml_node) : x_facturae =
    x_facturae_of_children (xml.element_attributes c) (xml.element_children c)

and let x_file_header_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_file_header_type
    =
    {
        schema_version =
            (fun c => xml.required_value "x_schema_version_type" (x_schema_version_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "SchemaVersion" children)
        modality =
            (fun c => xml.required_value "x_modality_type" (x_modality_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "Modality" children)
        invoice_issuer_type =
            (fun c => xml.required_value "x_invoice_issuer_type_type" (x_invoice_issuer_type_type_of_string (xml.text_in (xml.element_children c)))) (xml.required_child "InvoiceIssuerType" children)
        third_party = optionm.map (fun c => x_third_party_type_of_xml c) (xml.first_child "ThirdParty" children)
        batch = (fun c => x_batch_type_of_xml c) (xml.required_child "Batch" children)
        factoring_assignment_data =
            optionm.map
                fun c => x_factoring_assignment_data_type_of_xml c
                (xml.first_child "FactoringAssignmentData" children)
    }

and let x_file_header_type_of_xml (c : xml.xml_node) : x_file_header_type =
    x_file_header_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_third_party_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_third_party_type
    =
    {
        tax_identification =
            (fun c => x_tax_identification_type_of_xml c) (xml.required_child "TaxIdentification" children)
        choice_legal_entity = x_third_party_type_choice_legal_entity_of_children attributes children
    }

and let x_third_party_type_of_xml (c : xml.xml_node) : x_third_party_type =
    x_third_party_type_of_children (xml.element_attributes c) (xml.element_children c)

and let x_third_party_type_choice_legal_entity_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_third_party_type_choice_legal_entity
    =
    if false then failwith "unreachable"
    elif xml.has_child "LegalEntity" children then
        ThirdPartyType_choice_LegalEntity_LegalEntity (
            (fun c => x_legal_entity_type_of_xml c) (xml.required_child "LegalEntity" children)
        )
    elif xml.has_child "Individual" children then
        ThirdPartyType_choice_LegalEntity_Individual (
            (fun c => x_individual_type_of_xml c) (xml.required_child "Individual" children)
        )
    else failwith "x_third_party_type_choice_legal_entity: no alternative present"

