inl x_language_code_type_example (k : i32) : x_language_code_type =
    inl index = ((k % 8i32) + 8i32) % 8i32
    if index = 0i32 then LanguageCodeType_ar
    elif index = 1i32 then LanguageCodeType_be
    elif index = 2i32 then LanguageCodeType_bg
    elif index = 3i32 then LanguageCodeType_ca
    elif index = 4i32 then LanguageCodeType_cs
    elif index = 5i32 then LanguageCodeType_da
    elif index = 6i32 then LanguageCodeType_de
    else LanguageCodeType_el

inl x_language_code_type_example_text (k : i32) : string =
    x_language_code_type_to_string (x_language_code_type_example k)

