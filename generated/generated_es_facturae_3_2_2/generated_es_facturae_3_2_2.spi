            fun v => AccountType_choice_IBAN_AccountNumber v
            (xml_codec.read_child "AccountNumber" (xml_codec.read_value x_text_min5_max34_type_of_string) children)
    else xml_codec.no_alternative "x_account_type_choice_iban"

