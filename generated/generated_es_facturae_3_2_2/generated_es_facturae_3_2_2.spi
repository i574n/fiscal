let rec xsd_pattern_2c505d98_5 (state : i32) (s : string) (i : i32) : bool =
    if i >= sm'.length s then state = 5i32
    else
        inl c = xml.code_point_at s i
        inl next = i + xml.code_point_width s i
        if state = 0i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2c505d98_5 1i32 s next
            else false
        elif state = 1i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2c505d98_5 2i32 s next
            else false
        elif state = 2i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2c505d98_5 3i32 s next
            else false
        elif state = 3i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2c505d98_5 4i32 s next
            else false
        elif state = 4i32 then
            if 48u32 <= c && c <= 57u32 then xsd_pattern_2c505d98_5 5i32 s next
            else false
        elif state = 5i32 then
            false
        else false

