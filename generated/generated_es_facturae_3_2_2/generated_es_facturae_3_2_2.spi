and let x_legal_entity_type_choice_address_in_spain_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : x_legal_entity_type_choice_address_in_spain
    =
    if false then failwith "unreachable"
    elif xml.has_child "AddressInSpain" children then
        LegalEntityType_choice_AddressInSpain_AddressInSpain (
            (fun c => x_address_type_of_xml c) (xml.required_child "AddressInSpain" children)
        )
    elif xml.has_child "OverseasAddress" children then
        LegalEntityType_choice_AddressInSpain_OverseasAddress (
            (fun c => x_overseas_address_type_of_xml c) (xml.required_child "OverseasAddress" children)
        )
    else failwith "x_legal_entity_type_choice_address_in_spain: no alternative present"

