let rec x_facturae_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_facturae) (list xml_codec.decode_error)
    =
    inl errors = []
    inl o_file_header, errors = xml_codec.read_required "FileHeader" x_file_header_type_of_xml children errors
    inl o_parties, errors = xml_codec.read_required "Parties" x_parties_type_of_xml children errors
    inl o_invoices, errors = xml_codec.read_required "Invoices" x_invoices_type_of_xml children errors
    inl v_extensions, errors = xml_codec.read_optional "Extensions" x_extensions_type_of_xml children errors
    inl v_signature, errors = xml_codec.read_optional "ds:Signature" x_signature_type_of_xml children errors
    xml_codec.decoded_by errors fun () =>
        x_facturae {
            file_header = xml_codec.present o_file_header
            parties = xml_codec.present o_parties
            invoices = xml_codec.present o_invoices
            extensions = v_extensions
            signature = v_signature
        }

and let x_facturae_of_xml (c : xml.xml_node) : result (x_facturae) (list xml_codec.decode_error) =
    x_facturae_of_children (xml.element_attributes c) (xml.element_children c)

and let x_file_header_type_of_children
    (attributes : list (string * string)) (children : list xml.xml_node)
    : result (x_file_header_type) (list xml_codec.decode_error)
    =
    inl errors = []
    inl o_schema_version, errors =
        xml_codec.read_required "SchemaVersion" (xml_codec.read_value x_schema_version_type_of_string) children errors
    inl o_modality, errors =
        xml_codec.read_required "Modality" (xml_codec.read_value x_modality_type_of_string) children errors
    inl o_invoice_issuer_type, errors =
        xml_codec.read_required
            "InvoiceIssuerType"
