        "UBLTR_1.2.1_Paketi/xml/YTB_Istisna_Efatura.xml"
        "UBLTR_1.2.1_Paketi/xml/YTB_Satıs_EArşiv.xml"
        "UBLTR_1.2.1_Paketi/xml/YTB_Satıs_Efatura.xml"
        "UBLTR_1.2.1_Paketi/xml/YTB_TevkıfatIade_EArşiv.xml"
        "UBLTR_1.2.1_Paketi/xml/YTB_TevkıfatIade_Efatura.xml"
        "UBLTR_1.2.1_Paketi/xml/YTB_Tevkıfat_EArşiv.xml"
        "UBLTR_1.2.1_Paketi/xml/YTB_Tevkıfat_Efatura.xml"
        "efatura/e-FaturaPaketi/xml/1_SISTEM_YANITI_GTB_POSTA_KUTUSU.xml"
        "efatura/e-FaturaPaketi/xml/1_SISTEM_YANITI_MERKEZ.xml"
