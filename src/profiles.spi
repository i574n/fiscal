:= ubl_mark (tag : string) (text : string) : option string =
    := rest = pint_terms::after ("<cbc:" ++# tag) text
    ? rest = "" ?> None |: Some (pint_terms::before "<" (pint_terms::after ">" rest))

:= ubl_type_name (text : string) : option string =
    := rest = pint_terms::after "<cbc:InvoiceTypeCode name=\"" text
    ? rest = "" ?> None |: Some (pint_terms::before "\"" rest)

:= cii_guideline (text : string) : option string =
    := rest = pint_terms::after "GuidelineSpecifiedDocumentContextParameter>" text
    := id = pint_terms::after "<ram:ID>" rest
    ? rest = "" || id = "" ?> None |: Some (pint_terms::before "<" id)

:= cii_document_profile (text : string) : option ubl_profile =
    ?= cii_guideline text ?|
    | Some urn => customization_profile urn
    | None => None

:= document_profile (text : string) : option ubl_profile =
    := profile_id = ubl_mark "ProfileID" text
    := customization = ubl_mark "CustomizationID" text
    := list_version = ubl_mark "UBLListVersionID" text
    ?= ubl_document_profile profile_id customization list_version (ubl_type_name text) ?|
    | Some profile => Some profile
    | None => cii_document_profile text

:= corpus_text (path : string) : string = xml::read_text_replacing_invalid_utf8 (fiscal_paths::under path)

:= dian_misread (path : string) : list string =
    := text = corpus_text path
    ?= (document_profile text, ubl_mark "CustomizationID" text) ?|
    | (Some (DianUbl21 code), Some expected) ?& code = expected => []
    | _ => [ path ]

///> rust
test every_dian_example_classifies_as_dian_ubl_2_1_with_its_operation_code =
    := examples = dian_examples ()
    := missing = listm'::filter (\ (path : string) => xml::is_file (fiscal_paths::under path) = !-) examples
    ? missing <> [] ?> failwith ("every listed DIAN example is in the corpus: " ++# sm'::concat_list ", " missing)
    := misread = listm::concat (listm::map dian_misread examples)
    ? misread <> [] ?>
        failwith (
            "each DIAN example reads as DIAN UBL 2.1 with its own operation code: " ++# sm'::concat_list ", " misread
        )
    ? (listm::length examples : i32) <> 44i32 ?> failwith "the v19 toolbox ships 44 example documents"

///> rust
test zatca_transaction_codes_carry_the_kind_and_the_flags_their_samples_name =
    ? zatca_transaction "0100000" <> Some (ZatcaStandard, []) ?> failwith "a standard tax invoice"
    ? zatca_transaction "0200000" <> Some (ZatcaSimplified, []) ?> failwith "a simplified tax invoice"
    ? zatca_transaction "0110000" <> Some (ZatcaStandard, [ ThirdParty ]) ?> failwith "third party billing"
    ? zatca_transaction "0201000" <> Some (ZatcaSimplified, [ Nominal ]) ?> failwith "a nominal supply"
    ? zatca_transaction "0100100" <> Some (ZatcaStandard, [ Export ]) ?> failwith "an export invoice"
    ? zatca_transaction "0100010" <> Some (ZatcaStandard, [ Summary ]) ?> failwith "a summary invoice"
    ? zatca_transaction "0100001" <> Some (ZatcaStandard, [ SelfBilled ]) ?> failwith "a self-billed invoice"
    ? zatca_transaction "0300000" <> None || zatca_transaction "010000" <> None || zatca_transaction "0100200" <> None
    ?> failwith "an unknown kind, a short code or a non-binary flag is no transaction"
    ? ubl_document_profile (Some "reporting:1.0") None None (Some "0100000") <> Some (ZatcaUbl21 "0100000")
    ?> failwith "ZATCA is recognized by its profile id and transaction code"

:= zatca_folder () : string = "deps/corpus/sa/zatca/Samples/"

:= zatca_samples () : list string =
    listm::map (\ (file : string) => zatca_folder () ++# file) [
        "Simplified/Credit/Simplified_Credit_Note.xml"
        "Simplified/Debit/Simplified_Debit_Note.xml"
        "Simplified/Invoice/Nominal supply invoice.xml"
        "Simplified/Invoice/Simplified Tax Invoice with Zero Rated Item.xml"
        "Simplified/Invoice/Simplified_Invoice.xml"
        "Standard/Credit/Standard_Credit_Note.xml"
        "Standard/Debit/Standard_Debit_Note.xml"
        "Standard/Invoice/Advance Payment adjustments with foreign currency invoice.xml"
        "Standard/Invoice/Advance Payment adjustments with rate change scenarios.xml"
        "Standard/Invoice/Advance Payment adjustments.xml"
        "Standard/Invoice/Exempt Tax Invoice.xml"
        "Standard/Invoice/Export invoice.xml"
        "Standard/Invoice/Out of Scope Standard Tax Invoice.xml"
        "Standard/Invoice/Self-billing invoice.xml"
        "Standard/Invoice/Standard Invoice with Document Level Charge.xml"
        "Standard/Invoice/Standard Invoice with Payable Rounding Adjustment.xml"
        "Standard/Invoice/Standard_Invoice.xml"
        "Standard/Invoice/Summary Invoice.xml"
        "Standard/Invoice/Third party billing.xml"
    ]

:= zatca_misread (path : string) : list string =
    := expected = ? sm'::contains "/Standard/" path ?> ZatcaStandard |: ZatcaSimplified
    ?= document_profile (corpus_text path) ?|
    | Some (ZatcaUbl21 code) =>
        ?= zatca_transaction code ?|
        | Some (kind, _) ?& kind = expected => []
        | _ => [ path ]
    | _ => [ path ]

///> rust
test every_zatca_sample_classifies_with_the_kind_its_folder_names =
    := samples = zatca_samples ()
    := missing = listm'::filter (\ (path : string) => xml::is_file (fiscal_paths::under path) = !-) samples
    ? missing <> [] ?> failwith ("every listed ZATCA sample is in the corpus: " ++# sm'::concat_list ", " missing)
    := misread = listm::concat (listm::map zatca_misread samples)
    ? misread <> [] ?>
        failwith ("each ZATCA sample reads as ZATCA UBL 2.1 of its folder's kind: " ++# sm'::concat_list ", " misread)
    ? (listm::length samples : i32) <> 19i32 ?> failwith "the ZATCA sample set ships 19 documents"

///> rust
test a_path_never_narrows fails "Unification failure" =
    := narrowing : path en16931 basic = Then (\? (BasicToEn16931, Here))
    narrowing |> ignore

///> rust
test a_widened_invoice_has_its_target_profile fails "Unification failure" =
    := invoice = profiled_as Basic "<rsm:CrossIndustryInvoice/>"
    (widen Here Basic invoice : profiled extended) |> ignore

///> rust
test ubltr_documents_are_classified_by_version_and_official_scenario =
    ? ubl_document_profile (Some "TICARIFATURA") (Some "TR1.2") None None <> Some (UblTr (Tr12, "TICARIFATURA"))
    ?> failwith "a commercial invoice on UBL-TR 1.2"
    ? ubl_document_profile (Some "TEMELIRSALIYE") (Some "TR1.2.1") None None <> Some (UblTr (Tr121, "TEMELIRSALIYE"))
    ?> failwith "a basic despatch on UBL-TR 1.2.1"
    ? ubl_document_profile (Some "UBL-TR-PROFILE-1") (Some "TR1.0") None None <> Some (UblTr (Tr10, "UBL-TR-PROFILE-1"))
    ?> failwith "a GIB system response"
    ? ubl_document_profile (Some "TicariFatura") (Some "TR1.2") None None <> None ?> failwith "GIB scenarios are case-sensitive"
    ? ubl_document_profile (Some "TICARIFATURA") (Some "TR2.0") None None <> None ?> failwith "an unknown UBL-TR version"
    ? ubltr_kind_of "EARSIVFATURA" <> Some TrEArchive || ubltr_kind_of "HKSIRSALIYE" <> Some TrDespatch
    ?> failwith "the e-archive and despatch scenario sets"

