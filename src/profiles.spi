///- --package . --timeout 3600000
:< sm'_operators

:! minimum = ()
:! basic_wl = ()
:! basic = ()
:! en16931 = ()
:! extended_ctc_fr = ()
:! extended = ()

:| profile p =
    | Minimum :: profile minimum
    | BasicWl :: profile basic_wl
    | Basic :: profile basic
    | En16931 :: profile en16931
    | ExtendedCtcFr :: profile extended_ctc_fr
    | Extended :: profile extended

:| step a b =
    | MinimumToBasicWl :: step minimum basic_wl
    | BasicWlToBasic :: step basic_wl basic
    | BasicToEn16931 :: step basic en16931
    | En16931ToCtcFr :: step en16931 extended_ctc_fr
    | CtcFrToExtended :: step extended_ctc_fr extended

:| ^ path a b =
    | Here :: \* a. path a a
    | Then :: \* a c. (\? b. step a b * path b c) -> path a c

:! profiled p = profile p * string

:= profiled_as \* p. (level : profile p) (document : string) : profiled p = profiled (level, document)

:= widen \* a b. (route : path a b) (target : profile b) ((profiled (_, document)) : profiled a) : profiled b =
    profiled (target, document)

:= profile_urn \* p. (level : profile p) : option string =
    ?= level ?|
    | Minimum => Some "urn:factur-x.eu:1p0:minimum"
    | BasicWl => Some "urn:factur-x.eu:1p0:basicwl"
    | Basic => Some "urn:cen.eu:en16931:2017#compliant#urn:factur-x.eu:1p0:basic"
    | En16931 => Some "urn:cen.eu:en16931:2017"
    | ExtendedCtcFr => None
    | Extended => Some "urn:cen.eu:en16931:2017#conformant#urn:factur-x.eu:1p0:extended"

:= document_of \* p. ((profiled (_, document)) : profiled p) : string = document

:= level_of \* p. ((profiled (level, _)) : profiled p) : profile p = level

:| myinvois_version =
    | MyInvoisV10
    | MyInvoisV11

:| ubltr_version =
    | Tr10
    | Tr12
    | Tr121

:| ubltr_kind =
    | TrInvoice
    | TrEArchive
    | TrDespatch
    | TrSystemResponse

:| xrechnung_variant =
    | XrechnungBase
    | XrechnungExtension
    | XrechnungCvd

:| ubl_profile =
    | UblEn16931
    | Xrechnung : xrechnung_variant
    | PeppolBis3
    | SunatUbl20
    | MyInvois : myinvois_version
    | DianUbl21 : string
    | ZatcaUbl21 : string
    | UblTr : ubltr_version * string
    | CiusRo
    | PeppolPint : string

:| zatca_kind =
    | ZatcaStandard
    | ZatcaSimplified

:| zatca_flag =
    | ThirdParty
    | Nominal
    | Export
    | Summary
    | SelfBilled

:= myinvois_version_text (v : myinvois_version) : string =
    ?= v ?|
    | MyInvoisV10 => "1.0"
    | MyInvoisV11 => "1.1"

:= myinvois_version_of (list_version : string) : option myinvois_version =
    listm'::try_find_ (\ v => myinvois_version_text v = list_version) (MyInvoisV10 :: MyInvoisV11 :: [])

:= peppol_bis3_urn () : string = "urn:cen.eu:en16931:2017#compliant#urn:fdc:peppol.eu:2017:poacc:billing:3.0"

:= cius_ro_urn () : string = "urn:cen.eu:en16931:2017#compliant#urn:efactura.mfinante.ro:CIUS-RO:1.0.0"

:= pint_billing_prefix () : string = "urn:peppol:pint:billing-1@"

:= pint_jurisdiction (urn : string) : string = pint_terms::after (pint_billing_prefix ()) urn

:= xrechnung_urn () : string = "urn:cen.eu:en16931:2017#compliant#urn:xeinkauf.de:kosit:xrechnung_3.0"

:= xrechnung_extension_urn () : string =
    xrechnung_urn () ++# "#conformant#urn:xeinkauf.de:kosit:extension:xrechnung_3.0"

:= xrechnung_cvd_urn () : string = xrechnung_urn () ++# "#compliant#urn:xeinkauf.de:kosit:xrechnung:cvd_0.9"

:= customization_codes () : list (string * ubl_profile) =
    [
        ("urn:cen.eu:en16931:2017", UblEn16931); (peppol_bis3_urn (), PeppolBis3); ("2.0", SunatUbl20)
        (cius_ro_urn (), CiusRo); (xrechnung_urn (), Xrechnung XrechnungBase)
        (xrechnung_extension_urn (), Xrechnung XrechnungExtension); (xrechnung_cvd_urn (), Xrechnung XrechnungCvd)
    ]

:= customization_profile (urn : string) : option ubl_profile =
    ?= listm'::try_find_ (\ (code, _) => code = urn) (customization_codes ()) ?|
    | Some (_, profile) => Some profile
    | None ?& sm'::starts_with (pint_billing_prefix ()) urn => Some (PeppolPint (pint_jurisdiction urn))
    | None => None

:= list_version_profile (list_version : option string) : option ubl_profile =
    ?= list_version ?|
    | Some version => optionm::map (\ v => MyInvois v) (myinvois_version_of version)
    | None => None

:= ubl_profile_of (customization : option string) (list_version : option string) : option ubl_profile =
    ?= customization ?|
    | Some urn => customization_profile urn
    | None => list_version_profile list_version

:= dian_profile (profile_id : option string) (customization : option string) : option ubl_profile =
    ?= (profile_id, customization) ?|
    | (Some id, Some operation) ?& sm'::starts_with "DIAN 2.1" id => Some (DianUbl21 operation)
    | _ => None

:= zatca_profile (profile_id : option string) (transaction : option string) : option ubl_profile =
    ?= (profile_id, transaction) ?|
    | (Some id, Some code) ?& id = "reporting:1.0" => Some (ZatcaUbl21 code)
    | _ => None

:= zatca_flag_positions () : list (i32 * zatca_flag) =
    [ (2i32, ThirdParty); (3i32, Nominal); (4i32, Export); (5i32, Summary); (6i32, SelfBilled) ]

:= zatca_kind_of (prefix : string) : option zatca_kind =
    ? prefix = "01" ?> Some ZatcaStandard |: (? prefix = "02" ?> Some ZatcaSimplified |: None)

:= zatca_flags (code : string) : option (list zatca_flag) =
    := digit (at : i32) : string = sm'::substring at 1i32 code
    := odd = listm'::filter (\ (at, _) => digit at <> "0" && digit at <> "1") (zatca_flag_positions ())
    := set = listm'::filter (\ (at, _) => digit at = "1") (zatca_flag_positions ())
    ? odd <> [] ?> None |: Some (listm::map (\ (_, flag) => flag) set)

:= zatca_transaction (code : string) : option (zatca_kind * list zatca_flag) =
    ? (sm'::length code : i32) <> 7i32 ?> None
    |: (
        ?= (zatca_kind_of (sm'::substring 0i32 2i32 code), zatca_flags code) ?|
        | (Some kind, Some flags) => Some (kind, flags)
        | _ => None
    )

:= ubltr_version_of (customization : string) : option ubltr_version =
    ? customization = "TR1.0" ?> Some Tr10
    |: (? customization = "TR1.2" ?> Some Tr12 |: (? customization = "TR1.2.1" ?> Some Tr121 |: None))

:= ubltr_invoice_scenarios () : list string =
    [
        "TICARIFATURA"; "TEMELFATURA"; "YOLCUBERABERFATURA"; "IHRACAT"; "OZELFATURA"; "KAMU"; "HKS"; "ENERJI"
        "ILAC_TIBBICIHAZ"; "YATIRIMTESVIK"; "IDIS"
    ]

:= ubltr_despatch_scenarios () : list string = [ "TEMELIRSALIYE"; "HKSIRSALIYE"; "IDISIRSALIYE" ]

:= ubltr_kind_of (scenario : string) : option ubltr_kind =
    ? listm'::contains scenario (ubltr_invoice_scenarios ()) ?> Some TrInvoice
    |: (
        ? scenario = "EARSIVFATURA" ?> Some TrEArchive
        |: (
            ? listm'::contains scenario (ubltr_despatch_scenarios ()) ?> Some TrDespatch
            |: (? scenario = "UBL-TR-PROFILE-1" ?> Some TrSystemResponse |: None)
        )
    )

:= ubltr_profile (profile_id : option string) (customization : option string) : option ubl_profile =
    ?= (profile_id, customization) ?|
    | (Some scenario, Some code) =>
        ?= (ubltr_version_of code, ubltr_kind_of scenario) ?|
        | (Some version, Some _) => Some (UblTr (version, scenario))
        | _ => None
    | _ => None

:= ubl_document_profile
    (profile_id : option string)
    (customization : option string)
    (list_version : option string)
    (transaction : option string)
    : option ubl_profile =
    := national = (dian_profile profile_id customization, zatca_profile profile_id transaction)
    ?= (national, ubltr_profile profile_id customization) ?|
    | ((Some dian, _), _) => Some dian
    | ((None, Some zatca), _) => Some zatca
    | ((None, None), Some tr) => Some tr
    | ((None, None), None) => ubl_profile_of customization list_version

///> rust
test a_basic_invoice_widens_to_en16931_and_extended =
    := invoice = profiled_as Basic "<rsm:CrossIndustryInvoice/>"
    := to_en16931 : path basic en16931 = Then (\? (BasicToEn16931, Here))
    := lifted = widen to_en16931 En16931 invoice
    ? profile_urn (level_of lifted) <> Some "urn:cen.eu:en16931:2017"
    ?> failwith "the widened invoice carries the EN 16931 guideline"
    := to_extended : path basic extended =
        Then (\? (BasicToEn16931, Then (\? (En16931ToCtcFr, Then (\? (CtcFrToExtended, Here))))))
    ? document_of (widen to_extended Extended invoice) <> "<rsm:CrossIndustryInvoice/>"
    ?> failwith "widening keeps the document"

///> rust
test ubl_documents_are_classified_by_their_customization_or_list_version =
    ? ubl_profile_of (Some "2.0") None <> Some SunatUbl20 ?> failwith "SUNAT UBL 2.0"
    ? ubl_profile_of (Some "urn:cen.eu:en16931:2017") None <> Some UblEn16931 ?> failwith "a CEN EN16931 example"
    ? ubl_profile_of (Some (peppol_bis3_urn ())) None <> Some PeppolBis3 ?> failwith "PEPPOL BIS Billing 3.0"
    ? ubl_profile_of None (Some "1.1") <> Some (MyInvois MyInvoisV11) ?> failwith "MyInvois 1.1 has no customization"
    ? ubl_profile_of None (Some "1.0") <> Some (MyInvois MyInvoisV10) ?> failwith "MyInvois 1.0"
    ? ubl_profile_of None (Some "2.1") <> None || ubl_profile_of (Some "x") (Some "1.1") <> None
    ?> failwith "an unknown mark is no profile"

///> rust
test dian_documents_are_classified_by_their_profile_id_with_the_operation_code =
    := sale = "DIAN 2.1: Factura Electrónica de Venta"
    ? ubl_document_profile (Some sale) (Some "10") None None <> Some (DianUbl21 "10") ?> failwith "a DIAN sale, operation 10"
    ? ubl_document_profile (Some "DIAN 2.1") (Some "01") None None <> Some (DianUbl21 "01") ?> failwith "a bare DIAN 2.1 profile"
    ? ubl_document_profile None (Some "05") None None <> None ?> failwith "a DIAN operation code alone is no profile"
    ? ubl_document_profile (Some sale) None None None <> None ?> failwith "a DIAN document always carries its operation code"
    ? ubl_document_profile (Some "urn:example:other") (Some "2.0") None None <> Some SunatUbl20
    ?> failwith "without a DIAN profile id the customization rules still apply"

