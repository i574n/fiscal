        "efatura/e-FaturaPaketi/xml/TEKNOLOJI_DESTEK.xml"
    ]

:= ubltr_gib_rule_violations () : list string =
    listm::map (\ (file : string) => ubltr_folder () ++# "UBLTR_1.2.1_Paketi/xml/" ++# file) [
        "IadeUygulamaYanitiOrnegi.xml"
        "KabulUygulamaYanitiOrnegi.xml"
        "RedUygulamaYanitiOrnegi.xml"
    ]

:= ubltr_misread (path : string) : list string =
    ?= document_profile (corpus_text path) ?|
    | Some (UblTr _) => []
    | _ => [ path ]

///> rust
test every_ubltr_document_classifies_except_the_three_samples_that_break_the_gib_rule =
    := documents = ubltr_documents ()
    := missing = listm'::filter (\ (path : string) => xml::is_file (fiscal_paths::under path) = !-) documents
    ? missing <> [] ?> failwith ("every listed UBL-TR document is in the corpus: " ++# sm'::concat_list ", " missing)
    := misread = listm::concat (listm::map ubltr_misread documents)
    ? misread <> ubltr_gib_rule_violations () ?>
        failwith (
            "only the 3 mixed-case 'TicariFatura' application responses (GIB requires TICARIFATURA or IHRACAT) "
            ^^ "fail to classify; got: " ++# sm'::concat_list ", " misread
        )
    ? (listm::length documents : i32) <> 65i32 ?> failwith "the UBL-TR packages ship 65 profiled documents"

///> rust
test cius_ro_and_peppol_pint_are_classified_by_their_customization =
    ? ubl_profile_of (Some (cius_ro_urn ())) None <> Some CiusRo ?> failwith "a Romanian CIUS-RO 1.0.0 e-Factura"
    ? ubl_profile_of (Some "urn:peppol:pint:billing-1@sg-1") None <> Some (PeppolPint "sg-1") ?> failwith "PINT SG"
    ? ubl_profile_of (Some "urn:peppol:pint:billing-1@jp-1") None <> Some (PeppolPint "jp-1")
    ?> failwith "any PINT jurisdiction classifies with its own code"
    ? ubl_profile_of (Some (peppol_bis3_urn ())) None <> Some PeppolBis3 ?> failwith "BIS 3 is not a PINT"
    ? ubl_profile_of (Some "urn:peppol:pint:selfbilling-1@sg-1") None <> None ?> failwith "only the billing PINT"

///> rust
test xrechnung_classifies_in_ubl_and_cii_by_its_customization =
    ? customization_profile (xrechnung_urn ()) <> Some (Xrechnung XrechnungBase) ?> failwith "XRechnung 3.0"
    ? customization_profile (xrechnung_extension_urn ()) <> Some (Xrechnung XrechnungExtension)
    ?> failwith "the XRechnung 3.0 extension"
    ? customization_profile (xrechnung_cvd_urn ()) <> Some (Xrechnung XrechnungCvd) ?> failwith "the XRechnung CVD"
    := cii =
        "<rsm:ExchangedDocumentContext><ram:GuidelineSpecifiedDocumentContextParameter>\n<ram:ID>" ++# xrechnung_urn ()
        ++# "</ram:ID>"
    ? document_profile cii <> Some (Xrechnung XrechnungBase) ?> failwith "a CII document reads its guideline id"
    ? document_profile "<rsm:CrossIndustryInvoice/>" <> None ?> failwith "a CII document without a guideline id"

:= xrechnung_folder () : string = "deps/corpus/de/xrechnung-testsuite/instances/"

:= xml_files_in (folder : string) : list string =
    file_system::read_directory_names (fiscal_paths::under folder)
    |> resultm::unwrap'
    |> am'::vec_fold' (\ names name => sm'::from_std_string name :: names) []
    |> listm'::filter (\ (name : string) => sm'::ends_with ".xml" name)
    |> listm::map (\ (name : string) => folder ++# name)

:= xrechnung_instances () : list string =
    [ "standard/"; "extension/"; "technical-cases/cius/"; "technical-cases/cvd/" ]
    |> listm::map (\ (sub : string) => xml_files_in (xrechnung_folder () ++# sub))
    |> listm::concat

:= xrechnung_variant_text (variant : xrechnung_variant) : string =
    ?= variant ?|
    | XrechnungBase => "base"
    | XrechnungExtension => "extension"
    | XrechnungCvd => "cvd"

:= xrechnung_variant_word (path : string) : string =
    ?= document_profile (corpus_text path) ?|
    | Some (Xrechnung variant) => xrechnung_variant_text variant
    | _ => "miss " ++# path

:= words_equal (word : string) (words : list string) : i32 =
    (listm::length (listm'::filter (\ (w : string) => w = word) words) : i32)

///> rust
test every_kosit_testsuite_instance_classifies_as_its_xrechnung_variant =
    := instances = xrechnung_instances ()
    := found = (listm::length instances : i32)
    ? found <> 86i32 ?> failwith ("the KoSIT testsuite 2026-08-31 ships 86 instances, found " ++# sm'::show found)
    := words = listm::map xrechnung_variant_word instances
    := misses = listm'::filter (\ (w : string) => sm'::starts_with "miss " w) words
    ? misses <> [] ?> failwith ("every XRechnung instance classifies: " ++# sm'::concat_list ", " misses)
    ? words_equal "base" words <> 78i32 || words_equal "extension" words <> 6i32 || words_equal "cvd" words <> 2i32
    ?> failwith "78 base, 6 extension and 2 CVD instances (census 11-13)"

:= peppol_bis3_folder () : string = "deps/corpus/be/peppol-bis3/rules/"

:= peppol_bis3_documents () : list string =
    [ "examples/"; "national-examples/GR/"; "national-examples/NO/"; "snippets/" ]
    |> listm::map (\ (sub : string) => xml_files_in (peppol_bis3_folder () ++# sub))
    |> listm::concat

:= peppol_misread (path : string) : list string =
    ? document_profile (corpus_text path) = Some PeppolBis3 ?> [] |: [ path ]

///> rust
test every_openpeppol_bis3_example_and_snippet_classifies_as_peppol_bis3 =
    := documents = peppol_bis3_documents ()
    := found = (listm::length documents : i32)
    ? found <> 29i32
    ?> failwith ("BIS Billing 3.0.22 ships 10 examples, 3 national examples, 16 snippets; found " ++# sm'::show found)
    := misread = listm::concat (listm::map peppol_misread documents)
    ? misread <> [] ?> failwith ("every BIS 3 example reads as PEPPOL BIS 3: " ++# sm'::concat_list ", " misread)

:= ro_sg_documents () : list (string * ubl_profile) =
    := ro = "deps/corpus/ro/cius/examples/exemple_Invoice_CreditNote/"
    := sg = "deps/corpus/sg/pint-sg/trn-invoice/example/PINT-SG "
    := pint_sg (file : string) : string * ubl_profile = (sg ++# file, PeppolPint "sg-1")
    [
        (ro ++# "creditNote_ex.xml", CiusRo)
        (ro ++# "eInvoice_ex.xml", CiusRo)
        pint_sg "CN example 01 - Credit Note.xml"
        pint_sg "INV example 02 - full valid invoice 1.xml"
        pint_sg "INV example 03 - Allowances and Charges.xml"
        pint_sg "INV example 04 - none GST registered.xml"
        pint_sg "INV example 05 - AGD compliant with II and PO reference.xml"
        pint_sg "INV example 06 - Foreign currency.xml"
        pint_sg "INV example 07 - Foreign buyer.xml"
        pint_sg "INV example 08 - Factored invoice.xml"
        pint_sg "INV example 09 - Zero rated GST.xml"
        pint_sg "INV example 10 - Prepayment.xml"
        pint_sg "INV example 11 - Decimals.xml"
        pint_sg "INV example 12 - SG bank transfer.xml"
        pint_sg "INV example 13 - SG GIRO.xml"
        pint_sg "INV example 14 - PayNow.xml"
        pint_sg "INV example 15 - Credit card.xml"
        pint_sg "INV example 16 - GST in SGD.xml"
    ]

:= ro_sg_misread ((path, expected) : string * ubl_profile) : list string =
    ? document_profile (corpus_text path) = Some expected ?> [] |: [ path ]

///> rust
test every_ro_and_sg_example_classifies_as_its_national_profile =
    := documents = ro_sg_documents ()
    := missing = listm'::filter (\ (path, _) => xml::is_file (fiscal_paths::under path) = !-) documents
    ? missing <> [] ?> failwith "every listed RO and SG example is in the corpus"
    := misread = listm::concat (listm::map ro_sg_misread documents)
    ? misread <> [] ?> failwith ("each RO / SG example reads as its profile: " ++# sm'::concat_list ", " misread)
    ? (listm::length documents : i32) <> 18i32 ?> failwith "2 CIUS-RO and 16 PINT SG examples"
