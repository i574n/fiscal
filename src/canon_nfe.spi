    ]

:= nfe_delivery_bindings () : list (canon::term_id * string) =
    [
        (bt 70i32, "NFe/infNFe/entrega/xNome"); (bt 72i32, "NFe/infNFe/ide/dhSaiEnt")
        (bt 75i32, "NFe/infNFe/entrega/xLgr"); (bt 76i32, "NFe/infNFe/entrega/xCpl")
    ]

:= nfe_delivery_place_bindings () : list (canon::term_id * string) =
    [
        (bt 77i32, "NFe/infNFe/entrega/xMun"); (bt 78i32, "NFe/infNFe/entrega/CEP")
        (bt 79i32, "NFe/infNFe/entrega/UF")
    ]

:= nfe_payment_bindings () : list (canon::term_id * string) =
    [
        (bt 113i32, "NFe/infNFe/pag/detPag/vPag"); (bt 86i32, "NFe/infNFe/pag/detPag/card/CNPJ")
        (bt 61i32, "NFe/infNFe/pag/detPag/card/CNPJReceb"); (bt 82i32, "NFe/infNFe/pag/detPag/xPag")
    ]

:= nfe_line_reference_bindings () : list (canon::term_id * string) =
