///- --package . --timeout 1200000
:< sm'_operators

:! issued = ()
:! authorized = ()
:! rejected = ()
:! cancelled = ()

:! nfe = string
:! cfdi = string
:! ubl = string

:? cancellation_event r : r -> string
:? correction_event r : r -> string

:+ cancellation_event nfe = \ _ => "110111"
:+ correction_event nfe = \ _ => "110110"
:+ cancellation_event cfdi = \ _ => "Cancelacion"

:! access_key = string

:! protocol_id = string

:= key_text ((access_key text) : access_key) : string = text

:= protocol_text ((protocol_id text) : protocol_id) : string = text

:== correction_letter = { sequence : i32; text : string; event : string }

:| private document r s =
    | Issued :: \* r. r * access_key -> document r issued
    | Authorized :: \* r.
        { regime : r; key : access_key; protocol : protocol_id; corrections : list correction_letter } -> document r authorized
    | Rejected :: \* r. r * access_key * string -> document r rejected
    | Cancelled :: \* r.
        { regime : r; key : access_key; protocol : protocol_id; event : string; event_protocol : protocol_id }
        -> document r cancelled

:~ key_of \* r s. (doc : document r s) : access_key =
    ?= doc ?|
    | Issued (_, key) => key
    | Authorized a => a::key
    | Rejected (_, key, _) => key
    | Cancelled c => c::key

:= issue \* r. (regime : r) (key : access_key) : document r issued = Issued (regime, key)

:= authorize \* r. (doc : document r issued) (protocol : protocol_id) : document r authorized =
    ?= doc ?|
    | Issued (regime, key) => Authorized { regime = regime; key = key; protocol = protocol; corrections = [] }

:= reject \* r. (doc : document r issued) (reason : string) : document r rejected =
    ?= doc ?|
    | Issued (regime, key) => Rejected (regime, key, reason)

:= correct \* r {correction_event}. (doc : document r authorized) (letter : string) : document r authorized =
    ?= doc ?|
    | Authorized a =>
        := next = { sequence = listm::length a::corrections + 1i32; text = letter; event = correction_event a::regime }
        Authorized { a ?| corrections = listm::append a::corrections [ next ] }

:= corrections_of \* r. (doc : document r authorized) : list correction_letter =
    ?= doc ?|
    | Authorized a => a::corrections

:= cancel \* r {cancellation_event}. (doc : document r authorized) (event_protocol : protocol_id) : document r cancelled =
    ?= doc ?|
    | Authorized a =>
        Cancelled {
            regime = a::regime; key = a::key; protocol = a::protocol
            event = cancellation_event a::regime; event_protocol = event_protocol
        }

:= authorization_protocol \* r. (doc : document r cancelled) : protocol_id =
    ?= doc ?|
    | Cancelled c => c::protocol

:= cancellation_event_of \* r. (doc : document r cancelled) : string =
    ?= doc ?|
    | Cancelled c => c::event

:| actor =
    | Issuer
    | Recipient
    | Fisco
    | LinkedDocument
    | Export
    | OtherAgency

:= actor_of_event_code (code : i32) : option actor =
    ?= code / 100000i32 ?|
    | 1i32 => Some Issuer
    | 2i32 => Some Recipient
    | 4i32 => Some Fisco
    | 6i32 => Some LinkedDocument
    | 7i32 => Some Export
    | 9i32 => Some OtherAgency
    | _ => None

:| recipient_event =
    | Awareness
    | Confirmation
    | Disownment : string
    | NonPerformance : string

:= recipient_event_of_code (code : i32) (justification : string) : option recipient_event =
    ?= code ?|
    | 210210i32 => Some Awareness
    | 210200i32 => Some Confirmation
    | 210220i32 => Some (Disownment justification)
    | 210240i32 => Some (NonPerformance justification)
    | _ => None

///> rust
test event_codes_name_their_author =
    := author (code : i32) : string =
        ?= actor_of_event_code code ?|
        | Some actor =>
            ?= actor ?|
            | Issuer => "issuer"
            | Recipient => "recipient"
            | Fisco => "fisco"
            | LinkedDocument => "linked document"
            | Export => "export"
            | OtherAgency => "other agency"
        | None => "none"
    ? author 110111i32 <> "issuer" ?> failwith "110111 cancellation is the issuer's"
    ? author 110110i32 <> "issuer" ?> failwith "110110 correction is the issuer's"
    ? author 210200i32 <> "recipient" ?> failwith "210200 confirmation is the recipient's"
    ? author 411500i32 <> "fisco" ?> failwith "411500 is the fisco's"
    ? author 610130i32 <> "linked document" ?> failwith "610130 comes from a CT-e"
    ? author 790700i32 <> "export" ?> failwith "790700 is an export endorsement"
    ? author 990900i32 <> "other agency" ?> failwith "990900 is SUFRAMA's"
    ? author 310000i32 <> "none" ?> failwith "no observed event starts with 3"

///> rust
test recipient_refusals_carry_their_justification =
    := name (event : option recipient_event) : string =
        ?= event ?|
        | Some value =>
            ?= value ?|
            | Awareness => "awareness"
            | Confirmation => "confirmation"
            | Disownment reason => "disownment: " ++# reason
            | NonPerformance reason => "non-performance: " ++# reason
        | None => "none"
    ? name (recipient_event_of_code 210220i32 "never ordered") <> "disownment: never ordered"
    ?> failwith "210220 is a disownment that keeps its xJust"
    ? name (recipient_event_of_code 210240i32 "goods refused") <> "non-performance: goods refused"
    ?> failwith "210240 is a non-performance that keeps its xJust"
    ? name (recipient_event_of_code 210210i32 "") <> "awareness" ?> failwith "210210 is awareness"
    ? name (recipient_event_of_code 210200i32 "") <> "confirmation" ?> failwith "210200 is confirmation"
    ? name (recipient_event_of_code 110111i32 "") <> "none" ?> failwith "110111 is not a recipient event"

///> rust
test a_cancellation_keeps_the_authorization_protocol =
    := key = "35260112345678000195550010000000011000000019"
    := authorized = authorize (issue (nfe "4.00") (access_key key)) (protocol_id "135260000000001")
    := corrected = correct (correct authorized "xCorrecao one") "xCorrecao two"
    := closed = cancel corrected (protocol_id "135260000000002")
    ? key_text (key_of closed) <> key ?> failwith "the key survives every step"
    ? protocol_text (authorization_protocol closed) <> "135260000000001"
    ?> failwith "a cancellation quotes the authorization (nProt)"
    ? cancellation_event_of closed <> "110111" ?> failwith "an NF-e cancellation is tpEvento 110111"
    ?= corrections_of corrected ?|
    | first :: second :: [] =>
        ? first::sequence <> 1i32 || second::sequence <> 2i32 || second::text <> "xCorrecao two"
        ?> failwith "CC-e letters keep their order and nSeqEvento"
        ? second::event <> "110110" ?> failwith "a CC-e is tpEvento 110110"
    | _ => failwith "two correction letters stay on the authorized document"
    ? key_text (key_of (reject (issue (nfe "4.00") (access_key "k")) "duplicate")) <> "k" ?> failwith "a rejection keeps the key"

///> rust
test a_cfdi_cancels_through_its_own_request =
    := authorized = authorize (issue (cfdi "4.0") (access_key "5FB2822E-396D-4725-8521-CDC4BDD20CCF")) (protocol_id "sello")
    ? cancellation_event_of (cancel authorized (protocol_id "acuse")) <> "Cancelacion"
    ?> failwith "a CFDI cancellation is a Cancelacion request"

///> rust
test cancelling_an_unauthorized_document_does_not_type fails "Unification failure" =
    cancel (issue (nfe "4.00") (access_key "k")) (protocol_id "p") |> ignore

///> rust
test cancelling_a_cancelled_document_does_not_type fails "Unification failure" =
    := authorized = authorize (issue (nfe "4.00") (access_key "k")) (protocol_id "p")
    cancel (cancel authorized (protocol_id "e1")) (protocol_id "e2") |> ignore

///> rust
test correcting_an_unauthorized_document_does_not_type fails "Unification failure" =
    correct (issue (nfe "4.00") (access_key "k")) "letter" |> ignore

///> rust
test a_ubl_invoice_cannot_be_cancelled_only_credited fails "does not have the prototype cancellation_event" =
    cancel (authorize (issue (ubl "2.1") (access_key "INV-1")) (protocol_id "p")) (protocol_id "e") |> ignore

///> rust
test a_cfdi_takes_no_correction_letter fails "does not have the prototype correction_event" =
    correct (authorize (issue (cfdi "4.0") (access_key "k")) (protocol_id "p")) "letter" |> ignore
