:~ ^ failure_ids (failures : list schematron_run::failure) (acc : list string) : list string =
    ?= failures ?|
    | f :: rest => failure_ids rest (schematron::rule_text f::id :: acc)
    | [] => acc

///> rust
test cen_rules_catch_mutated_invoices =
    := rules =
        file_system::read_all_text (
            fiscal_paths::under "deps/corpus/eu/en16931/EN16931-UBL-validation-preprocessed.sch"
        )
        |> schematron::read_schematron
    := original =
        file_system::read_all_text (fiscal_paths::under "deps/corpus/eu/en16931/examples/ubl-tc434-example1.xml")
    := ids mutated =
        ?= read_xml mutated ?|
        | root :: [] => failure_ids (schematron_run::validate rules root) []
        | _ => []
    := payable =
        sm'::replace
            "<cbc:PayableAmount currencyID=\"EUR\">250.33<"
            "<cbc:PayableAmount currencyID=\"EUR\">251.33<"
            original
    ? listm'::contains "BR-CO-16" (ids payable) = !- ?> failwith "a wrong payable amount breaks BR-CO-16"
    := unit = sm'::replace "unitCode=\"EA\">2<" "unitCode=\"ZZZZ\">2<" original
    ? listm'::contains "BR-CL-23" (ids unit) = !- ?> failwith "an unknown unit code breaks BR-CL-23"

///> rust
test ubl_tr_other_documents_keep_their_main_schematron_findings =
    := main = fiscal_paths::under "deps/corpus/tr/ubltr/efatura/e-FaturaPaketi/schematron/UBL-TR_Main_Schematron.xml"
    := patterns = schematron::read_schematron_resolved corpus_text main
    := samples = "deps/corpus/tr/ubltr/UBLTR_1.2.1_Paketi/xml/"
    := expected =
        [
            ("Irsaliye-Ornek1.xml", 4i32); ("Irsaliye-Ornek2.xml", 4i32); ("Irsaliye-Ornek3.xml", 4i32)
            ("Irsaliye-Matbudan.xml", 4i32); ("IrsaliyeYaniti-Ornek1.xml", 0i32); ("IrsaliyeYaniti-Ornek2.xml", 0i32)
            ("IrsaliyeYaniti-Ornek3.xml", 0i32); ("IrsaliyeYaniti-Ornek4.xml", 0i32)
            ("KabulUygulamaYanitiOrnegi.xml", 2i32); ("RedUygulamaYanitiOrnegi.xml", 2i32)
            ("IadeUygulamaYanitiOrnegi.xml", 2i32)
        ]
    := drifted (row : string * i32) =
        := name, count = row
        ? sample_failures (fiscal_paths::under samples) patterns name = Some count ?> [] |: [ name ]
    ?= listm::concat (listm::map drifted expected) ?|
    | [] => ()
    | first :: _ =>
        := found = first_failures patterns (samples ++# first)
        failwith ("UBL-TR 1.2.1 sample " ++# first ++# " changed its main-schematron findings: " ++# found)

:| ubl_syntax =
    | UblXml
    | UblJson

:| ubl_kind =
    | InvoiceKind
    | CreditNoteKind
    | DebitNoteKind

:= kind_label (kind : ubl_kind) : string = sm'::to_lower (sm'::replace "Kind" "" (reflection::case_name kind))

:= ubl_manifest (kind : ubl_kind) (syntax : ubl_syntax) : string =
    ?= syntax ?|
    | UblXml => "deps/corpus/ubl-" ++# kind_label kind ++# "-documents.txt"
    | UblJson => "deps/corpus/ubl-" ++# kind_label kind ++# "-json-documents.txt"

:= entries_under (prefix : string) (kind : ubl_kind) (syntax : ubl_syntax) : i32 =
    := text = xml::read_text_replacing_invalid_utf8 (fiscal_paths::under (ubl_manifest kind syntax))
    listm::length (listm'::filter (\ (line : string) => sm'::starts_with prefix line) (sm'::split_list "\n" text))

///> rust
test each_ubl_kind_names_its_manifest =
    := labels = listm::map kind_label [ InvoiceKind; CreditNoteKind; DebitNoteKind ]
    ? ubl_manifest CreditNoteKind UblJson <> "deps/corpus/ubl-creditnote-json-documents.txt"
        || labels <> [ "invoice"; "creditnote"; "debitnote" ]
    ?> failwith "a UBL kind's manifest is named by its case, without the Kind suffix"

///> rust
test every_myinvois_sample_reaches_the_ubl_invoice_unit_in_both_syntaxes =
    ? (entries_under "my/" InvoiceKind UblXml, entries_under "my/" InvoiceKind UblJson) <> (22i32, 22i32)
    ?> failwith "the 22 LHDN MyInvois samples are UBL Invoice roots in XML and in UBL-2.1-JSON"

///> rust
test every_sunat_homologation_case_reaches_its_ubl_unit =
    := counts = entries_under "pe/" InvoiceKind UblXml, entries_under "pe/" CreditNoteKind UblXml
    ? (counts, entries_under "pe/" DebitNoteKind UblXml) <> ((28i32, 15i32), 15i32)
    ?> failwith "the 58 SUNAT homologation cases are 28 invoices, 15 credit notes and 15 debit notes"
