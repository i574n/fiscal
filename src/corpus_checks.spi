:= pint_folder (region : string) : string = "deps/corpus/" ++# region ++# "/pint-" ++# region ++# "/trn-invoice/"

:= pint_region_rules (region : string) (file : string) : list schematron::pattern =
    file_system::read_all_text (fiscal_paths::under (pint_folder region ++# "schematron/" ++# file))
    |> schematron::read_schematron

:= pint_judged (region : string) (names : list string) (file : string) : list (string * fatal_check) =
    examples_fatal_in (pint_folder region ++# "example/") (pint_region_rules region file) names []

:= pint_region_fatal (region : string) (names : list string) : list (string * fatal_check) =
    := base = pint_judged region names "PINT-UBL-validation-preprocessed.sch"
    listm::append base (pint_judged region names "PINT-jurisdiction-aligned-rules.sch")

:= pint_first_failures (region : string) (name : string) : string =
    := path = pint_folder region ++# "example/" ++# name
    := base = first_failures (pint_region_rules region "PINT-UBL-validation-preprocessed.sch") path
    base ++# " || " ++# first_failures (pint_region_rules region "PINT-jurisdiction-aligned-rules.sch") path

///> rust
test pint_regional_examples_pass_their_rules =
    := my = pint_region_fatal "my" (pint_my_examples ())
    := sg = pint_region_fatal "sg" (pint_sg_examples ())
    := found = listm::append my sg
    := report (region : string) (row : string * fatal_check) =
        := name, fatal = row
        := first = pint_first_failures region name
        console::write_line (
            "pint regional fatal: " ++# region ++# " " ++# name ++# " " ++# fatal_text fatal ++# " :: " ++# first
        )
    listm::iter (report "my") my
    listm::iter (report "sg") sg
    := judged = (listm::length (pint_my_examples ()) : i32) + (listm::length (pint_sg_examples ()) : i32)
    console::write_line ("pint regional examples judged: " ++# sm'::obj_to_string judged)
    ?= found ?|
    | [] => ()
    | (name, fatal) :: _ => failwith (name ++# " has PINT fatal findings: " ++# fatal_text fatal)

