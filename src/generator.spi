:= cfdi_complement
    (module_name : string) (file : string) (root : string) (space : string) (catalog : list (string * string))
    : family_root
    =
    {
        module_name = module_name
        schema_path = (fiscal_paths.under "deps/corpus/mx/complements/") ++# file
        root_element = root
        root_type = root
        target_namespace = space
        source = Xsd catalog
        known_defect = None
        documents = []
        ubl_json_documents = []
    }

