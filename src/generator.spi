///> rust
test unqualified_schemas_prefix_the_example_root =
    ? qualifies_children (fatturapa_1_2_3 ()) ?> failwith "FatturaPA leaves its children unqualified"
    ? qualifies_children (ksef_fa_3 ()) = !- ?> failwith "KSeF qualifies its children"
    := fattura = family_example_check (fatturapa_1_2_3 ())
    ? sm'::contains "xml.element \"p:FatturaElettronica\" ((\"xmlns:p\", " fattura = !-
    ?> failwith "an unqualified root is prefixed so its children stay in no namespace"
    ? sm'::contains "xml.element \"Faktura\" ((\"xmlns\", " (family_example_check (ksef_fa_3 ())) = !-
    ?> failwith "a qualified root keeps the default namespace"

///> rust
test the_law_path_uses_the_tags_the_reader_reads =
    := ubl = ubl_creditnote_2_1 ()
    ? law_missing_path ubl (family_schema ubl) <> Some "cbc:ID"
    ?> failwith "UBL reads cbc:ID, so a missing ID is reported under its prefixed tag"
    := verifactu = verifactu_registro ()
    ? law_missing_path verifactu (family_schema verifactu) <> Some "Cabecera/sf:ObligadoEmision/sf:NombreRazon"
    ?> failwith "each step of the path is the tag the reader reads, prefix included"
    ? sm'::contains "xml_codec.pruned \"ID\" " (law_pruned_line ubl "cbc:ID") = !-
    ?> failwith "pruning matches local names, so the pruned leaf drops its prefix"

///> rust
test a_long_package_list_wraps_like_taplo =
    ?
        module_package [ "generated_fiscal_runtime" ]
        <> "packageDir = '../../deps/spiral/lib'\npackages = ['|core-', 'spiral-', '../generated_fiscal_runtime-']\n"
    ?> failwith "a short package list stays on one line"
    := wrapped = module_package [ "generated_fiscal_runtime"; "generated_cfdi_tfd_1_1"; "generated_cfdi_pagos_2_0" ]
    ?
        sm'::starts_with "packageDir = '../../deps/spiral/lib'\npackages = [\n    '|core-',\n    'spiral-',\n" wrapped
        = !-
    ?> failwith "past 120 columns each entry takes its own line"
    ? sm'::ends_with "    '../generated_cfdi_pagos_2_0-',\n]\n" wrapped = !-
    ?> failwith "the last entry keeps its comma, like taplo"
