///> rust
test unqualified_schemas_prefix_the_example_root =
    ? qualifies_children (fatturapa_1_2_3 ()) ?> failwith "FatturaPA leaves its children unqualified"
    ? qualifies_children (ksef_fa_3 ()) = !- ?> failwith "KSeF qualifies its children"
    := fattura = family_example_check (fatturapa_1_2_3 ())
    ? sm'.contains "xml.element \"p:FatturaElettronica\" ((\"xmlns:p\", " fattura = !-
    ?> failwith "an unqualified root is prefixed so its children stay in no namespace"
    ? sm'.contains "xml.element \"Faktura\" ((\"xmlns\", " (family_example_check (ksef_fa_3 ())) = !-
    ?> failwith "a qualified root keeps the default namespace"
