///- --package . --timeout 1400000
:< sm'_operators
:< xsd
:< xsd_emit
:< families

:= module_package (dependencies : list string) (module_name : string) : string =
    "packageDir: ../../deps/spiral/lib\npackages:\n    |core-\n    spiral-\n"
    ++# join_with "" (listm::map (\ unit => "    ../" ++# unit ++# "-\n") dependencies) ""
    ++# "modules:\n    "
    ++# module_name
    ++# "\n"

:= ensure_folder (folder : string) : () =
    ?= file_system::create_dir_all folder |> resultm::unbox ?|
    | Ok _ => ()
    | Error _ => failwith ("generator: cannot create " ++# folder)

:= cell_budget_ms (text : string) : i32 =
    := scaled = sm'::length text / 10i32 * 16i32
    ? scaled > 2400000i32 ?> scaled |: 2400000i32

:= write_generated_module_with (dependencies : list string) (module_name : string) (text : string) : () =
    := folder = fiscal_paths::under ("generated/" ++# module_name)
    ensure_folder folder
    file_system::write_all_text (folder ++# "/package.spiproj") (module_package dependencies module_name)
    file_system::write_all_text
        (folder ++# "/" ++# module_name ++# ".spi")
        ("///- --package . --timeout " ++# int_text (cell_budget_ms text) ++# "\n" ++# text)

:= write_generated_module (module_name : string) (text : string) : () = write_generated_module_with [] module_name text

:= remove_generated_module (module_name : string) : () =
    := folder = fiscal_paths::under ("generated/" ++# module_name)
    ? file_system::directory_exists folder
    ?>
        ?= file_system::remove_dir_all folder |> resultm::unbox ?|
        | Ok _ => ()
        | Error _ => failwith ("generator: cannot remove " ++# folder)

///> rust
test a_family_without_certificates_leaves_no_certificates_unit =
    write_generated_module "generated_stale_unit_probe" "inl stale () = ()\n"
    remove_generated_module "generated_stale_unit_probe"
    remove_generated_module "generated_stale_unit_probe"
    ? file_system::directory_exists (fiscal_paths::under "generated/generated_stale_unit_probe")
    ?> failwith "a unit the emitter no longer produces is removed"

///> rust
test generates_the_uf_code_union =
    := schema =
        file_system::read_all_text (
            fiscal_paths::under "deps/corpus/DFe.NET/NFe.AppTeste/Schemas/tiposBasico_v4.00.xsd"
        )
        |> read_schema
    := text = generate_enumerations schema
    ? sm'::contains "union x_t_cod_uf_ibge =" text = !- ?> failwith "TCodUfIBGE union"
    ? sm'::contains "    | TCodUfIBGE_35" text = !- ?> failwith "case TCodUfIBGE_35"
    ? sm'::contains "    | \"35\" => Some TCodUfIBGE_35" text = !- ?> failwith "parser arm"

:= qualifies_children (family : family_root) : bool =
    ?= first_named "schema" (xml::read_xml (xml::read_text_replacing_invalid_utf8 family::schema_path)) ?|
    | Some (attributes, _) => attribute_or "elementFormDefault" "unqualified" attributes = "qualified"
    | None => !+

:~ ^ declared_prefixes (schema_text : string) (attributes : list (string * string)) (acc : string) : string =
    ?= attributes ?|
    | (key, value) :: rest =>
        := known = value = "http://www.w3.org/2001/XMLSchema" || value = "http://www.w3.org/2000/09/xmldsig#"
        := referenced = sm'::contains ("ref=\"" ++# xml::local_name key ++# ":") schema_text
        ? sm'::starts_with "xmlns:" key && known = !- && referenced
        ?> declared_prefixes schema_text rest (acc ++# "(\"" ++# key ++# "\", \"" ++# value ++# "\") :: ")
        |: declared_prefixes schema_text rest acc
    | [] => acc

:= prefix_declarations (family : family_root) : string =
    := schema_text = xml::read_text_replacing_invalid_utf8 family::schema_path
    ?= first_named "schema" (xml::read_xml schema_text) ?|
    | Some (attributes, _) => declared_prefixes schema_text attributes ""
    | None => ""

:= example_document (family : family_root) (value : string) : string =
    := t = root_type_name family
    := root, declaration =
        ? qualifies_children family ?> tag_text family::root_element, "xmlns" |: "p:" ++# tag_text family::root_element, "xmlns:p"
    "xml.element \""
    ++# root
    ++# "\" ((\""
    ++# declaration
    ++# "\", \""
    ++# namespace_text family::target_namespace
    ++# "\") :: "
    ++# prefix_declarations family
    ++# t
    ++# "_attributes "
    ++# value
    ++# ") ("
    ++# t
    ++# "_children "
    ++# value
    ++# ")"

:= signed_text (expression : string) : string =
    "xml.write_node (xml.with_namespace \"Signature\" \"http://www.w3.org/2000/09/xmldsig#\" " ++# expression ++# ")"

:= repo_relative (path : string) : string =
    := prefix = fiscal_paths::root () ++# "/"
    ? sm'::starts_with prefix path
    ?> sm'::substring (sm'::length prefix) (sm'::length path - sm'::length prefix) path
    |: path

:= json_example_check (family : family_root) : string =
    := t = root_type_name family
    := root = "\"" ++# tag_text family::root_element ++# "\""
    "///> rust\ntest "
    ++# module_text family::module_name
    ++# "_writes_its_example =\n"
    ++# "    inl example = "
    ++# t
    ++# "_example 0i32\n"
    ++# "    inl document = xml.element "
    ++# root
    ++# " ("
    ++# t
    ++# "_attributes example) ("
    ++# t
    ++# "_children example)\n"
    ++# "    inl schema = file_system.read_all_text (generated_fiscal_runtime.sample_path \"../"
    ++# repo_relative family::schema_path
    ++# "\")\n"
    ++# "    inl text = json_schema.json_document_text schema document\n"
    ++# "    file_system.directory_create_all (generated_fiscal_runtime.sample_path \"\") |> ignore\n"
    ++# "    file_system.write_all_text (generated_fiscal_runtime.sample_path \""
    ++# module_text family::module_name
    ++# "_example.json\") text\n"
    ++# "    match json_schema.json_document "
    ++# root
    ++# " text with\n"
    ++# "    | node :: [] =>\n"
    ++# "        inl again = json_schema.json_document_text schema ("
    ++# t
    ++# "_to_xml "
    ++# root
    ++# " ("
    ++# t
    ++# "_of_xml node))\n"
    ++# "        if again <> text then failwith \"the JSON example round-trips through the typed reader and writer\"\n"
    ++# "    | _ => failwith \"one root\"\n"

:= is_json_family (family : family_root) : bool = ?= family::source ?| JsonSchema => !+ | Xsd _ => !-

:= json_document_checks (family : family_root) : string =
    := t = root_type_name family
    := root = "\"" ++# tag_text family::root_element ++# "\""
    := quoted = listm::map (\ path => "\"" ++# path ++# "\"") family::documents
    ?= family::documents ?|
    | _ :: _ ?& is_json_family family =>
        "\n///> rust\ntest "
        ++# module_text family::module_name
        ++# "_reads_its_documents =\n"
        ++# "    inl schema = file_system.read_all_text (generated_fiscal_runtime.sample_path \"../"
        ++# repo_relative family::schema_path
        ++# "\")\n"
        ++# "    inl documents = ["
        ++# join_with "; " quoted ""
        ++# "]\n"
        ++# "    inl check (path : string) : list string =\n"
        ++# "        inl text = file_system.read_all_text (generated_fiscal_runtime.sample_path (sm'.(++#) \"../\" path))\n"
        ++# "        match json_schema.json_document "
        ++# root
        ++# " text with\n"
        ++# "        | node :: [] =>\n"
        ++# "            inl expected = json_schema.json_document_text schema node\n"
        ++# "            inl again = json_schema.json_document_text schema ("
        ++# t
        ++# "_to_xml "
        ++# root
        ++# " ("
        ++# t
        ++# "_of_xml node))\n"
        ++# "            if again = expected then [] else\n"
        ++# "                [sm'.(++#) path \": the typed reader does not keep every member\"]\n"
        ++# "        | _ => [sm'.(++#) path \": not one root\"]\n"
        ++# "    inl failures = listm.concat (listm.map check documents)\n"
        ++# "    inl _ =\n"
        ++# "        match failures with\n"
        ++# "        | first :: _ =>\n"
        ++# "            inl count = sm'.obj_to_string (listm.length failures : i32)\n"
        ++# "            inl message = sm'.(++#) \" real documents do not read back unchanged; first: \" first\n"
        ++# "            failwith (sm'.(++#) count message)\n"
        ++# "        | [] => ()\n"
    | _ => ""

:= document_round_trip (family : family_root) (witness : string) (name : string) (reader : string) : string =
    := t = root_type_name family
    "    inl "
    ++# name
    ++# " (path : string) : list string =\n"
    ++# "        inl text = file_system.read_all_text (generated_fiscal_runtime.sample_path (sm'.(++#) \"../\" path))\n"
    ++# "        match "
    ++# reader
    ++# " text with\n"
    ++# "        | node :: [] =>\n"
    ++# "            match xml.first_difference node ("
    ++# t
    ++# "_to_xml \""
    ++# tag_text family::root_element
    ++# "\" ("
    ++# t
    ++# "_of_xml"
    ++# witness
    ++# " node)) with\n"
    ++# "            | Some difference => [sm'.(++#) path (sm'.(++#) \": \" difference)]\n"
    ++# "            | None => []\n"
    ++# "        | _ => [sm'.(++#) path \": not one root element\"]\n"

:= json_round_trip (family : family_root) (witness : string) (name : string) : string =
    := t = root_type_name family
    := root = "\"" ++# tag_text family::root_element ++# "\""
    "    let rec xml_size (n : xml.xml_node) : i32 =\n"
    ++# (
        "        1i32 + listm.length (xml.data_attributes (xml.element_attributes n)) + xml_sizes "
        ^^ "(xml.element_children n)\n"
    )
    ++# "    and let xml_sizes (nodes : list xml.xml_node) : i32 =\n"
    ++# "        match nodes with\n"
    ++# "        | n :: rest => xml_size n + xml_sizes rest\n"
    ++# "        | [] => 0i32\n"
    ++# (
        "    let rec take_named (name : string) (nodes : list xml.xml_node) : option (xml.xml_node * list "
        ^^ "xml.xml_node) =\n"
    )
    ++# "        match nodes with\n"
    ++# "        | n :: rest =>\n"
    ++# "            if xml.node_name n = name then Some (n, rest)\n"
    ++# "            else\n"
    ++# "                match take_named name rest with\n"
    ++# "                | Some (m, others) => Some (m, n :: others)\n"
    ++# "                | None => None\n"
    ++# "        | [] => None\n"
    ++# "    let rec size_drift (a : list xml.xml_node) (b : list xml.xml_node) : string =\n"
    ++# "        match a with\n"
    ++# "        | x :: xs =>\n"
    ++# "            match take_named (xml.node_name x) b with\n"
    ++# "            | Some (y, others) =>\n"
    ++# "                if xml_size x = xml_size y then size_drift xs others\n"
    ++# "                else\n"
    ++# "                    inl inner = size_drift (xml.element_children x) (xml.element_children y)\n"
    ++# "                    sm'.(++#) (xml.node_name x) (sm'.(++#) \"/\" inner)\n"
    ++# "            | None => sm'.(++#) (xml.node_name x) \" dropped\"\n"
    ++# "        | [] =>\n"
    ++# "            match b with\n"
    ++# "            | y :: _ => sm'.(++#) (xml.node_name y) \" added\"\n"
    ++# "            | [] => \"here\"\n"
    ++# "    inl "
    ++# name
    ++# " (path : string) : list string =\n"
    ++# "        inl text = file_system.read_all_text (generated_fiscal_runtime.sample_path (sm'.(++#) \"../\" path))\n"
    ++# "        match json_schema.ubl_json_document text with\n"
    ++# "        | node :: [] =>\n"
    ++# "            inl once = "
    ++# t
    ++# "_to_xml "
    ++# root
    ++# " ("
    ++# t
    ++# "_of_xml"
    ++# witness
    ++# " node)\n"
    ++# "            inl twice = "
    ++# t
    ++# "_to_xml "
    ++# root
    ++# " ("
    ++# t
    ++# "_of_xml"
    ++# witness
    ++# " once)\n"
    ++# "            match xml.first_difference once twice with\n"
    ++# (
        "            | Some difference => [sm'.(++#) path (sm'.(++#) \": the typed round trip is not stable: \" "
        ^^ "difference)]\n"
    )
    ++# "            | None =>\n"
    ++# "                if xml_size node = xml_size once then []\n"
    ++# "                else\n"
    ++# "                    inl before = sm'.obj_to_string (xml_size node)\n"
    ++# "                    inl after = sm'.obj_to_string (xml_size once)\n"
    ++# "                    inl drift = size_drift (xml.element_children node) (xml.element_children once)\n"
    ++# "                    inl where = sm'.(++#) after (sm'.(++#) \" at \" drift)\n"
    ++# "                    inl detail = sm'.(++#) before (sm'.(++#) \" -> \" where)\n"
    ++# "                    inl lost = \": the typed reader does not keep every element, text and attribute: \"\n"
    ++# "                    [sm'.(++#) path (sm'.(++#) lost detail)]\n"
    ++# "        | _ => [sm'.(++#) path \": not one root element\"]\n"

:= document_checks (family : family_root) (witness : string) : string =
    := quoted (paths : list string) : string = join_with "; " (listm::map (\ path => "\"" ++# path ++# "\"") paths) ""
    := reads =
        ?= family::ubl_json_documents ?|
        | [] =>
            document_round_trip family witness "check" "xml.read_xml"
            ++# "    inl failures = listm.concat (listm.map check documents)\n"
        | json =>
            "    inl json_documents = ["
            ++# quoted json
            ++# "]\n"
            ++# document_round_trip family witness "check" "xml.read_xml"
            ++# json_round_trip family witness "check_json"
            ++# "    inl failures =\n"
            ++# "        listm.append (listm.concat (listm.map check documents)) "
            ++# "(listm.concat (listm.map check_json json_documents))\n"
    ?= family::documents, family::ubl_json_documents ?|
    | [], [] => ""
    | _ =>
        "    inl documents = ["
        ++# quoted family::documents
        ++# "]\n"
        ++# reads
        ++# "    inl _ =\n"
        ++# "        match failures with\n"
        ++# "        | first :: _ =>\n"
        ++# "            inl count = sm'.obj_to_string (listm.length failures : i32)\n"
        ++# "            inl message = sm'.(++#) \" real documents do not read back unchanged; first: \" first\n"
        ++# "            failwith (sm'.(++#) count message)\n"
        ++# "        | [] => ()\n"

:= xsd_example_check (family : family_root) : string =
    := t = root_type_name family
    := pinned =
        ?= family::known_defect ?|
        | Some defect => " fails \"" ++# defect ++# "\""
        | None => ""
    "///> rust\ntest "
    ++# module_text family::module_name
    ++# "_writes_its_example"
    ++# pinned
    ++# " =\n"
    ++# "    inl example = "
    ++# t
    ++# "_example 0i32\n"
    ++# "    inl document = "
    ++# example_document family "example"
    ++# "\n"
    ++# "    file_system.directory_create_all (generated_fiscal_runtime.sample_path \"\") |> ignore\n"
    ++# "    file_system.write_all_text (generated_fiscal_runtime.sample_path \""
    ++# module_text family::module_name
    ++# "_example.xml\") ("
    ++# signed_text "document"
    ++# ")\n"

:= family_example_check (family : family_root) : string =
    ?= family::source ?|
    | JsonSchema => json_example_check family
    | Xsd _ => xsd_example_check family

:= family_bench (family : family_root) (witness : string) : string =
    := t = root_type_name family
    := m = module_text family::module_name
    := one = "failwith \"one " ++# tag_text family::root_element ++# " element\"\n"
    := measurable =
        ?= family::source ?|
        | JsonSchema => !-
        | Xsd _ =>
            ?= family::known_defect ?|
            | Some _ => !-
            | None => !+
    ? measurable = !- ?> ""
    |:
        "    inl text = file_system.read_all_text (generated_fiscal_runtime.sample_path \""
        ++# m
        ++# "_example.xml\")\n"
        ++# "    let rec runs (left : i32) (parses : list i64) (writes : list i64) (bytes : i64)"
        ++# " : list i64 * list i64 * i64 =\n"
        ++# "        if left = 0i32 then parses, writes, bytes\n"
        ++# "        else\n"
        ++# "            inl watch = date_time.stopwatch ()\n"
        ++# "            date_time.stopwatch_start watch\n"
        ++# "            inl start = date_time.stopwatch_elapsed_microseconds watch\n"
        ++# "            match xml.read_xml text with\n"
        ++# "            | node :: [] =>\n"
        ++# "                inl parsed = "
        ++# t
        ++# "_of_xml"
        ++# witness
        ++# " node\n"
        ++# "                inl parsed_at = date_time.stopwatch_elapsed_microseconds watch\n"
        ++# "                inl written = xml.write_node ("
        ++# t
        ++# "_to_xml \""
        ++# tag_text family::root_element
        ++# "\" parsed)\n"
        ++# "                inl written_at = date_time.stopwatch_elapsed_microseconds watch\n"
        ++# "                inl parses = generated_fiscal_runtime.insert_run (parsed_at - start) parses\n"
        ++# "                inl writes = generated_fiscal_runtime.insert_run (written_at - parsed_at) writes\n"
        ++# "                runs (left - 1i32) parses writes (bytes + sm'.length written)\n"
        ++# "            | _ => "
        ++# one
        ++# "    inl _ = runs (dyn 5i32) [] [] 0i64\n"
        ++# "    inl parses, writes, bytes = runs (dyn 31i32) [] [] 0i64\n"
        ++# "    inl row = sm'.(++#) \""
        ++# m
        ++# " parse_us \" (generated_fiscal_runtime.median parses)\n"
        ++# "    inl row = sm'.(++#) row (sm'.(++#) \" write_us \" (generated_fiscal_runtime.median writes))\n"
        ++# "    inl row = sm'.(++#) row (sm'.(++#) \" runs 31 bytes \" (sm'.obj_to_string bytes))\n"
        ++# "    console.write_line row\n"
        ++# "    match xml.read_xml text with\n"
        ++# "    | node :: [] =>\n"
        ++# "        inl parsed = "
        ++# t
        ++# "_of_xml"
        ++# witness
        ++# " node\n"
        ++# "        inl document = "
        ++# example_document family "parsed"
        ++# "\n"
        ++# "        inl folder = generated_fiscal_runtime.sample_path \"../target/bench\"\n"
        ++# "        match file_system.directory_create_all folder with\n"
        ++# "        | Ok _ => file_system.write_all_text (sm'.(++#) folder \"/ours-"
        ++# m
        ++# "_example.xml\") ("
        ++# signed_text "document"
        ++# ")\n"
        ++# "        | Error _ => failwith \"cannot create target/bench\"\n"
        ++# "    | _ => "
        ++# one

:= family_nominal_check \* form. (family : family_root) (schema : xsd_schema form) : string =
    ?= any_validated_type schema ?|
    | Some t =>
        "\n///> rust\ntest "
        ++# module_text family::module_name
        ++# "_keeps_raw_strings_out fails \"Unification failure\" =\n    "
        ++# t
        ++# "_to_string \"raw\"\n"
    | None => ""

:= certificate_check (family : family_root) : string =
    "\n///> rust\ntest " ++# module_text family::module_name ++# "_certificates_hold =\n    certificates_checked () |> ignore\n"

:= family_schema (family : family_root) =
    ?= family::source ?|
    | Xsd catalog => (xsd_resolve::load_schema_tree_with catalog family::schema_path)::schema
    | JsonSchema =>
        := text = xml::read_text_replacing_invalid_utf8 family::schema_path
        := model = json_schema::schema_of_json_schema (definition_text family::root_type) text
        xsd_resolve::finalize_names (xsd_resolve::qualify_schema [] model)

:= complement_member_of (complement : string * family_root) =
    := case_name, member = complement
    { case_name = case_name; module_name = module_text member::module_name; schema = family_schema member }

:= complement_unit (complement : string * family_root) : string =
    := _, member = complement
    module_text member::module_name

:= signatures_of (family : family_root) : list string = ? has_extra Signed family::extras ?> [ "Signature" ] |: []

:= unit_checks_of (family : family_root) : string =
    ? has_extra NfeModelChecks family::extras = !- ?> ""
    |:
        "\n///> rust\ntest generated_nfe_model_type_checks =\n"
        ++# "    match x_t_cod_uf_ibge_of_string \"35\" with\n"
        ++# (
            "    | Some code => if x_t_cod_uf_ibge_to_string code <> \"35\" then failwith \"TCodUfIBGE 35 round "
            ^^ "trip\"\n"
        )
        ++# "    | None => failwith \"35 parses as TCodUfIBGE\"\n"
        ++# "    if x_t_cnpj_is_valid \"12345678000195\" = false then failwith \"a 14-digit CNPJ is valid\"\n"
        ++# "    if x_t_cnpj_is_valid \"1234567800019\" then failwith \"a 13-digit CNPJ is not\"\n"
        ++# (
            "    match xml.read_xml \"<enderEmit><xLgr>Rua A</xLgr><nro>10</nro><xBairro>Centro</xBairro><cMun>3550"
            ^^ "308</cMun><xMun>Sao Paulo</xMun><UF>SP</UF><CEP>01001000</CEP><cPais>1058</cPais></enderEmit>\" with\n"
        )
        ++# "    | node :: [] =>\n"
        ++# "        inl address = x_t_ender_emi_of_xml node\n"
        ++# (
            "        if x_t_ender_emi_x_mun_to_string address.x_mun <> \"Sao Paulo\" || x_t_ender_emi_cep_to_string "
            ^^ "address.cep <> \"01001000\" then failwith \"TEnderEmi text fields\"\n"
        )
        ++# "        if x_t_uf_emi_to_string address.uf <> \"SP\" then failwith \"TEnderEmi UF enumeration\"\n"
        ++# (
            "        if xml.same_node node (x_t_ender_emi_to_xml \"enderEmit\" address) = false then failwith "
            ^^ "\"TEnderEmi XML round trip\"\n"
        )
        ++# "        match address.c_pais with\n"
        ++# "        | Some _ => ()\n"
        ++# "        | None => failwith \"TEnderEmi optional cPais\"\n"
        ++# "    | _ => failwith \"one enderEmit element\"\n"

:~ ^ write_family_modules (roots : list family_root) (count : i32) : i32 =
    ?= roots ?|
    | family :: rest =>
        := schema = family_schema family
        := signatures = signatures_of family
        := root_staged = has_name (root_type_name family) (staged_type_names signatures schema)
        := documents_witness = ? root_staged ?> " Signed" |: ""
        := example_witness = ? root_staged ?> " Unsigned" |: ""
        := xml_documents = ? is_json_family family ?> "" |: document_checks family documents_witness
        := one_cell = family_example_check family ++# xml_documents ++# family_bench family example_witness
        := checks =
            one_cell ++# family_nominal_check family schema ++# json_document_checks family ++# unit_checks_of family
        := complements = complements_of family
        := any_content =
            ?= complements ?|
            | [] => untyped_any_content ()
            | _ =>
                := members = listm::map complement_member_of complements
                generate_complements members ++# complement_any_content ()
        := main, certificates = generated_units_signed signatures any_content schema
        write_generated_module (generated_runtime::unit_name ()) (generated_runtime::unit_text ())
        write_generated_module_with
            (generated_runtime::unit_name () :: listm::map complement_unit complements)
            (module_text family::module_name)
            (main ++# "\n" ++# checks)
        ? certificates <> ""
        ?> write_generated_module (module_text family::module_name ++# "_certificates") (certificates ++# certificate_check family)
        |: remove_generated_module (module_text family::module_name ++# "_certificates")
        write_family_modules rest (count + 1i32)
    | [] => count

///> rust
test generates_every_family_version =
    ? write_family_modules (family_roots ()) 0i32 <> 12i32 ?> failwith "every family root is written"

///> rust
test generates_nfe_v4_with_a_staged_signature =
    ? write_family_modules [ nfe_v4_00 () ] 0i32 <> 1i32 ?> failwith "NF-e 4.00 is written as a family"
    := text = file_system::read_all_text (fiscal_paths::under "generated/generated_nfe_v4/generated_nfe_v4.spi")
    ? sm'::contains "inl x_t_cnpj_is_valid (s : string) : bool = " text = !- ?> failwith "TCnpj validator"
    ? sm'::contains "union x_t_cod_uf_ibge =" text = !- ?> failwith "TCodUfIBGE union"
    ? sm'::contains "nominal x_tn_fe s =" text = !- ?> failwith "TNFe takes the signing stage"
    ? sm'::contains "        signature : staged s x_signature_type" text = !-
    ?> failwith "a signer's unsigned NF-e 4.00 leaves its signature pending"
    ? sm'::contains "x_tn_fe_example (k : i32) : x_tn_fe unsigned" text = !- ?> failwith "the example is unsigned"

///> rust
test generates_nfe_events_with_a_staged_author_signature =
    ? write_family_modules (nfe_events ()) 0i32 <> 3i32 ?> failwith "the three NF-e event proofs are written"
    := unit = "generated/generated_nfe_evento_canc_v1_00/generated_nfe_evento_canc_v1_00.spi"
    := text = file_system::read_all_text (fiscal_paths::under unit)
    ? sm'::contains "nominal x_t_evento s =" text = !- ?> failwith "the signed event takes the signing stage"
    ? sm'::contains "        signature : staged s x_signature_type" text = !-
    ?> failwith "the author's required event signature is staged"
    ? sm'::contains "signature : option (x_signature_type)" text = !-
    ?> failwith "the authority's optional verdict signature stays an option"

///> rust
test generates_cfdi_4_0 =
    ? write_family_modules [ cfdi_tfd_1_1 (); cfdi_pagos_2_0 (); cfdi_v4_0 () ] 0i32 <> 3i32
    ?> failwith "CFDI 4.0 is written with its two complements"
    := unit = fiscal_paths::under "generated/generated_cfdi_v4_0/"
    ?
        sm'::contains
            "type any_content = list complement\n"
            (file_system::read_all_text (unit ++# "generated_cfdi_v4_0.spi"))
        = !-
    ?> failwith "CFDI types its complement content"
    := package = file_system::read_all_text (unit ++# "package.spiproj")
    ? sm'::contains "    ../generated_cfdi_tfd_1_1-\n    ../generated_cfdi_pagos_2_0-\n" package = !-
    ?> failwith "the CFDI unit's package lists its complement units"

///> rust
test generates_ubl_invoice_2_1 =
    ? write_family_modules (ubl_invoice_2_1 () :: []) 0i32 <> 1i32 ?> failwith "UBL Invoice 2.1 is written"

///> rust
test ubl_json_documents_read_through_the_transcoder =
    := invoice = document_checks (ubl_invoice_2_1 ()) ""
    ? sm'::contains "listm.map check_json json_documents" invoice = !-
    ?> failwith "UBL Invoice reads its JSON documents through the transcoder"
    ? sm'::contains "match json_schema.ubl_json_document text with" invoice = !-
    ?> failwith "the JSON documents become the element trees the typed reader takes"
    ? sm'::contains "check_json" (document_checks (ubl_creditnote_2_1 ()) "")
    ?> failwith "a family without JSON documents keeps the XML-only check"

