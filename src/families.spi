///- --package . --timeout 1200000
:< sm'_operators
:< xsd
:< xsd_emit

:! repo_path = string

:= repo_text ((repo_path text) : repo_path) : string = text

:= repo_file (path : repo_path) : string = fiscal_paths::under (repo_text path)

:| schema_source =
    | Xsd : list (string * repo_path)
    | JsonSchema

:| document_source =
    | Listed : list string
    | Manifest : repo_path

:= catalog_of (entries : list (string * repo_path)) : xsd_resolve::schema_catalog =
    listm::map (\ (location, path) => location, repo_file path) entries

:| family_extra =
    | Signed
    | CfdiComplements
    | ModelChecks : string
    | DocumentDefect : string * string

:~ ^ has_extra (extra : family_extra) (extras : list family_extra) : bool =
    ?= extras ?|
    | x :: rest => x = extra || has_extra extra rest
    | [] => !-

:~ ^ model_check_texts (extras : list family_extra) : string =
    ?= extras ?|
    | (ModelChecks text) :: rest => text ++# model_check_texts rest
    | _ :: rest => model_check_texts rest
    | [] => ""

:~ ^ document_defects (extras : list family_extra) : list (string * string) =
    ?= extras ?|
    | (DocumentDefect defect) :: rest => defect :: document_defects rest
    | _ :: rest => document_defects rest
    | [] => []

:! module_id = string

:= module_text ((module_id text) : module_id) : string = text

:== family_root =
    {
        module_name : module_id
        schema_path : repo_path
        root_element : tag_name
        root_type : definition_name written
        target_namespace : namespace_uri
        source : schema_source
        known_defect : option string
        documents : document_source
        ubl_json_documents : document_source
        extras : list family_extra
    }

:= root_type_name (family : family_root) : string = type_name (definition_text family::root_type)

:= bare_family
    (module : module_id) (schema : repo_path) (root : tag_name) (ty : definition_name written) (space : namespace_uri)
    : family_root
    =
    {
        module_name = module
        schema_path = schema
        root_element = root
        root_type = ty
        target_namespace = space
        source = Xsd []
        known_defect = None
        documents = Listed []
        ubl_json_documents = Listed []
        extras = []
    }

:= cfdi_v4_0 () : family_root =
    {
        module_name = module_id "generated_cfdi_v4_0"
        schema_path = repo_path "deps/corpus/mx/cfdi/cfdv40.xsd"
        root_element = tag_name "Comprobante"
        root_type = definition_name "Comprobante"
        target_namespace = namespace_uri "http://www.sat.gob.mx/cfd/4"
        source =
            Xsd [
                (
                    "http://www.sat.gob.mx/sitio_internet/cfd/catalogos/catCFDI.xsd",
                    repo_path "deps/corpus/mx/cfdi/catCFDI.xsd"
                )
                (
                    "http://www.sat.gob.mx/sitio_internet/cfd/tipoDatos/tdCFDI/tdCFDI.xsd",
                    repo_path "deps/corpus/mx/cfdi/tdCFDI.xsd"
                )
            ]
        known_defect = None
        documents = Listed [ "deps/corpus/mx/stamped/cfdiutils-cfdi40-valid.xml" ]
        ubl_json_documents = Listed []
        extras = [ CfdiComplements ]
    }

:= cfdi_complement
    (module_name : string) (file : string) (root : string) (space : string) (catalog : list (string * repo_path))
    : family_root
    =
    {
        module_name = module_id module_name
        schema_path = repo_path ("deps/corpus/mx/complements/" ++# file)
        root_element = tag_name root
        root_type = definition_name root
        target_namespace = namespace_uri space
        source = Xsd catalog
        known_defect = None
        documents = Listed []
        ubl_json_documents = Listed []
        extras = []
    }

:= td_cfdi_import () : string * repo_path =
    "http://www.sat.gob.mx/sitio_internet/cfd/tipoDatos/tdCFDI/tdCFDI.xsd", repo_path "deps/corpus/mx/cfdi/tdCFDI.xsd"

:= cat_cfdi_import () : string * repo_path =
    "http://www.sat.gob.mx/sitio_internet/cfd/catalogos/catCFDI.xsd", repo_path "deps/corpus/mx/cfdi/catCFDI.xsd"

:= cat_pagos_import () : string * repo_path =
    "http://www.sat.gob.mx/sitio_internet/cfd/catalogos/Pagos/catPagos.xsd",
    repo_path "deps/corpus/mx/complements/catPagos.xsd"

:= cfdi_tfd_1_1 () : family_root =
    cfdi_complement
        "generated_cfdi_tfd_1_1"
        "TimbreFiscalDigitalv11.xsd"
        "TimbreFiscalDigital"
        "http://www.sat.gob.mx/TimbreFiscalDigital"
        [ td_cfdi_import () ]

:= cfdi_pagos_2_0 () : family_root =
    cfdi_complement
        "generated_cfdi_pagos_2_0"
        "Pagos20.xsd"
        "Pagos"
        "http://www.sat.gob.mx/Pagos20"
        [ cat_cfdi_import (); td_cfdi_import (); cat_pagos_import () ]

:= complements_of (family : family_root) : list (string * family_root) =
    ? has_extra CfdiComplements family::extras
    ?> [ ("TimbreFiscalDigital11", cfdi_tfd_1_1 ()); ("Pagos20", cfdi_pagos_2_0 ()) ]
    |: []

:= signed_family (module_name : string) (schema_path : string) (root : string) (root_type : string) (space : string)
    : family_root
    =
    {
        module_name = module_id module_name
        schema_path = repo_path schema_path
        root_element = tag_name root
        root_type = definition_name root_type
        target_namespace = namespace_uri space
        source = Xsd []
        known_defect = None
        documents = Listed []
        ubl_json_documents = Listed []
        extras = [ Signed ]
    }

