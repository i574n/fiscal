:= hacienda_document (root : string) (suffix : string) : family_root =
    := first = sm'::substring 0i32 1i32 root
    := rest = sm'::substring 1i32 (sm'::length root - 1i32) root
    {
        module_name = module_id ("generated_cr_" ++# suffix ++# "_4_4")
        schema_path = fiscal_paths::under ("deps/corpus/cr/hacienda/v4.4/" ++# root ++# "_V4.4.xsd")
        root_element = tag_name root
        root_type = definition_name root
        target_namespace =
            namespace_uri ("https://cdn.comprobanteselectronicos.go.cr/xml-schemas/v4.4/" ++# sm'::to_lower first ++# rest)
        source = Xsd [ ("../../xmldsig-core-schema.xsd", local_xmldsig ()) ]
        known_defect = None
        documents = []
        ubl_json_documents = []
        extras = [ Signed ]
    }

