:! brazil = ()
:! europe_ubl = ()
:! mexico = ()

:| regime_witness r =
    | Brazil :: regime_witness brazil
    | EuropeUbl :: regime_witness europe_ubl
    | Mexico :: regime_witness mexico

:! regime_family r = family_root

:= family_root_of \* r. ((regime_family root) : regime_family r) : family_root = root

:= brazilian_families () : list (regime_family brazil) =
    listm::map regime_family (listm::append (family_roots ()) (nfe_v4_00 () :: nfe_events ()))

:= ubl_families () : list (regime_family europe_ubl) =
    listm::map regime_family (ubl_invoice_2_1 () :: ubl_creditnote_2_1 () :: ubl_business_documents_2_1 ())

:= mexican_families () : list (regime_family mexico) = listm::map regime_family [ cfdi_v4_0 () ]

:= families_of \* r. (witness : regime_witness r) : list (regime_family r) =
    ?= witness ?|
    | Brazil => brazilian_families ()
    | EuropeUbl => ubl_families ()
    | Mexico => mexican_families ()

:= access_key_digits (_ : regime_family brazil) : i32 = 44i32
:~ ^ contains_name (n : string) (names : list string) : bool =
    ?= names ?|
    | m :: rest => m = n || contains_name n rest
    | [] => !-

:~ ^ has_duplicate (names : list string) : bool =
    ?= names ?|
    | n :: tail => contains_name n tail || has_duplicate tail
    | [] => !-

///> rust
test every_family_has_its_own_module_name =
    := all =
        listm::concat [
            family_roots (); nfe_events (); ubl_business_documents_2_1 (); hacienda_documents ()
            [ cfdi_v4_0 (); ubl_invoice_2_1 (); ubl_creditnote_2_1 (); fatturapa_1_2_3 (); ksef_fa_3 () ]
            [
                chile_dte_v10 (); chile_envio_dte_v10 (); facturae_3_2_2 (); verifactu_registro (); saft_pt_1_04_01 ()
                cii_d16b ()
            ]
            [ mydata_2_0_2 (); hacienda_factura_4_4 (); nav_invoice_data_3_0 (); gst_inv01_1_1 () ]
        ]
    := names = listm::map (\ (f : family_root) => module_text f::module_name) all
    ? has_duplicate names ?> failwith "two families would write the same generated unit"

///> rust
test every_regime_lists_its_own_families =
    ? (listm::length (families_of Brazil) : i32) <> 16i32
    ?> failwith "12 NF-e/CT-e/MDF-e roots, NF-e 4.00 and its 3 events are Brazilian"
    ? (listm::length (families_of EuropeUbl) : i32) <> 6i32
    ?> failwith "Invoice, CreditNote and 4 business documents are UBL"
    ? (listm::length (families_of Mexico) : i32) <> 1i32 ?> failwith "CFDI 4.0 is Mexican"
    ? (listm::length (listm::map access_key_digits (families_of Brazil)) : i32) <> 16i32
    ?> failwith "every Brazilian family has a 44-digit access key"

///> rust
test a_ubl_family_takes_no_brazilian_access_key fails "Unification" =
    ?= families_of EuropeUbl ?|
    | f :: _ => access_key_digits f |> ignore
    | [] => ()
