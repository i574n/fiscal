:= ubl_manifest (lower : string) (suffix : string) : document_source =
    Manifest (repo_path ("deps/corpus/ubl-" ++# lower ++# suffix))

:= ubl_schema (kind : string) : repo_path = repo_path ("deps/corpus/eu/ubl21/maindoc/UBL-" ++# kind ++# "-2.1.xsd")

:= ubl_namespace (kind : string) : namespace_uri =
    namespace_uri ("urn:oasis:names:specification:ubl:schema:xsd:" ++# kind ++# "-2")

:= ubl_base (kind : string) (lower : string) : family_root =
    := module = module_id ("generated_ubl_" ++# lower ++# "_2_1")
    bare_family module (ubl_schema kind) (tag_name kind) (definition_name (kind ++# "Type")) (ubl_namespace kind)

:= ubl_document_2_1 (kind : string) (lower : string) : family_root =
    := base = ubl_base kind lower
    { base with
        documents = ubl_manifest lower "-documents.txt"
        ubl_json_documents = ubl_manifest lower "-json-documents.txt"
    }

:= ubl_business_documents_2_1 () : list family_root =
    [
        ubl_document_2_1 "DebitNote" "debitnote"; ubl_document_2_1 "ApplicationResponse" "applicationresponse";
