:= nfe_events () : list family_root =
    := event module_name schema : family_root =
        {
            module_name = module_id module_name
            schema_path = fiscal_paths::under ("deps/corpus/DFe.NET/NFe.AppTeste/Schemas/" ++# schema)
            root_element = tag_name "procEventoNFe"
            root_type = definition_name "TProcEvento"
            target_namespace = namespace_uri "http://www.portalfiscal.inf.br/nfe"
            source = Xsd []
            known_defect = None
            documents = []
            ubl_json_documents = []
            extras = [ Signed ]
        }
    [
        event "generated_nfe_evento_canc_v1_00" "procEventoCancNFe_v1.00.xsd";
        event "generated_nfe_evento_cce_v1_00" "procCCeNFe_v1.00.xsd";
        event "generated_nfe_evento_conf_recebto_v1_00" "procConfRecebtoNFe_v1.00.xsd"
    ]

:~ ^ manifest_entries (prefix : string) (entries : list string) (acc : list string) : list string =
    ?= entries ?|
    | entry :: rest =>
        := trimmed = sm'::trim entry
        manifest_entries prefix rest (? trimmed = "" ?> acc |: (prefix ++# trimmed) :: acc)
    | [] => listm::rev acc

:= manifest_documents (prefix : string) (manifest : string) : list string =
    := path = fiscal_paths::under manifest
    ? xml::is_file path = !- ?> []
    |: manifest_entries prefix (sm'::split_list "\n" (xml::read_text_replacing_invalid_utf8 path)) []

