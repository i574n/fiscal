        ("generated_mdfe_v3_00", "MDFe.AppTeste/Schemas/mdfe_v3.00.xsd", "MDFe", "TMDFe", "mdfe")
    ]

:= dfe_root (row : string * string * string * string * string) : family_root =
    := module_name, schema, root, root_type, portal = row
    := space = "http://www.portalfiscal.inf.br/" ++# portal
    signed_family module_name ("deps/corpus/DFe.NET/" ++# schema) root root_type space

:= family_roots () : list family_root = listm::map dfe_root (dfe_rows ())

:= nfe_model_checks () : string =
    "\n///> rust\ntest generated_nfe_model_type_checks =\n"
    ++# "    match x_t_cod_uf_ibge_of_string \"35\" with\n"
    ++# (
        "    | Some code => if x_t_cod_uf_ibge_to_string code <> \"35\" then failwith \"TCodUfIBGE 35 round "
        ^^ "trip\"\n"
    )
    ++# "    | None => failwith \"35 parses as TCodUfIBGE\"\n"
    ++# "    if x_t_cnpj_is_valid \"12345678000195\" = false then failwith \"a 14-digit CNPJ is valid\"\n"
    ++# "    if x_t_cnpj_is_valid \"1234567800019\" then failwith \"a 13-digit CNPJ is not\"\n"
    ++# (
        "    match xml.read_xml \"<enderEmit><xLgr>Rua A</xLgr><nro>10</nro><xBairro>Centro</xBairro><cMun>3550"
        ^^ "308</cMun><xMun>Sao Paulo</xMun><UF>SP</UF><CEP>01001000</CEP><cPais>1058</cPais></enderEmit>\" with\n"
    )
    ++# "    | node :: [] =>\n"
    ++# "        inl address = xml_codec.expect_decoded (x_t_ender_emi_of_xml node)\n"
    ++# (
        "        if x_t_ender_emi_x_mun_to_string address.x_mun <> \"Sao Paulo\" || x_t_ender_emi_cep_to_string "
        ^^ "address.cep <> \"01001000\" then failwith \"TEnderEmi text fields\"\n"
    )
    ++# "        if x_t_uf_emi_to_string address.uf <> \"SP\" then failwith \"TEnderEmi UF enumeration\"\n"
    ++# (
        "        if xml.same_node node (x_t_ender_emi_to_xml \"enderEmit\" address) = false then failwith "
        ^^ "\"TEnderEmi XML round trip\"\n"
    )
    ++# "        match address.c_pais with\n"
    ++# "        | Some _ => ()\n"
    ++# "        | None => failwith \"TEnderEmi optional cPais\"\n"
    ++# "    | _ => failwith \"one enderEmit element\"\n"
    ++# "\n///> rust\ntest generated_nfe_reports_a_missing_element_with_its_path =\n"
    ++# "    inl document = xml_codec.pruned \"cUF\" (x_tn_fe_to_xml \"NFe\" (x_tn_fe_example 0i32))\n"
    ++# "    if xml_codec.reports \"missing infNFe/ide/cUF\" (x_tn_fe_of_xml Unsigned document) = false then\n"
    ++# "        failwith \"an NF-e without ide/cUF is reported as missing infNFe/ide/cUF, not raised\"\n"

:= nfe_v4_base () : family_root =
    bare_family
        (module_id "generated_nfe_v4")
        (repo_path "deps/corpus/DFe.NET/NFe.AppTeste/Schemas/nfe_v4.00.xsd")
        (tag_name "NFe")
        (definition_name "TNFe")
        (namespace_uri "http://www.portalfiscal.inf.br/nfe")

:= nfe_v4_00 () : family_root =
    := base = nfe_v4_base ()
    { base with extras = [ Signed; ModelChecks (nfe_model_checks ()) ] }

:= nfe_event_rows () : list (string * string) =
    [
        ("generated_nfe_evento_canc_v1_00", "procEventoCancNFe_v1.00.xsd");
        ("generated_nfe_evento_cce_v1_00", "procCCeNFe_v1.00.xsd");
        ("generated_nfe_evento_conf_recebto_v1_00", "procConfRecebtoNFe_v1.00.xsd")
    ]

:= nfe_event (row : string * string) : family_root =
    := module_name, schema = row
    := path = "deps/corpus/DFe.NET/NFe.AppTeste/Schemas/" ++# schema
    signed_family module_name path "procEventoNFe" "TProcEvento" "http://www.portalfiscal.inf.br/nfe"

:= nfe_events () : list family_root = listm::map nfe_event (nfe_event_rows ())

:~ ^ manifest_entries (prefix : string) (entries : list string) (acc : list string) : list string =
    ?= entries ?|
    | entry :: rest =>
        := trimmed = sm'::trim entry
        manifest_entries prefix rest (? trimmed = "" ?> acc |: (prefix ++# trimmed) :: acc)
    | [] => listm::rev acc

:= manifest_documents (prefix : string) (manifest : string) : list string =
    := path = fiscal_paths::under manifest
    ? xml::is_file path = !- ?> []
    |: manifest_entries prefix (sm'::split_list "\n" (xml::read_text_replacing_invalid_utf8 path)) []

:= documents_of (source : document_source) : list string =
    ?= source ?|
    | Listed paths => paths
    | Manifest manifest => manifest_documents "deps/corpus/" (repo_text manifest)

