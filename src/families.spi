///- --package . --timeout 1200000
:< sm'_operators
:< xsd
:< xsd_emit

:| schema_source =
    | Xsd : xsd_resolve::schema_catalog
    | JsonSchema

:| family_extra =
    | Signed
    | CfdiComplements
    | NfeModelChecks

:~ ^ has_extra (extra : family_extra) (extras : list family_extra) : bool =
    ?= extras ?|
    | x :: rest => x = extra || has_extra extra rest
    | [] => !-

:! module_id = string

:= module_text ((module_id text) : module_id) : string = text

:== family_root =
    {
        module_name : module_id
        schema_path : string
        root_element : tag_name
        root_type : definition_name written
        target_namespace : namespace_uri
        source : schema_source
        known_defect : option string
        documents : list string
        ubl_json_documents : list string
        extras : list family_extra
    }

:= root_type_name (family : family_root) : string = type_name (definition_text family::root_type)

:= cfdi_v4_0 () : family_root =
    := local = (fiscal_paths::under "deps/corpus/mx/cfdi/")
    := sat = "http://www.sat.gob.mx/sitio_internet/cfd/"
    {
        module_name = module_id "generated_cfdi_v4_0"
        schema_path = local ++# "cfdv40.xsd"
        root_element = tag_name "Comprobante"
        root_type = definition_name "Comprobante"
        target_namespace = namespace_uri "http://www.sat.gob.mx/cfd/4"
        source =
            Xsd [
                (sat ++# "catalogos/catCFDI.xsd", local ++# "catCFDI.xsd");
                (sat ++# "tipoDatos/tdCFDI/tdCFDI.xsd", local ++# "tdCFDI.xsd")
            ]
        known_defect = None
        documents = [ "deps/corpus/mx/stamped/cfdiutils-cfdi40-valid.xml" ]
        ubl_json_documents = []
        extras = [ CfdiComplements ]
    }

:= cfdi_complement
    (module_name : string) (file : string) (root : string) (space : string) (catalog : list (string * string))
    : family_root
    =
    {
        module_name = module_id module_name
        schema_path = (fiscal_paths::under "deps/corpus/mx/complements/") ++# file
        root_element = tag_name root
        root_type = definition_name root
        target_namespace = namespace_uri space
        source = Xsd catalog
        known_defect = None
        documents = []
        ubl_json_documents = []
        extras = []
    }

:= cfdi_tfd_1_1 () : family_root =
    := local = (fiscal_paths::under "deps/corpus/mx/cfdi/")
    cfdi_complement
        "generated_cfdi_tfd_1_1"
        "TimbreFiscalDigitalv11.xsd"
        "TimbreFiscalDigital"
        "http://www.sat.gob.mx/TimbreFiscalDigital"
        [ ("http://www.sat.gob.mx/sitio_internet/cfd/tipoDatos/tdCFDI/tdCFDI.xsd", local ++# "tdCFDI.xsd") ]

:= cfdi_pagos_2_0 () : family_root =
    := local = (fiscal_paths::under "deps/corpus/mx/")
    := sat = "http://www.sat.gob.mx/sitio_internet/cfd/"
    cfdi_complement
        "generated_cfdi_pagos_2_0"
        "Pagos20.xsd"
        "Pagos"
        "http://www.sat.gob.mx/Pagos20"
        [
            (sat ++# "catalogos/catCFDI.xsd", local ++# "cfdi/catCFDI.xsd");
            (sat ++# "tipoDatos/tdCFDI/tdCFDI.xsd", local ++# "cfdi/tdCFDI.xsd");
            (sat ++# "catalogos/Pagos/catPagos.xsd", local ++# "complements/catPagos.xsd")
        ]

:= complements_of (family : family_root) : list (string * family_root) =
    ? has_extra CfdiComplements family::extras
    ?> [ ("TimbreFiscalDigital11", cfdi_tfd_1_1 ()); ("Pagos20", cfdi_pagos_2_0 ()) ]
    |: []

:= family_roots () : list family_root =
    := root = (fiscal_paths::under "deps/corpus/DFe.NET/")
    := nfe = "http://www.portalfiscal.inf.br/nfe"
    := cte = "http://www.portalfiscal.inf.br/cte"
    := mdfe = "http://www.portalfiscal.inf.br/mdfe"
    := family module_name schema_path root_element root_type target_namespace : family_root =
        {
            module_name = module_id module_name
            schema_path = root ++# schema_path
            root_element = tag_name root_element
            root_type = definition_name root_type
            target_namespace = namespace_uri target_namespace
            source = Xsd []
            known_defect = None
            documents = []
            ubl_json_documents = []
            extras = [ Signed ]
        }
    [
        family "generated_nfe_v2_00" "NFe.AppTeste/Schemas/nfe_v2.00.xsd" "NFe" "TNFe" nfe;
        family "generated_nfe_v3_10" "NFe.AppTeste/Schemas/nfe_v3.10.xsd" "NFe" "TNFe" nfe;
        family "generated_cte_v2_00" "CTe.AppTeste/schemas/cte_v2.00.xsd" "CTe" "TCTe" cte;
        family "generated_cte_v3_00" "CTe.AppTeste/schemas/cte_v3.00.xsd" "CTe" "TCTe" cte;
        family "generated_cte_v4_00" "CTe.AppTeste/schemas/cte_v4.00.xsd" "CTe" "TCTe" cte;
        family "generated_cte_os_v3_00" "CTe.AppTeste/schemas/cteOS_v3.00.xsd" "CTeOS" "TCTeOS" cte;
        family "generated_cte_os_v4_00" "CTe.AppTeste/schemas/cteOS_v4.00.xsd" "CTeOS" "TCTeOS" cte;
        family "generated_cte_simp_v4_00" "CTe.AppTeste/schemas/cteSimp_v4.00.xsd" "CTeSimp" "TCTeSimp" cte;
        family "generated_gtve_v3_00" "CTe.AppTeste/schemas/GTVe_v3.00.xsd" "GTVe" "TGTVe" cte;
        family "generated_gtve_v4_00" "CTe.AppTeste/schemas/GTVe_v4.00.xsd" "GTVe" "TGTVe" cte;
        family "generated_mdfe_v1_00" "MDFe.AppTeste/Schemas/mdfe_v1.00.xsd" "MDFe" "TMDFe" mdfe;
        family "generated_mdfe_v3_00" "MDFe.AppTeste/Schemas/mdfe_v3.00.xsd" "MDFe" "TMDFe" mdfe
    ]

