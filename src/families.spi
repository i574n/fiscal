        ubl_json_documents = Listed []
        extras = []
    }

:= hacienda_factura_4_4 () : family_root =
    {
        module_name = module_id "generated_cr_factura_4_4"
        schema_path = repo_path "deps/corpus/cr/hacienda/v4.4/FacturaElectronica_V4.4.xsd"
        root_element = tag_name "FacturaElectronica"
        root_type = definition_name "FacturaElectronica"
        target_namespace =
            namespace_uri "https://cdn.comprobanteselectronicos.go.cr/xml-schemas/v4.4/facturaElectronica"
        source =
            Xsd [
                (
                    "../../xmldsig-core-schema.xsd",
                    repo_path "deps/corpus/eu/ubl21/common/UBL-xmldsig-core-schema-2.1.xsd"
                )
            ]
        known_defect = None
        documents = Listed []
        ubl_json_documents = Listed []
        extras = [ Signed ]
    }

:= hacienda_namespace (root : string) : namespace_uri =
    := first = sm'::substring 0i32 1i32 root
    := rest = sm'::substring 1i32 (sm'::length root - 1i32) root
    namespace_uri ("https://cdn.comprobanteselectronicos.go.cr/xml-schemas/v4.4/" ++# sm'::to_lower first ++# rest)

:= xmldsig_import () : string * repo_path =
    "../../xmldsig-core-schema.xsd", repo_path "deps/corpus/eu/ubl21/common/UBL-xmldsig-core-schema-2.1.xsd"

:= hacienda_base (root : string) (suffix : string) : family_root =
    bare_family
        (module_id ("generated_cr_" ++# suffix ++# "_4_4"))
        (repo_path ("deps/corpus/cr/hacienda/v4.4/" ++# root ++# "_V4.4.xsd"))
        (tag_name root)
        (definition_name root)
        (hacienda_namespace root)

:= hacienda_document (root : string) (suffix : string) : family_root =
    := base = hacienda_base root suffix
    { base with source = Xsd [ xmldsig_import () ]; extras = [ Signed ] }

:= hacienda_rows () : list (string * string) =
    [
        ("FacturaElectronicaCompra", "factura_compra"); ("FacturaElectronicaExportacion", "factura_exportacion");
        ("NotaCreditoElectronica", "nota_credito"); ("NotaDebitoElectronica", "nota_debito");
        ("TiqueteElectronico", "tiquete"); ("ReciboElectronicoPago", "recibo_pago");
        ("MensajeReceptor", "mensaje_receptor"); ("MensajeHacienda", "mensaje_hacienda")
    ]

:= hacienda_documents () : list family_root =
    listm::map (\ (root, suffix) => hacienda_document root suffix) (hacienda_rows ())

:= nav_invoice_data_3_0 () : family_root =
    {
        module_name = module_id "generated_hu_nav_3_0"
        schema_path = repo_path "deps/corpus/hu/nav/invoiceData.xsd"
        root_element = tag_name "InvoiceData"
        root_type = definition_name "InvoiceData"
        target_namespace = namespace_uri "http://schemas.nav.gov.hu/OSA/3.0/data"
        source =
            Xsd [
                ("http://schemas.nav.gov.hu/NTCA/1.0/common", repo_path "deps/corpus/hu/nav/common.xsd");
                ("http://schemas.nav.gov.hu/OSA/3.0/base", repo_path "deps/corpus/hu/nav/invoiceBase.xsd")
            ]
        known_defect = None
        documents = Manifest (repo_path "deps/corpus/hu-nav-invoicedata-documents.txt")
        ubl_json_documents = Listed []
        extras = []
    }

:= gst_inv01_1_1 () : family_root =
    {
        module_name = module_id "generated_in_gst_inv01_1_1"
        schema_path = repo_path "deps/corpus/in/gst/inv01_1.1.json"
        root_element = tag_name "GstInvoice"
        root_type = definition_name "GstInvoice"
        target_namespace = namespace_uri ""
        source = JsonSchema
        known_defect = None
        documents = Listed [ "deps/corpus/in/gst/examples/irn-request-example.json" ]
        ubl_json_documents = Listed []
        extras = []
